colBullIn  = input.color(#2962FF, "BUY", inline = "c1", group = G_VIS, tooltip = "Blue and red are used ONLY for real trades: the BUY / SELL banner, the entry lines and the signal triangles. The table and every other drawing use white, grey and amber.")
