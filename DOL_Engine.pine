// =====================================================================================================
// 4. UTILITY FUNCTIONS
// =====================================================================================================
f_join(string a, string b) =>
    a == "" ? b : a + "·" + b

f_sz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

f_pos(string p) =>
    p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right

// Standard normal CDF (Abramowitz & Stegun 26.2.17, |error| < 7.5e-8)
f_ncdf(float x) =>
    float ax = math.abs(x)
    float t  = 1.0 / (1.0 + 0.2316419 * ax)
    float d  = 0.3989422804014327 * math.exp(-ax * ax / 2.0)
    float p  = d * t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0 ? 1.0 - p : p

// Structural weight of a single source type
f_srcW(int s) =>
    s == S_PM ? 1.0 : s == S_PW ? 0.85 : s == S_HTF ? 0.8 : s == S_PD ? 0.7 : s == S_EQ ? 0.6 : s == S_SESS ? 0.5 : s == S_STF ? 0.5 : 0.35

f_flagCount(Liq c) =>
    int n = 0
    n += c.hSwing ? 1 : 0
    n += c.hEq    ? 1 : 0
    n += c.hSess  ? 1 : 0
    n += c.hPD    ? 1 : 0
    n += c.hPW    ? 1 : 0
    n += c.hPM    ? 1 : 0
    n += c.hHtf   ? 1 : 0
    n += c.hStf   ? 1 : 0
    n += c.hNode  ? 1 : 0
    n

// Structural importance of a merged zone (strongest source + bonus for independent sources)
f_structW(Liq c) =>
    float w = 0.0
    w := c.hSwing ? math.max(w, 0.35) : w
    w := c.hStf   ? math.max(w, 0.50) : w
    w := c.hSess  ? math.max(w, 0.50) : w
    w := c.hEq    ? math.max(w, 0.60) : w
    w := c.hPD    ? math.max(w, 0.70) : w
    w := c.hHtf   ? math.max(w, 0.80) : w
    w := c.hPW    ? math.max(w, 0.85) : w
    w := c.hPM    ? math.max(w, 1.00) : w
    math.min(1.0, w + 0.08 * math.max(0, f_flagCount(c) - 1))

f_setFlag(Liq c, int src, string nm) =>
    if src == S_SWING
        c.hSwing := true
    else if src == S_EQ
        c.hSwing := true
        c.hEq := true
    else if src == S_SESS
        c.sName := c.sName == "" ? nm : c.sName
        c.hSess := true
    else if src == S_PD
        c.hPD := true
    else if src == S_PW
        c.hPW := true
    else if src == S_PM
        c.hPM := true
    else if src == S_HTF
        c.hHtf := true
    else if src == S_STF
        c.hStf := true
    c

f_srcList(Liq c) =>
    bool   b = c.dir == 1
    string s = ""
    if c.hPM
        s := f_join(s, b ? "PMH" : "PML")
    if c.hPW
        s := f_join(s, b ? "PWH" : "PWL")
    if c.hPD
        s := f_join(s, b ? "PDH" : "PDL")
    if c.hHtf
        s := f_join(s, "HTF")
    if c.hEq
        s := f_join(s, b ? "EQH" : "EQL")
    if c.hSess
        s := f_join(s, c.sName)
    if c.hStf
        s := f_join(s, "STF")
    if c.hSwing and not c.hEq
        s := f_join(s, b ? "SWH" : "SWL")
    if c.hNode
        s := f_join(s, "NODE")
    if c.refs >= 3
        s := s + " ×" + str.tostring(c.refs)
    s

f_findId(array<Liq> a, int id) =>
    int r = -1
    int n = array.size(a)
    if id >= 0 and n > 0
        for i = 0 to n - 1
            if array.get(a, i).id == id
                r := i
                break
    r

// Add a liquidity reference: merge into an existing zone when within mD, otherwise create a new
// candidate (evicting the weakest one — never the active DOL, never one added this bar).
f_addLiq(array<Liq> arr, int dir, float lvl, float zH, int src, string tfTxt, string nm, int t0, int bRef, float mD, float eqD, int maxN, int newId, int keepId, int curBar) =>
    int hit = -1
    if not na(lvl) and not na(t0)
        int n = array.size(arr)
        if n > 0
            for i = 0 to n - 1
                Liq c1 = array.get(arr, i)
                if c1.dir == dir and math.abs(c1.lvl - lvl) <= mD
                    hit := i
                    break
        if hit >= 0
            Liq c2 = array.get(arr, hit)
            bool isSw = src == S_SWING or src == S_STF
            if isSw and (c2.hSwing or c2.hStf) and eqD >= 0 and math.abs(c2.lvl - lvl) <= eqD
                c2.hEq := true
            c2.refs += 1
            float cap = (mD + zH) * 2.0
            if dir == 1
                c2.lvl := math.max(c2.lvl, lvl)
                c2.top := c2.lvl
                c2.bot := math.max(math.min(c2.bot, lvl - zH), c2.top - cap)
            else
                c2.lvl := math.min(c2.lvl, lvl)
                c2.bot := c2.lvl
                c2.top := math.min(math.max(c2.top, lvl + zH), c2.bot + cap)
            c2.t0   := math.min(c2.t0, t0)
            c2.bRef := math.max(c2.bRef, bRef)
            if f_srcW(src) > f_srcW(c2.src)
                c2.src   := src
                c2.tfTxt := tfTxt
            f_setFlag(c2, src, nm)
        else
            if n >= maxN and n > 0
                int   wi = -1
                float ws = 1e20
                for i = 0 to n - 1
                    Liq c3 = array.get(arr, i)
                    if c3.id != keepId and c3.bAdd != curBar and c3.score < ws
                        ws := c3.score
                        wi := i
                if wi >= 0
                    array.remove(arr, wi)
            Liq nc = Liq.new(id = newId, dir = dir, lvl = lvl, top = dir == 1 ? lvl : lvl + zH, bot = dir == 1 ? lvl - zH : lvl, t0 = t0, bRef = bRef, bAdd = curBar, src = src, tfTxt = tfTxt)
            f_setFlag(nc, src, nm)
            array.push(arr, nc)
    hit

f_ghost(array<Ghost> gs, Liq c, int t1, string why, int maxG) =>
    if maxG > 0
        array.push(gs, Ghost.new(c.dir, c.top, c.bot, c.t0, t1, f_srcList(c), c.score, why))
        while array.size(gs) > maxG
            array.shift(gs)
    true

f_gapOverlap(array<Gap> a, float lo, float hi) =>
    bool r = false
    int  n = array.size(a)
    if n > 0
        for k = 0 to n - 1
            Gap g = array.get(a, k)
            if g.top >= lo and g.bot <= hi
                r := true
                break
    r

f_blkOverlap(array<Blk> a, float lo, float hi, bool skipMit) =>
    bool r = false
    int  n = array.size(a)
    if n > 0
        for k = 0 to n - 1
            Blk b = array.get(a, k)
            if b.top >= lo and b.bot <= hi and not (skipMit and b.mitigated)
                r := true
                break
    r

// HTF alignment factor: state in [-2, 2] → 0..1 for the given target direction
f_align(int st, int dir) =>
    0.5 + 0.25 * nz(st) * dir

// Heuristic Probability-of-Touch (0-95 %).
// Base: reflection principle for a driftless random walk → P(touch within T) = 2·(1 − Φ(d / (σ·√T))).
// Scaled by target quality and momentum toward the target. Heuristic, not a guarantee.
f_pot(float lvl, int dir, float sc, float px, float sig, int horizon, float mom) =>
    float res = na
    if not na(lvl) and dir != 0 and sig > 0
        float dist = math.max(dir == 1 ? lvl - px : px - lvl, 0.0)
        float z    = dist / (sig * math.sqrt(horizon))
        float base = 2.0 * (1.0 - f_ncdf(z))
        float q    = 0.55 + 0.45 * math.min(math.max(nz(sc), 0.0), 100.0) / 100.0
        float m    = 1.0 + 0.20 * math.max(-1.0, math.min(1.0, nz(mom) * dir))
        res := math.max(1.0, math.min(95.0, 100.0 * base * q * m))
    res

f_biasTxt(int st) =>
    st >= 2 ? "BULLISH" : st == 1 ? "BULLISH" : st <= -2 ? "BEARISH" : st == -1 ? "BEARISH" : "NEUTRAL"

f_biasArrow(int st) =>
    st >= 2 ? "▲" : st == 1 ? "△" : st <= -2 ? "▼" : st == -1 ? "▽" : "◆"

// =====================================================================================================
// 5. TIMEFRAME FUNCTIONS
// =====================================================================================================
f_orChart(simple string tf) =>
    tf == "" ? timeframe.period : tf

// Smallest standard timeframe that is >= minSec
f_ladder(simple int minSec) =>
    minSec <= 60 ? "1" : minSec <= 180 ? "3" : minSec <= 300 ? "5" : minSec <= 900 ? "15" : minSec <= 1800 ? "30" : minSec <= 3600 ? "60" : minSec <= 7200 ? "120" : minSec <= 14400 ? "240" : minSec <= 86400 ? "1D" : minSec <= 604800 ? "1W" : "1M"

// Manual timeframe guard: never request a timeframe below the chart
f_clampTf(simple string tf, simple int minSec) =>
    timeframe.in_seconds(tf) < minSec ? timeframe.period : tf

f_tfLbl(simple string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 60 ? str.tostring(s) + "s" : s < 3600 ? str.tostring(math.round(s / 60.0)) + "m" : s < 86400 ? str.tostring(math.round(s / 3600.0)) + "H" : s < 604800 ? str.tostring(math.round(s / 86400.0)) + "D" : s < 2419200 ? str.tostring(math.round(s / 604800.0)) + "W" : str.tostring(math.round(s / 2628003.0)) + "M"

// Confirmed market-structure state for request.security().
// Returns values of the previous (closed) bar of the requested timeframe → used with lookahead_on
// this is the standard non-repainting pattern.
// st: +2 bullish (BOS), +1 bullish (CHoCH / first break), 0 neutral, -1 / -2 bearish.
f_tfState(simple int len) =>
    float ph0 = ta.pivothigh(high, len, len)
    float pl0 = ta.pivotlow(low, len, len)
    var float sh  = na
    var float sl  = na
    var int   shT = na
    var int   slT = na
    var bool  shB = true
    var bool  slB = true
    var int   st  = 0
    if not na(ph0)
        sh  := ph0
        shT := time[len]
        shB := false
    if not na(pl0)
        sl  := pl0
        slT := time[len]
        slB := false
    if not shB and close > sh
        shB := true
        st  := st >= 1 ? 2 : 1
    if not slB and close < sl
        slB := true
        st  := st <= -1 ? -2 : -1
    [st[1], sh[1], shT[1], shB[1], sl[1], slT[1], slB[1]]

// Session tracker (one instance per call site)
f_session(string sess, string tz) =>
    bool inS = not na(time(timeframe.period, sess, tz))
    var float hi  = na
    var float lo  = na
    var int   hiT = na
    var int   loT = na
    var int   hiB = na
    var int   loB = na
    if inS and not inS[1]
        hi  := high
        lo  := low
        hiT := time
        loT := time
        hiB := bar_index
        loB := bar_index
    else if inS
        if high > hi
            hi  := high
            hiT := time
            hiB := bar_index
        if low < lo
            lo  := low
            loT := time
            loB := bar_index
    bool ended = not inS and inS[1]
    [hi, lo, hiT, loT, hiB, loB, ended]

// Calendar period tracker (previous + current period extremes with origin time / bar)
f_period(bool isNew) =>
    var float cHi  = na
    var float cLo  = na
    var int   cHiT = na
    var int   cLoT = na
    var int   cHiB = na
    var int   cLoB = na
    var float pHi  = na
    var float pLo  = na
    var int   pHiT = na
    var int   pLoT = na
    var int   pHiB = na
    var int   pLoB = na
    var int   sT   = na
    if isNew
        pHi  := cHi
        pLo  := cLo
        pHiT := cHiT
        pLoT := cLoT
        pHiB := cHiB
        pLoB := cLoB
        cHi  := high
        cLo  := low
        cHiT := time
        cLoT := time
        cHiB := bar_index
        cLoB := bar_index
        sT   := time
    else
        if na(cHi) or high > cHi
            cHi  := high
            cHiT := time
            cHiB := bar_index
        if na(cLo) or low < cLo
            cLo  := low
            cLoT := time
            cLoB := bar_index
        if na(sT)
            sT := time
    [pHi, pHiT, pHiB, pLo, pLoT, pLoB, cHi, cLo, sT]

// =====================================================================================================
// TIMEFRAME RESOLUTION (all simple strings → safe for request.security)
// =====================================================================================================
int    chartSec = timeframe.in_seconds()
bool   isAuto   = tfSelIn == "Auto"
string aStf     = modeIn == "Scalping" ? "15"  : modeIn == "Day Trading" ? "60"  : "240"
string aH1      = modeIn == "Scalping" ? "60"  : modeIn == "Day Trading" ? "240" : "1D"
string aH2      = modeIn == "Scalping" ? "240" : modeIn == "Day Trading" ? "1D"  : "1W"

// (plain ternaries instead of math.max keep every value 'simple', as request.security requires)
int    sAStf  = timeframe.in_seconds(aStf)
string stfTf  = isAuto ? f_ladder(sAStf > chartSec ? sAStf : chartSec) : f_clampTf(f_orChart(mStfIn), chartSec)
int    stfSec = timeframe.in_seconds(stfTf)
int    sAH1   = timeframe.in_seconds(aH1)
string h1Tf   = isAuto ? f_ladder(sAH1 > stfSec ? sAH1 : stfSec + 1) : f_clampTf(f_orChart(mHtf1In), chartSec)
int    h1Sec  = timeframe.in_seconds(h1Tf)
int    sAH2   = timeframe.in_seconds(aH2)
string h2Tf   = isAuto ? f_ladder(sAH2 > h1Sec ? sAH2 : h1Sec + 1) : f_clampTf(f_orChart(mHtf2In), chartSec)
int    h2Sec  = timeframe.in_seconds(h2Tf)
string exTf   = f_clampTf(f_orChart(mExecIn), chartSec)
bool   exIsCh = timeframe.in_seconds(exTf) == chartSec
string lvTf   = f_clampTf(f_orChart(lvnTfIn), chartSec)

string chLbl  = f_tfLbl(timeframe.period)
string stfLbl = f_tfLbl(stfTf)
string h1Lbl  = f_tfLbl(h1Tf)
string h2Lbl  = f_tfLbl(h2Tf)
string exLbl  = f_tfLbl(exTf)

// Pivot length by mode / sensitivity (simple int — required by ta.pivothigh)
int pivLen = pivAutoIn ? (modeIn == "Scalping" ? (sensIn == "High" ? 2 : sensIn == "Normal" ? 3 : 5) : modeIn == "Day Trading" ? (sensIn == "High" ? 3 : sensIn == "Normal" ? 5 : 8) : (sensIn == "High" ? 5 : sensIn == "Normal" ? 8 : 12)) : pivLenIn

bool pdOk    = chartSec < 86400
bool pwOk    = chartSec < 604800
bool pmOk    = chartSec < 2419200
bool intraOk = timeframe.isintraday and chartSec <= 3600
int  barMs   = math.max(chartSec, 1) * 1000

// =====================================================================================================
// 6. ATR / VOLATILITY ENGINE
// =====================================================================================================
float atrRaw = ta.atr(14)
float atrS   = math.max(nz(atrRaw, high - low), syminfo.mintick)
float sdRet  = ta.stdev(close - nz(close[1], close), 50)
float sigma  = math.max(nz(sdRet, 0.0), atrS * 0.25)
float momRaw = (close - nz(close[10], close)) / (atrS * math.sqrt(10.0))
float volCum = ta.cum(nz(volume))
bool  hasVol = volCum > 0
float volSma = ta.sma(nz(volume), 20)

// =====================================================================================================
// MULTI-TIMEFRAME DATA — every call: expression offset [1] inside f_tfState + lookahead_on
// =====================================================================================================
[stSt, stSH, stSHT, stSHB, stSL, stSLT, stSLB] = request.security(syminfo.tickerid, stfTf, f_tfState(htfPivIn), lookahead = barmerge.lookahead_on)
[h1St, h1SH, h1SHT, h1SHB, h1SL, h1SLT, h1SLB] = request.security(syminfo.tickerid, h1Tf,  f_tfState(htfPivIn), lookahead = barmerge.lookahead_on)
[h2St, h2SH, h2SHT, h2SHB, h2SL, h2SLT, h2SLB] = request.security(syminfo.tickerid, h2Tf,  f_tfState(htfPivIn), lookahead = barmerge.lookahead_on)
[xSt, xSH, xSHT, xSHB, xSL, xSLT, xSLB]        = request.security(syminfo.tickerid, exTf,  f_tfState(pivLen),   lookahead = barmerge.lookahead_on)
[lvTm, lvHi, lvLo, lvVo]                        = request.security(syminfo.tickerid, lvTf,  [time[1], high[1], low[1], volume[1]], lookahead = barmerge.lookahead_on)

// =====================================================================================================
// 14. SESSION ENGINE / CALENDAR LEVELS (trackers run every tick; consumed on confirmed bars only)
// =====================================================================================================
string tzStr = tzIn == "Exchange" ? syminfo.timezone : tzIn
[asHi, asLo, asHiT, asLoT, asHiB, asLoB, asEnd] = f_session(asiaIn, tzStr)
[ldHi, ldLo, ldHiT, ldLoT, ldHiB, ldLoB, ldEnd] = f_session(lonIn, tzStr)
[nyHi, nyLo, nyHiT, nyLoT, nyHiB, nyLoB, nyEnd] = f_session(nyIn, tzStr)

bool newDay   = timeframe.change("D")
bool newWeek  = timeframe.change("W")
bool newMonth = timeframe.change("M")
[pdh, pdhT, pdhB, pdl, pdlT, pdlB, cdh, cdl, dStartT] = f_period(newDay)
[pwh, pwhT, pwhB, pwl, pwlT, pwlB, cwh, cwl, wStartT] = f_period(newWeek)
[pmh, pmhT, pmhB, pml, pmlT, pmlB, cmh, cml, mStartT] = f_period(newMonth)

// =====================================================================================================
// 7. SWING ENGINE (confirmed pivots only)
// =====================================================================================================
float ph = ta.pivothigh(high, pivLen, pivLen)
float pl = ta.pivotlow(low, pivLen, pivLen)

// FVG raw conditions (three-candle imbalance, evaluated on the closing candle)
bool bullFvgRaw = low > high[2] and (low - high[2]) >= fvgMinIn * atrS
bool bearFvgRaw = high < low[2] and (low[2] - high) >= fvgMinIn * atrS

// =====================================================================================================
// PERSISTENT STATE
// =====================================================================================================
var array<Liq>   liqs   = array.new<Liq>()
var array<Gap>   fvgs   = array.new<Gap>()
var array<Gap>   ifvgs  = array.new<Gap>()
var array<Blk>   obs    = array.new<Blk>()
var array<Blk>   brks   = array.new<Blk>()
var array<Ghost> ghosts = array.new<Ghost>()
var array<SEvt>  sEvts  = array.new<SEvt>()
var array<SwLbl> swLbls = array.new<SwLbl>()
var array<int>   lvTs   = array.new<int>()
var array<float> lvHs   = array.new<float>()
var array<float> lvLs   = array.new<float>()
var array<float> lvVs   = array.new<float>()

var int   nextId   = 0
var int   primId   = -1
var int   primDir  = 0
var float primLvl  = na
var float primScr  = na
var int   secId    = -1
var int   secDir   = 0
var float secLvl   = na
var float secScr   = na

var float lastSH   = na
var int   lastSHT  = na
var bool  shBrk    = true
var float lastSL   = na
var int   lastSLT  = na
var bool  slBrk    = true
var int   structSt = 0
var int   lastBrkDir = 0

var int lastBslSwB  = NEG_BIG
var int lastSslSwB  = NEG_BIG
var int lastBullPdB = NEG_BIG
var int lastBearPdB = NEG_BIG
var int lastBullFvgB = NEG_BIG
var int lastBearFvgB = NEG_BIG
var int lastSigB    = NEG_BIG
var float prevScore = 0.0
var float prevPot   = 0.0
var string lastSwTxt = "—"
var int   eligCnt   = 0

// Per-bar events (reset every execution)
bool evNewDol   = false
bool evDolChg   = false
bool evDolSwept = false
bool evBslAct   = false
bool evSslAct   = false
bool evNewFvg   = false
bool evNewIfvg  = false
bool evScoreX   = false
bool evPotX     = false
bool evBullBrk  = false
bool evBearBrk  = false
bool evBullCh   = false
bool evBearCh   = false
bool sigBull    = false
bool sigBear    = false
string swMsg    = ""

// =====================================================================================================
// MAIN ENGINE — confirmed bars only (historical == realtime after close)
// =====================================================================================================
if barstate.isconfirmed and masterIn
    float mD  = mergeIn * atrS
    float zH  = zoneIn * atrS
    float eqD = useEqIn ? eqTolIn * atrS : -1.0
    int   oldPrim = primId

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 8. MARKET STRUCTURE ENGINE
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    if not na(ph)
        int    tP = time[pivLen]
        string tg = na(lastSH) ? "H" : ph > lastSH ? "HH" : "LH"
        lastSH  := ph
        lastSHT := tP
        shBrk   := false
        array.push(swLbls, SwLbl.new(ph, tP, tg, true))
    if not na(pl)
        int    tQ = time[pivLen]
        string tg2 = na(lastSL) ? "L" : pl < lastSL ? "LL" : "HL"
        lastSL  := pl
        lastSLT := tQ
        slBrk   := false
        array.push(swLbls, SwLbl.new(pl, tQ, tg2, false))
    while array.size(swLbls) > 20
        array.shift(swLbls)

    if not shBrk and not na(lastSH) and close > lastSH
        shBrk := true
        bool ch = structSt <= -1
        structSt   := structSt >= 1 ? 2 : 1
        evBullBrk  := true
        evBullCh   := ch
        lastBrkDir := 1
        array.push(sEvts, SEvt.new(1, lastSH, lastSHT, time, ch))
        // the protected swing low behind a bullish break is a structural node
        if not na(lastSL)
            for c in liqs
                if c.dir == -1 and math.abs(c.lvl - lastSL) <= mD
                    c.hNode := true
    if not slBrk and not na(lastSL) and close < lastSL
        slBrk := true
        bool ch2 = structSt >= 1
        structSt   := structSt <= -1 ? -2 : -1
        evBearBrk  := true
        evBearCh   := ch2
        lastBrkDir := -1
        array.push(sEvts, SEvt.new(-1, lastSL, lastSLT, time, ch2))
        if not na(lastSH)
            for c in liqs
                if c.dir == 1 and math.abs(c.lvl - lastSH) <= mD
                    c.hNode := true
    while array.size(sEvts) > 12
        array.shift(sEvts)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 9. FVG ENGINE
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    int nF = array.size(fvgs)
    if nF > 0
        for i = nF - 1 to 0
            Gap  g    = array.get(fvgs, i)
            float gh  = math.max(g.top - g.bot, syminfo.mintick)
            bool kill = false
            if g.dir == 1
                if low < g.top
                    g.mitig := math.max(g.mitig, math.min(1.0, (g.top - math.max(low, g.bot)) / gh))
                if close < g.bot - fvgInvIn * atrS
                    kill := true
                    array.push(ifvgs, Gap.new(kind = 1, dir = -1, top = g.top, bot = g.bot, t0 = g.t0, b0 = bar_index, tInv = time))
                    evNewIfvg := true
                else if low < g.top
                    lastBullPdB := bar_index
                    kill := g.mitig * 100.0 >= fvgMitIn
            else
                if high > g.bot
                    g.mitig := math.max(g.mitig, math.min(1.0, (math.min(high, g.top) - g.bot) / gh))
                if close > g.top + fvgInvIn * atrS
                    kill := true
                    array.push(ifvgs, Gap.new(kind = 1, dir = 1, top = g.top, bot = g.bot, t0 = g.t0, b0 = bar_index, tInv = time))
                    evNewIfvg := true
                else if high > g.bot
                    lastBearPdB := bar_index
                    kill := g.mitig * 100.0 >= fvgMitIn
            if not kill and bar_index - g.b0 > gapAgeIn
                kill := true
            if kill
                array.remove(fvgs, i)

    if bullFvgRaw
        array.push(fvgs, Gap.new(kind = 0, dir = 1, top = low, bot = high[2], t0 = time[1], b0 = bar_index - 1))
        lastBullFvgB := bar_index
        evNewFvg := true
    if bearFvgRaw
        array.push(fvgs, Gap.new(kind = 0, dir = -1, top = low[2], bot = high, t0 = time[1], b0 = bar_index - 1))
        lastBearFvgB := bar_index
        evNewFvg := true
    while array.size(fvgs) > fvgMaxIn
        array.shift(fvgs)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 10-11. iFVG ENGINE (bull FVG → bearish iFVG, bear FVG → bullish iFVG)
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    int nI = array.size(ifvgs)
    if nI > 0
        for i = nI - 1 to 0
            Gap  g    = array.get(ifvgs, i)
            bool kill = false
            if g.tInv != time
                bool inBody = close > g.bot and close < g.top
                if g.dir == -1
                    if high >= g.bot
                        lastBearPdB := bar_index
                    if close > g.top + ifvgInvIn * atrS
                        kill := true
                else
                    if low <= g.top
                        lastBullPdB := bar_index
                    if close < g.bot - ifvgInvIn * atrS
                        kill := true
                if inBody
                    g.closesIn += 1
                if g.closesIn >= ifvgClosesIn
                    kill := true
            if not kill and bar_index - g.b0 > gapAgeIn
                kill := true
            if kill
                array.remove(ifvgs, i)
    while array.size(ifvgs) > ifvgMaxIn
        array.shift(ifvgs)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 12. ORDER BLOCK ENGINE — created only on a confirmed structure break with displacement
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    if evBullBrk
        int   bi = -1
        float bl = na
        for k = 1 to obLookIn
            if close[k] < open[k] and (na(bl) or low[k] < bl)
                bl := low[k]
                bi := k
        if bi > 0
            float vmax = 0.0
            for k = 0 to bi - 1
                vmax := math.max(vmax, nz(volume[k]))
            bool volOk = not obVolIn or not hasVol or vmax > nz(volSma) * 1.3
            if close - bl >= obDispIn * atrS and volOk
                int  tb  = time[bi]
                bool dup = false
                for b in obs
                    if b.t0 == tb and b.dir == 1
                        dup := true
                if not dup
                    array.push(obs, Blk.new(kind = 0, dir = 1, top = high[bi], bot = bl, t0 = tb, b0 = bar_index - bi, bC = bar_index, hasImb = lastBullFvgB >= bar_index - bi))
    if evBearBrk
        int   bj = -1
        float bh = na
        for k = 1 to obLookIn
            if close[k] > open[k] and (na(bh) or high[k] > bh)
                bh := high[k]
                bj := k
        if bj > 0
            float vmax2 = 0.0
            for k = 0 to bj - 1
                vmax2 := math.max(vmax2, nz(volume[k]))
            bool volOk2 = not obVolIn or not hasVol or vmax2 > nz(volSma) * 1.3
            if bh - close >= obDispIn * atrS and volOk2
                int  tb2  = time[bj]
                bool dup2 = false
                for b in obs
                    if b.t0 == tb2 and b.dir == -1
                        dup2 := true
                if not dup2
                    array.push(obs, Blk.new(kind = 0, dir = -1, top = bh, bot = low[bj], t0 = tb2, b0 = bar_index - bj, bC = bar_index, hasImb = lastBearFvgB >= bar_index - bj))

    int nO = array.size(obs)
    if nO > 0
        for i = nO - 1 to 0
            Blk  b    = array.get(obs, i)
            bool kill = false
            if b.bC != bar_index
                float mid = (b.top + b.bot) / 2.0
                if b.dir == 1
                    bool hit = obMitIn == "Wick" ? low <= b.top : obMitIn == "50%" ? low <= mid : close <= b.top
                    if hit
                        b.mitigated := true
                    if low <= b.top
                        lastBullPdB := bar_index
                    if close < b.bot
                        kill := true
                        array.push(brks, Blk.new(kind = 1, dir = -1, top = b.top, bot = b.bot, t0 = b.t0, b0 = b.b0, bC = bar_index, tBrk = time))
                else
                    bool hit2 = obMitIn == "Wick" ? high >= b.bot : obMitIn == "50%" ? high >= mid : close >= b.bot
                    if hit2
                        b.mitigated := true
                    if high >= b.bot
                        lastBearPdB := bar_index
                    if close > b.top
                        kill := true
                        array.push(brks, Blk.new(kind = 1, dir = 1, top = b.top, bot = b.bot, t0 = b.t0, b0 = b.b0, bC = bar_index, tBrk = time))
            if not kill and bar_index - b.b0 > gapAgeIn * 2
                kill := true
            if kill
                array.remove(obs, i)
    while array.size(obs) > obMaxIn
        array.shift(obs)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 13. BREAKER ENGINE (failed OB → opposite-direction zone; retests counted; invalidated on close)
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    int nB = array.size(brks)
    if nB > 0
        for i = nB - 1 to 0
            Blk  b    = array.get(brks, i)
            bool kill = false
            if b.bC != bar_index
                if b.dir == -1
                    if high >= b.bot
                        lastBearPdB := bar_index
                        if high[1] < b.bot
                            b.retests += 1
                    if close > b.top
                        kill := true
                else
                    if low <= b.top
                        lastBullPdB := bar_index
                        if low[1] > b.top
                            b.retests += 1
                    if close < b.bot
                        kill := true
            if not kill and bar_index - b.b0 > gapAgeIn * 2
                kill := true
            if kill
                array.remove(brks, i)
    while array.size(brks) > brkMaxIn
        array.shift(brks)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 9b. LIQUIDITY DETECTION → candidate queue
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    if useSwingIn and not na(ph)
        nextId += 1
        f_addLiq(liqs, 1, ph, zH, S_SWING, chLbl, "", time[pivLen], bar_index - pivLen, mD, eqD, candMaxIn, nextId, primId, bar_index)
    if useSwingIn and not na(pl)
        nextId += 1
        f_addLiq(liqs, -1, pl, zH, S_SWING, chLbl, "", time[pivLen], bar_index - pivLen, mD, eqD, candMaxIn, nextId, primId, bar_index)

    if useSessIn and intraOk
        if asiaOnIn and asEnd
            nextId += 1
            f_addLiq(liqs, 1, asHi, zH, S_SESS, chLbl, "Asia", asHiT, asHiB, mD, eqD, candMaxIn, nextId, primId, bar_index)
            nextId += 1
            f_addLiq(liqs, -1, asLo, zH, S_SESS, chLbl, "Asia", asLoT, asLoB, mD, eqD, candMaxIn, nextId, primId, bar_index)
        if lonOnIn and ldEnd
            nextId += 1
            f_addLiq(liqs, 1, ldHi, zH, S_SESS, chLbl, "LDN", ldHiT, ldHiB, mD, eqD, candMaxIn, nextId, primId, bar_index)
            nextId += 1
            f_addLiq(liqs, -1, ldLo, zH, S_SESS, chLbl, "LDN", ldLoT, ldLoB, mD, eqD, candMaxIn, nextId, primId, bar_index)
        if nyOnIn and nyEnd
            nextId += 1
            f_addLiq(liqs, 1, nyHi, zH, S_SESS, chLbl, "NY", nyHiT, nyHiB, mD, eqD, candMaxIn, nextId, primId, bar_index)
            nextId += 1
            f_addLiq(liqs, -1, nyLo, zH, S_SESS, chLbl, "NY", nyLoT, nyLoB, mD, eqD, candMaxIn, nextId, primId, bar_index)

    if usePdIn and pdOk and newDay
        nextId += 1
        f_addLiq(liqs, 1, pdh, zH, S_PD, "D", "", pdhT, pdhB, mD, eqD, candMaxIn, nextId, primId, bar_index)
        nextId += 1
        f_addLiq(liqs, -1, pdl, zH, S_PD, "D", "", pdlT, pdlB, mD, eqD, candMaxIn, nextId, primId, bar_index)
    if usePwIn and pwOk and newWeek
        nextId += 1
        f_addLiq(liqs, 1, pwh, zH, S_PW, "W", "", pwhT, pwhB, mD, eqD, candMaxIn, nextId, primId, bar_index)
        nextId += 1
        f_addLiq(liqs, -1, pwl, zH, S_PW, "W", "", pwlT, pwlB, mD, eqD, candMaxIn, nextId, primId, bar_index)
    if usePmIn and pmOk and newMonth
        nextId += 1
        f_addLiq(liqs, 1, pmh, zH, S_PM, "M", "", pmhT, pmhB, mD, eqD, candMaxIn, nextId, primId, bar_index)
        nextId += 1
        f_addLiq(liqs, -1, pml, zH, S_PM, "M", "", pmlT, pmlB, mD, eqD, candMaxIn, nextId, primId, bar_index)

    if useStfIn and stfSec != chartSec
        if not na(stSH) and not stSHB and stSHT != nz(stSHT[1], -1)
            nextId += 1
            f_addLiq(liqs, 1, stSH, zH, S_STF, stfLbl, "", stSHT, bar_index, mD, eqD, candMaxIn, nextId, primId, bar_index)
        if not na(stSL) and not stSLB and stSLT != nz(stSLT[1], -1)
            nextId += 1
            f_addLiq(liqs, -1, stSL, zH, S_STF, stfLbl, "", stSLT, bar_index, mD, eqD, candMaxIn, nextId, primId, bar_index)
    if useHtfIn
        if not na(h1SH) and not h1SHB and h1SHT != nz(h1SHT[1], -1)
            nextId += 1
            f_addLiq(liqs, 1, h1SH, zH, S_HTF, h1Lbl, "", h1SHT, bar_index, mD, eqD, candMaxIn, nextId, primId, bar_index)
        if not na(h1SL) and not h1SLB and h1SLT != nz(h1SLT[1], -1)
            nextId += 1
            f_addLiq(liqs, -1, h1SL, zH, S_HTF, h1Lbl, "", h1SLT, bar_index, mD, eqD, candMaxIn, nextId, primId, bar_index)
        if h2Sec != h1Sec
            if not na(h2SH) and not h2SHB and h2SHT != nz(h2SHT[1], -1)
                nextId += 1
                f_addLiq(liqs, 1, h2SH, zH, S_HTF, h2Lbl, "", h2SHT, bar_index, mD, eqD, candMaxIn, nextId, primId, bar_index)
            if not na(h2SL) and not h2SLB and h2SLT != nz(h2SLT[1], -1)
                nextId += 1
                f_addLiq(liqs, -1, h2SL, zH, S_HTF, h2Lbl, "", h2SLT, bar_index, mD, eqD, candMaxIn, nextId, primId, bar_index)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 18. SWEEP / INVALIDATION / MITIGATION ENGINE
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    float pen = minPenIn * atrS
    int   nL  = array.size(liqs)
    if nL > 0
        for i = nL - 1 to 0
            Liq  c        = array.get(liqs, i)
            bool taken    = false
            bool rejected = false
            bool broken   = false
            if c.dir == 1
                bool wHit = high > c.lvl + pen
                bool cHit = close > c.lvl + pen
                taken    := sweepModeIn == "Close" ? cHit : wHit
                rejected := wHit and close < c.lvl
                broken   := close > c.lvl + brkAtrIn * atrS
                if not taken and high >= c.bot
                    c.mitig := math.max(c.mitig, math.min(1.0, (high - c.bot) / math.max(c.top - c.bot, syminfo.mintick)))
                    if nz(high[1]) < c.bot
                        c.touches += 1
            else
                bool wHit2 = low < c.lvl - pen
                bool cHit2 = close < c.lvl - pen
                taken    := sweepModeIn == "Close" ? cHit2 : wHit2
                rejected := wHit2 and close > c.lvl
                broken   := close < c.lvl - brkAtrIn * atrS
                if not taken and low <= c.top
                    c.mitig := math.max(c.mitig, math.min(1.0, (c.top - low) / math.max(c.top - c.bot, syminfo.mintick)))
                    if nz(low[1], 1e20) > c.top
                        c.touches += 1
            bool   isSweepEvt = taken and (sweepModeIn != "Wick + Rejection" or rejected)
            string why        = broken ? "BROKEN" : rejected ? "SWEPT" : "TAKEN"
            float  distL      = math.abs(c.lvl - close) / atrS
            bool   expired    = bar_index - c.bRef > maxAgeIn
            bool   farOut     = distL > maxDistIn * 3.0
            if isSweepEvt
                if c.dir == 1
                    lastBslSwB := bar_index
                else
                    lastSslSwB := bar_index
                lastSwTxt := (c.dir == 1 ? "BSL " : "SSL ") + why
            if taken or expired or farOut
                if c.id == primId
                    f_ghost(ghosts, c, time, taken ? why : expired ? "EXPIRED" : "EJECTED", ghostMaxIn)
                    if taken
                        evDolSwept := true
                        swMsg := "DOL Swept | " + (c.dir == 1 ? "BSL " : "SSL ") + why + " | Score " + str.tostring(math.round(c.score)) + " | " + syminfo.ticker + " " + chLbl
                array.remove(liqs, i)

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 16. CANDIDATE SCORING (0-100, normalised weights)
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    float wSum  = wProxIn + wFreshIn + wConfIn + wDensIn + wStrIn + wHtfIn
    float wDiv  = wSum > 0 ? wSum : 1.0
    float pdPos = not na(lastSH) and not na(lastSL) and lastSH > lastSL ? (close - lastSL) / (lastSH - lastSL) : 0.5
    int   nS    = array.size(liqs)
    eligCnt := 0
    if nS > 0
        for i = 0 to nS - 1
            Liq   c     = array.get(liqs, i)
            float distL = math.abs(c.lvl - close) / atrS
            bool  side  = c.dir == 1 ? c.lvl > close : c.lvl < close
            bool  elig  = side and distL <= maxDistIn
            // A. proximity (Cauchy-shaped, 0.5 at 35 % of max distance)
            float fP = 1.0 / (1.0 + math.pow(distL / (maxDistIn * 0.35), 2))
            // B. freshness (exponential half-life; HTF sources decay slower)
            float sw = f_structW(c)
            float hl = halfLifeIn * (1.0 + 2.0 * sw)
            float fF = math.exp(-LN2 * math.max(0, bar_index - c.bRef) / hl)
            // C. confluence + D. density (full evaluation only for eligible targets)
            float cnt  = math.max(0, f_flagCount(c) - 1)
            float dens = c.refs - 1
            if elig
                eligCnt += 1
                float lo = c.bot - mD
                float hi = c.top + mD
                cnt += f_gapOverlap(fvgs, lo, hi) ? 1 : 0
                cnt += f_gapOverlap(ifvgs, lo, hi) ? 1 : 0
                cnt += f_blkOverlap(obs, lo, hi, true) ? 1 : 0
                cnt += f_blkOverlap(brks, lo, hi, false) ? 1 : 0
                for j = 0 to nS - 1
                    if j != i
                        Liq o = array.get(liqs, j)
                        if o.dir == c.dir and math.abs(o.lvl - c.lvl) <= atrS
                            dens += 0.5
            cnt += lastBrkDir == c.dir ? 1 : 0
            cnt += (c.dir == 1 and pdPos < 0.45) or (c.dir == -1 and pdPos > 0.55) ? 1 : 0
            cnt += (c.dir == 1 ? bar_index - lastSslSwB : bar_index - lastBslSwB) <= 30 ? 1 : 0
            float fC = math.min(1.0, cnt / 4.0)
            float fD = math.min(1.0, dens / 3.0)
            // E. structural importance
            float fS = math.min(1.0, sw + (c.hNode ? 0.2 : 0.0))
            // F. HTF alignment
            float lvlH = c.hHtf or c.hPW or c.hPM ? 1.0 : c.hPD or c.hStf ? 0.5 : 0.0
            float fH   = 0.45 * f_align(int(nz(h1St)), c.dir) + 0.25 * f_align(int(nz(h2St)), c.dir) + 0.30 * lvlH
            float raw  = (wProxIn * fP + wFreshIn * fF + wConfIn * fC + wDensIn * fD + wStrIn * fS + wHtfIn * fH) / wDiv
            // G. mitigation penalty
            raw := raw * (1.0 - mitPenIn * c.mitig) * math.pow(0.85, c.touches)
            c.score := math.max(0.0, math.min(100.0, 100.0 * raw))
            c.elig  := elig
            c.fP := fP
            c.fF := fF
            c.fC := fC
            c.fD := fD
            c.fS := fS
            c.fH := fH

    // ─────────────────────────────────────────────────────────────────────────────────────────────
    // 17. DOL RANKING / SELECTION (quality-ranked, hysteresis-stabilised)
    // ─────────────────────────────────────────────────────────────────────────────────────────────
    int   bestB = -1
    int   bestS = -1
    float scB   = -1.0
    float scS   = -1.0
    if nS > 0
        for i = 0 to nS - 1
            Liq c = array.get(liqs, i)
            if c.elig and c.score >= minScoreIn
                if c.dir == 1 and c.score > scB
                    scB   := c.score
                    bestB := i
                if c.dir == -1 and c.score > scS
                    scS   := c.score
                    bestS := i
    int candIdx = scB >= scS ? bestB : bestS
    int curIdx  = f_findId(liqs, primId)
    if curIdx >= 0
        Liq cur = array.get(liqs, curIdx)
        if not cur.elig or cur.score < minScoreIn - hystIn * 0.5
            f_ghost(ghosts, cur, time, "FADED", ghostMaxIn)
            curIdx := -1
    int newIdx = candIdx
    if curIdx >= 0
        if candIdx < 0
            newIdx := curIdx
        else if candIdx != curIdx and array.get(liqs, candIdx).score < array.get(liqs, curIdx).score + hystIn
            newIdx := curIdx
    int newId = -1
    if newIdx >= 0
        newId := array.get(liqs, newIdx).id
    if newId != oldPrim and newId >= 0
        Liq nw = array.get(liqs, newIdx)
        evNewDol := oldPrim < 0
        evDolChg := oldPrim >= 0
        evBslAct := nw.dir == 1
        evSslAct := nw.dir == -1
    primId := newId
    if newIdx >= 0
        Liq p = array.get(liqs, newIdx)
        primDir := p.dir
        primLvl := p.lvl
        primScr := p.score
    else
        primDir := 0
        primLvl := na
        primScr := na
    int secIdx = primDir == 1 ? bestS : primDir == -1 ? bestB : -1
    if secIdx >= 0
        Liq s = array.get(liqs, secIdx)
        secId  := s.id
        secDir := s.dir
        secLvl := s.lvl
        secScr := s.score
    else
        secId  := -1
        secDir := 0
        secLvl := na
        secScr := na

    float curScore = nz(primScr, 0.0)
    evScoreX  := primId >= 0 and curScore >= alScoreThIn and prevScore < alScoreThIn
    prevScore := curScore

// =====================================================================================================
// 20. PoT ENGINE — live read-out (may update intrabar; never feeds back into target selection)
// =====================================================================================================
float potLive = f_pot(primLvl, primDir, primScr, close, sigma, potHorIn, momRaw)
float potSec  = f_pot(secLvl, secDir, secScr, close, sigma, potHorIn, momRaw)

// =====================================================================================================
// 19. BIAS ENGINE — confirmed structure on every timeframe
// =====================================================================================================
int   bH2   = int(nz(h2St))
int   bH1   = int(nz(h1St))
int   bSt   = stfSec == chartSec ? structSt : int(nz(stSt))
int   bEx   = exIsCh ? structSt : int(nz(xSt))
float comp  = (0.40 * bH2 + 0.35 * bH1 + 0.25 * bSt) / 2.0
int   bComp = comp > 0.25 ? 2 : comp > 0.05 ? 1 : comp < -0.25 ? -2 : comp < -0.05 ? -1 : 0
int   h1Sign = bH1 > 0 ? 1 : bH1 < 0 ? -1 : 0
bool  evBiasChg = barstate.isconfirmed and masterIn and h1Sign != nz(h1Sign[1]) and bar_index > 0

// =====================================================================================================
// 25. CONFLUENCE SIGNAL LAYER (optional, confirmed bars only) + LVN sampling
// =====================================================================================================
if barstate.isconfirmed and masterIn
    float potC = nz(potLive, 0.0)
    evPotX  := primId >= 0 and potC >= alPotThIn and prevPot < alPotThIn
    prevPot := primId >= 0 ? potC : 0.0

    if sigOnIn
        bool coolOk = bar_index - lastSigB > sigCoolIn
        bool bullOk = bar_index - lastSslSwB <= sigWinIn and evBullBrk and primDir == 1 and nz(primScr) >= sigMinScoreIn and potC >= sigMinPotIn and (not sigHtfIn or bH1 >= 1) and (bar_index - lastBullPdB <= sigWinIn or bar_index - lastBullFvgB <= 3)
        bool bearOk = bar_index - lastBslSwB <= sigWinIn and evBearBrk and primDir == -1 and nz(primScr) >= sigMinScoreIn and potC >= sigMinPotIn and (not sigHtfIn or bH1 <= -1) and (bar_index - lastBearPdB <= sigWinIn or bar_index - lastBearFvgB <= 3)
        sigBull := coolOk and bullOk
        sigBear := coolOk and bearOk and not sigBull
        if sigBull or sigBear
            lastSigB := bar_index

    // 15. LVN sampling — one row per CLOSED source-timeframe bar
    if showLvnIn and not na(lvTm) and lvTm != nz(lvTm[1], -1)
        array.push(lvTs, lvTm)
        array.push(lvHs, lvHi)
        array.push(lvLs, lvLo)
        array.push(lvVs, nz(lvVo))
        while array.size(lvTs) > lvnLookIn
            array.shift(lvTs)
            array.shift(lvHs)
            array.shift(lvLs)
            array.shift(lvVs)

// =====================================================================================================
// 21. VISUAL ENGINE — state-driven redraw on the last bar only (bounded object count)
// =====================================================================================================
var array<box>   rBoxes = array.new<box>()
var array<line>  rLines = array.new<line>()
var array<label> rLbls  = array.new<label>()

f_clearAll(array<box> bs, array<line> ls, array<label> lbs) =>
    for b in bs
        box.delete(b)
    for l in ls
        line.delete(l)
    for lb in lbs
        label.delete(lb)
    array.clear(bs)
    array.clear(ls)
    array.clear(lbs)
    true

f_room(array<box> bs, array<line> ls, array<label> lbs, int cap) =>
    array.size(bs) + array.size(ls) + array.size(lbs) < cap

f_mkBox(array<box> store, int l, float t, int r, float b, color bg, color bd, string bst, string txt, color tc) =>
    box bx = box.new(l, t, r, b, border_color = bd, border_width = 1, border_style = bst, xloc = xloc.bar_time, bgcolor = bg, text = txt, text_size = size.tiny, text_color = tc, text_halign = text.align_right, text_valign = text.align_center)
    array.push(store, bx)
    bx

f_mkLine(array<line> store, int x1, float y1, int x2, float y2, color c, string st, int w) =>
    line ln = line.new(x1, y1, x2, y2, xloc = xloc.bar_time, color = c, style = st, width = w)
    array.push(store, ln)
    ln

f_mkLbl(array<label> store, int x, float y, string txt, color bg, color tc, string st, string sz, string tip) =>
    label lb = label.new(x, y, txt, xloc = xloc.bar_time, color = bg, textcolor = tc, style = st, size = sz, textalign = text.align_left, tooltip = tip)
    array.push(store, lb)
    lb

// Nearest-first selection of gaps on one side of price
f_pickGaps(array<Gap> a, int side, int k, float px, float maxD) =>
    array<int> out = array.new<int>()
    int n = array.size(a)
    if n > 0 and k > 0
        for rep = 1 to k
            int   bi = -1
            float bd = 1e20
            for j = 0 to n - 1
                Gap   g   = array.get(a, j)
                float mid = (g.top + g.bot) / 2.0
                bool  ok  = side == 1 ? mid >= px : mid < px
                float d   = math.abs(mid - px)
                if ok and d <= maxD and d < bd and not array.includes(out, j)
                    bd := d
                    bi := j
            if bi >= 0
                array.push(out, bi)
    out

// Nearest-first selection of blocks on one side of price
f_pickBlks(array<Blk> a, int side, int k, float px, float maxD, bool skipMit) =>
    array<int> out = array.new<int>()
    int n = array.size(a)
    if n > 0 and k > 0
        for rep = 1 to k
            int   bi = -1
            float bd = 1e20
            for j = 0 to n - 1
                Blk   b   = array.get(a, j)
                float mid = (b.top + b.bot) / 2.0
                bool  ok  = (side == 1 ? mid >= px : mid < px) and not (skipMit and b.mitigated)
                float d   = math.abs(mid - px)
                if ok and d <= maxD and d < bd and not array.includes(out, j)
                    bd := d
                    bi := j
            if bi >= 0
                array.push(out, bi)
    out

// Highest-score selection of liquidity levels on one side (excluding the primary / secondary)
f_pickLiq(array<Liq> a, int side, int k, int ex1, int ex2) =>
    array<int> out = array.new<int>()
    int n = array.size(a)
    if n > 0 and k > 0
        for rep = 1 to k
            int   bi = -1
            float bs = -1.0
            for j = 0 to n - 1
                Liq c = array.get(a, j)
                if c.dir == side and c.elig and c.id != ex1 and c.id != ex2 and c.score > bs and not array.includes(out, j)
                    bs := c.score
                    bi := j
            if bi >= 0
                array.push(out, bi)
    out

var table dash = table.new(f_pos(biasPosIn), 3, 8, bgcolor = color.new(colPanelIn, 12), frame_color = color.new(colNeuIn, 70), frame_width = 1, border_color = color.new(colNeuIn, 88), border_width = 1)
var table dbg  = table.new(position.bottom_left, 2, 18, bgcolor = color.new(colPanelIn, 10), frame_color = color.new(colNeuIn, 70), frame_width = 1)

if barstate.islast
    f_clearAll(rBoxes, rLines, rLbls)
    table.clear(dash, 0, 0, 2, 7)
    table.clear(dbg, 0, 0, 1, 17)

if barstate.islast and masterIn
    int    rightT = time + extIn * barMs
    string lsz    = f_sz(lblSizeIn)
    color  noCol  = color.new(#000000, 100)

    // ── LVN (subtle, optional)
    if showLvnIn and array.size(lvHs) >= 10
        float pLo = array.min(lvLs)
        float pHi = array.max(lvHs)
        if pHi > pLo
            int   nb   = lvnBinsIn
            float step = (pHi - pLo) / nb
            array<float> bins = array.new<float>(nb, 0.0)
            int nL2 = array.size(lvHs)
            for j = 0 to nL2 - 1
                float bh = array.get(lvHs, j)
                float bl = array.get(lvLs, j)
                float bv = array.get(lvVs, j)
                int   i0 = math.max(0, math.min(nb - 1, math.floor((bl - pLo) / step)))
                int   i1 = math.max(0, math.min(nb - 1, math.floor((bh - pLo) / step)))
                float per = bv / (i1 - i0 + 1)
                for k = i0 to i1
                    array.set(bins, k, array.get(bins, k) + per)
            float tot = array.sum(bins)
            if tot > 0
                float mean = tot / nb
                array<float> lvnP = array.new<float>()
                bool prevL = false
                for k = 1 to nb - 2
                    float v     = array.get(bins, k)
                    float nbAvg = (array.get(bins, k - 1) + array.get(bins, k + 1)) / 2.0
                    bool  isL   = v < lvnThrIn * mean and v <= nbAvg
                    if isL and not prevL
                        array.push(lvnP, pLo + step * (k + 0.5))
                    prevL := isL
                int nP = array.size(lvnP)
                if nP > 0
                    int lvT0 = array.get(lvTs, 0)
                    int upC  = 0
                    for k = 0 to nP - 1
                        float y = array.get(lvnP, k)
                        if y > close and upC < lvnShowIn and f_room(rBoxes, rLines, rLbls, maxVisIn)
                            f_mkBox(rBoxes, lvT0, y + step * 0.5, rightT, y - step * 0.5, color.new(colLvnIn, 93), color.new(colLvnIn, 100), line.style_solid, "LVN", color.new(colLvnIn, 45))
                            upC += 1
                    int dnC = 0
                    for k = nP - 1 to 0
                        float y = array.get(lvnP, k)
                        if y < close and dnC < lvnShowIn and f_room(rBoxes, rLines, rLbls, maxVisIn)
                            f_mkBox(rBoxes, lvT0, y + step * 0.5, rightT, y - step * 0.5, color.new(colLvnIn, 93), color.new(colLvnIn, 100), line.style_solid, "LVN", color.new(colLvnIn, 45))
                            dnC += 1

    // ── FVG / iFVG
    float gapD = fvgDistIn * atrS
    if showFvgIn
        for sd = 0 to 1
            int side = sd == 0 ? 1 : -1
            array<int> idx = f_pickGaps(fvgs, side, fvgShowIn, close, gapD)
            for j in idx
                Gap   g  = array.get(fvgs, j)
                color gc = g.dir == 1 ? colBullIn : colBearIn
                if f_room(rBoxes, rLines, rLbls, maxVisIn)
                    string ft = g.mitig > 0.01 ? "FVG " + str.tostring(math.round(g.mitig * 100)) + "%" : "FVG"
                    f_mkBox(rBoxes, g.t0, g.top, rightT, g.bot, color.new(gc, zoneOpIn), color.new(gc, 75), line.style_solid, ft, color.new(gc, 25))
    if showIfvgIn
        for sd = 0 to 1
            int side = sd == 0 ? 1 : -1
            array<int> idx = f_pickGaps(ifvgs, side, fvgShowIn, close, gapD)
            for j in idx
                Gap g = array.get(ifvgs, j)
                if f_room(rBoxes, rLines, rLbls, maxVisIn)
                    f_mkBox(rBoxes, g.t0, g.top, rightT, g.bot, color.new(colIfvgIn, zoneOpIn), color.new(colIfvgIn, 45), line.style_dashed, g.dir == 1 ? "iFVG ▲" : "iFVG ▼", color.new(colIfvgIn, 20))

    // ── Order blocks / breakers
    float blkD = maxDistIn * atrS
    if showObIn
        for sd = 0 to 1
            int side = sd == 0 ? 1 : -1
            array<int> idx = f_pickBlks(obs, side, blkShowIn, close, blkD, obHideMitIn)
            for j in idx
                Blk   b  = array.get(obs, j)
                color oc = b.dir == 1 ? colObBIn : colObSIn
                if f_room(rBoxes, rLines, rLbls, maxVisIn)
                    f_mkBox(rBoxes, b.t0, b.top, rightT, b.bot, color.new(oc, b.mitigated ? 94 : zoneOpIn), color.new(oc, 55), line.style_solid, b.dir == 1 ? "OB+" : "OB−", color.new(oc, 20))
    if showBrkIn
        for sd = 0 to 1
            int side = sd == 0 ? 1 : -1
            array<int> idx = f_pickBlks(brks, side, blkShowIn, close, blkD, false)
            for j in idx
                Blk   b  = array.get(brks, j)
                color bc = b.dir == 1 ? colBullIn : colBearIn
                if f_room(rBoxes, rLines, rLbls, maxVisIn)
                    f_mkBox(rBoxes, b.t0, b.top, rightT, b.bot, color.new(bc, 93), color.new(bc, 40), line.style_dotted, b.dir == 1 ? "BRK+" : "BRK−", color.new(bc, 20))

    // ── Market structure (BOS / CHoCH / swing labels)
    int nE = array.size(sEvts)
    if nE > 0 and (showBosIn or showChIn)
        int drawn = 0
        for k = nE - 1 to 0
            SEvt e = array.get(sEvts, k)
            bool want = e.choch ? showChIn : showBosIn
            if want and drawn < strMaxIn and f_room(rBoxes, rLines, rLbls, maxVisIn)
                color ec = e.dir == 1 ? colBullIn : colBearIn
                f_mkLine(rLines, e.t0, e.lvl, e.t1, e.lvl, color.new(ec, 35), line.style_dashed, 1)
                f_mkLbl(rLbls, int((e.t0 + e.t1) / 2), e.lvl, e.choch ? "CHoCH" : "BOS", noCol, color.new(ec, 15), e.dir == 1 ? label.style_label_down : label.style_label_up, size.tiny, "")
                drawn += 1
    int nW = array.size(swLbls)
    if showSwIn and nW > 0
        int drawnW = 0
        for k = nW - 1 to 0
            SwLbl w = array.get(swLbls, k)
            if drawnW < strMaxIn * 2 and f_room(rBoxes, rLines, rLbls, maxVisIn)
                f_mkLbl(rLbls, w.t, w.p, w.txt, noCol, color.new(colTextIn, 35), w.isHigh ? label.style_label_down : label.style_label_up, size.tiny, "")
                drawnW += 1

    // ── Current day high / low
    if showDayHLIn and pdOk and not na(cdh) and not na(dStartT)
        f_mkLine(rLines, dStartT, cdh, rightT, cdh, color.new(colNeuIn, 45), line.style_dotted, 1)
        f_mkLine(rLines, dStartT, cdl, rightT, cdl, color.new(colNeuIn, 45), line.style_dotted, 1)
        f_mkLbl(rLbls, rightT, cdh, "DH", noCol, color.new(colNeuIn, 20), label.style_label_left, size.tiny, "Current day high")
        f_mkLbl(rLbls, rightT, cdl, "DL", noCol, color.new(colNeuIn, 20), label.style_label_left, size.tiny, "Current day low")

    // ── Ghost trail (former DOL targets)
    int nG = array.size(ghosts)
    if showGhIn and nG > 0
        for k = nG - 1 to 0
            Ghost gh = array.get(ghosts, k)
            color gc = gh.dir == 1 ? colBullIn : colBearIn
            if f_room(rBoxes, rLines, rLbls, maxVisIn)
                string gt = (gh.dir == 1 ? "BSL " : "SSL ") + str.tostring(math.round(gh.score)) + " ✕ " + gh.why
                f_mkBox(rBoxes, gh.t0, gh.top, math.max(gh.t1, gh.t0 + barMs), gh.bot, color.new(gc, ghostOpIn), color.new(gc, 80), line.style_dotted, gt, color.new(gc, 55))

    // ── Ranked liquidity levels (non-primary)
    if showLvlIn and lvlSideIn > 0
        for sd = 0 to 1
            int side = sd == 0 ? 1 : -1
            array<int> idx = f_pickLiq(liqs, side, lvlSideIn, primId, secId)
            for j in idx
                Liq   c  = array.get(liqs, j)
                color lc = c.dir == 1 ? colBullIn : colBearIn
                if f_room(rBoxes, rLines, rLbls, maxVisIn)
                    f_mkLine(rLines, c.t0, c.lvl, rightT, c.lvl, color.new(lc, 60), line.style_dotted, 1)
                    f_mkLbl(rLbls, rightT, c.lvl, (c.dir == 1 ? "BSL " : "SSL ") + str.tostring(math.round(c.score)), noCol, color.new(lc, 35), label.style_label_left, size.tiny, f_srcList(c) + " · " + c.tfTxt)

    // ── Opposite-side target
    int sIdx = f_findId(liqs, secId)
    if showDolIn and showSecIn and sIdx >= 0
        Liq   s  = array.get(liqs, sIdx)
        color sc = s.dir == 1 ? colBullIn : colBearIn
        f_mkBox(rBoxes, s.t0, s.top, rightT, s.bot, color.new(sc, 92), color.new(sc, 70), line.style_dashed, "", sc)
        f_mkLine(rLines, s.t0, s.lvl, rightT, s.lvl, color.new(sc, 40), line.style_dashed, 1)
        string st = (s.dir == 1 ? "BSL " : "SSL ") + str.tostring(math.round(s.score)) + (showPotIn and not na(potSec) ? "  ·  " + str.tostring(math.round(potSec)) + "%" : "")
        f_mkLbl(rLbls, rightT, s.lvl, st, color.new(sc, 80), color.new(colTextIn, 10), label.style_label_left, size.tiny, f_srcList(s) + " · " + s.tfTxt)

    // ── ACTIVE DOL (always drawn — bypasses the visible-object cap)
    int pIdx = f_findId(liqs, primId)
    if showDolIn and pIdx >= 0
        Liq   p  = array.get(liqs, pIdx)
        color dc = p.dir == 1 ? colBullIn : colBearIn
        float dA = math.abs(p.lvl - close) / atrS
        f_mkBox(rBoxes, p.t0, p.top, rightT, p.bot, color.new(dc, dolOpIn), color.new(dc, 30), line.style_solid, "", dc)
        f_mkLine(rLines, p.t0, p.lvl, rightT, p.lvl, color.new(dc, 5), line.style_solid, 2)
        f_mkLbl(rLbls, p.t0, p.lvl, "", color.new(dc, 0), dc, label.style_circle, size.tiny, "DOL origin")
        if showPathIn
            f_mkLine(rLines, time, close, rightT, p.lvl, color.new(dc, 45), line.style_dotted, 1)
        string l1  = "DOL  " + (p.dir == 1 ? "BSL ▲" : "SSL ▼")
        string l2  = "Score " + str.tostring(math.round(p.score)) + (showPotIn and not na(potLive) ? "  |  PoT " + str.tostring(math.round(potLive)) + "%" : "")
        string l3  = f_srcList(p) + " · " + p.tfTxt + " · " + str.tostring(dA, "#.#") + " ATR"
        string tip = "Proximity " + str.tostring(p.fP, "#.##") + "\nFreshness " + str.tostring(p.fF, "#.##") + "\nConfluence " + str.tostring(p.fC, "#.##") + "\nDensity " + str.tostring(p.fD, "#.##") + "\nStructure " + str.tostring(p.fS, "#.##") + "\nHTF " + str.tostring(p.fH, "#.##") + "\nMitigation " + str.tostring(p.mitig * 100, "#") + "%  ·  Touches " + str.tostring(p.touches) + "\nRefs " + str.tostring(p.refs) + "\nPoT is a heuristic, not a guaranteed probability."
        f_mkLbl(rLbls, rightT, p.lvl, l1 + "\n" + l2 + "\n" + l3, color.new(dc, 12), color.white, label.style_label_left, lsz, tip)

    // ── Bias dashboard
    if showBiasIn
        color hdr = color.new(colTextIn, 0)
        table.cell(dash, 0, 0, "DOL ENGINE", text_color = hdr, text_size = size.small, text_halign = text.align_left)
        table.cell(dash, 1, 0, "", text_size = size.small)
        table.cell(dash, 2, 0, modeIn, text_color = color.new(colTextIn, 40), text_size = size.tiny, text_halign = text.align_right)
        for r = 0 to 3
            int    st2 = r == 0 ? bH2 : r == 1 ? bH1 : r == 2 ? bSt : bEx
            string nm  = r == 0 ? "HTF2 " + h2Lbl : r == 1 ? "HTF " + h1Lbl : r == 2 ? "STF " + stfLbl : "EXEC " + exLbl
            color  bc  = st2 > 0 ? colBullIn : st2 < 0 ? colBearIn : colNeuIn
            table.cell(dash, 0, r + 1, nm, text_color = color.new(colTextIn, 25), text_size = size.tiny, text_halign = text.align_left)
            table.cell(dash, 1, r + 1, f_biasArrow(st2), text_color = bc, text_size = size.small)
            table.cell(dash, 2, r + 1, f_biasTxt(st2), text_color = bc, text_size = size.tiny, text_halign = text.align_right)
        color cc = bComp > 0 ? colBullIn : bComp < 0 ? colBearIn : colNeuIn
        table.cell(dash, 0, 5, "BIAS", text_color = hdr, text_size = size.tiny, text_halign = text.align_left)
        table.cell(dash, 1, 5, f_biasArrow(bComp), text_color = cc, text_size = size.small)
        table.cell(dash, 2, 5, f_biasTxt(bComp), text_color = cc, text_size = size.tiny, text_halign = text.align_right)
        color  pc  = primDir == 1 ? colBullIn : primDir == -1 ? colBearIn : colNeuIn
        string dT  = primDir == 1 ? "BSL " + str.tostring(math.round(nz(primScr))) : primDir == -1 ? "SSL " + str.tostring(math.round(nz(primScr))) : "—"
        string pT  = showPotIn and not na(potLive) ? str.tostring(math.round(potLive)) + "%" : ""
        table.cell(dash, 0, 6, "DOL", text_color = hdr, text_size = size.tiny, text_halign = text.align_left)
        table.cell(dash, 1, 6, dT, text_color = pc, text_size = size.tiny)
        table.cell(dash, 2, 6, pT, text_color = pc, text_size = size.tiny, text_halign = text.align_right)

    // =================================================================================================
    // 23. DEBUG
    // =================================================================================================
    if debugIn
        int    dIdx = f_findId(liqs, primId)
        string cmp  = "—"
        string src  = "—"
        string mit  = "—"
        if dIdx >= 0
            Liq d = array.get(liqs, dIdx)
            cmp := "P" + str.tostring(d.fP, "#.##") + " F" + str.tostring(d.fF, "#.##") + " C" + str.tostring(d.fC, "#.##") + " D" + str.tostring(d.fD, "#.##") + " S" + str.tostring(d.fS, "#.##") + " H" + str.tostring(d.fH, "#.##")
            src := f_srcList(d) + " · " + d.tfTxt
            mit := str.tostring(d.mitig * 100, "#") + "% · " + str.tostring(d.touches) + " touch"
        array<string> ks = array.from("Candidates", "Eligible", "FVG / iFVG", "OB / BRK", "Ghosts", "ATR", "σ (bar)", "Pivot len", "TFs", "Primary", "Score", "Components", "Source", "Mitigation", "PoT (live)", "Last sweep", "Struct state", "HTF bias")
        array<string> vs = array.from(str.tostring(array.size(liqs)), str.tostring(eligCnt), str.tostring(array.size(fvgs)) + " / " + str.tostring(array.size(ifvgs)), str.tostring(array.size(obs)) + " / " + str.tostring(array.size(brks)), str.tostring(array.size(ghosts)), str.tostring(atrS, format.mintick), str.tostring(sigma, format.mintick), str.tostring(pivLen), stfLbl + " / " + h1Lbl + " / " + h2Lbl, primDir == 1 ? "BSL #" + str.tostring(primId) : primDir == -1 ? "SSL #" + str.tostring(primId) : "none", str.tostring(nz(primScr), "#.#"), cmp, src, mit, na(potLive) ? "—" : str.tostring(potLive, "#") + "%", lastSwTxt, str.tostring(structSt), f_biasTxt(bH1))
        for r = 0 to array.size(ks) - 1
            table.cell(dbg, 0, r, array.get(ks, r), text_color = color.new(colTextIn, 30), text_size = size.tiny, text_halign = text.align_left)
            table.cell(dbg, 1, r, array.get(vs, r), text_color = colTextIn, text_size = size.tiny, text_halign = text.align_left)

// =====================================================================================================
// SIGNAL MARKERS (global scope) + data-window read-outs
// =====================================================================================================
plotshape(sigOnIn and sigBull, "Bullish Confluence", shape.triangleup, location.belowbar, colBullIn, size = size.small)
plotshape(sigOnIn and sigBear, "Bearish Confluence", shape.triangledown, location.abovebar, colBearIn, size = size.small)
plot(primScr, "DOL Score", color = colNeuIn, display = display.data_window)
plot(potLive, "DOL PoT %", color = colNeuIn, display = display.data_window)
plot(primLvl, "DOL Level", color = colNeuIn, display = display.data_window)

// =====================================================================================================
// 22. ALERTS
// =====================================================================================================
// Static alertconditions (use "Once Per Bar Close")
alertcondition(evNewDol,   "DOL · New Primary",        "DOL Engine: new primary DOL on {{ticker}} {{interval}}")
alertcondition(evDolChg,   "DOL · Target Changed",     "DOL Engine: DOL target changed on {{ticker}} {{interval}}")
alertcondition(evDolSwept, "DOL · Target Swept",       "DOL Engine: DOL target swept on {{ticker}} {{interval}}")
alertcondition(evBslAct,   "DOL · BSL Activated",      "DOL Engine: BSL target activated on {{ticker}} {{interval}}")
alertcondition(evSslAct,   "DOL · SSL Activated",      "DOL Engine: SSL target activated on {{ticker}} {{interval}}")
alertcondition(evNewFvg,   "DOL · New FVG",            "DOL Engine: new FVG on {{ticker}} {{interval}}")
alertcondition(evNewIfvg,  "DOL · New iFVG",           "DOL Engine: new iFVG on {{ticker}} {{interval}}")
alertcondition(evScoreX,   "DOL · Score Threshold",    "DOL Engine: DOL score crossed threshold on {{ticker}} {{interval}}")
alertcondition(evPotX,     "DOL · PoT Threshold",      "DOL Engine: PoT crossed threshold on {{ticker}} {{interval}}")
alertcondition(sigOnIn and sigBull, "DOL · Bullish Confluence", "DOL Engine: bullish confluence on {{ticker}} {{interval}}")
alertcondition(sigOnIn and sigBear, "DOL · Bearish Confluence", "DOL Engine: bearish confluence on {{ticker}} {{interval}}")
alertcondition(evBiasChg,  "DOL · HTF Bias Change",    "DOL Engine: HTF bias changed on {{ticker}} {{interval}}")

// Dynamic alert() messages (create one alert: "Any alert() function call")
string aDir = primDir == 1 ? "BSL" : primDir == -1 ? "SSL" : "—"
string aTail = " | " + aDir + " | Score " + str.tostring(math.round(nz(primScr))) + (na(potLive) ? "" : " | PoT " + str.tostring(math.round(potLive)) + "%") + " | " + syminfo.ticker + " " + chLbl
if barstate.isconfirmed and masterIn
    if alNewIn and evNewDol
        alert("New DOL" + aTail, alert.freq_once_per_bar_close)
    if alChgIn and evDolChg
        alert("DOL Changed" + aTail, alert.freq_once_per_bar_close)
    if alSweptIn and evDolSwept
        alert(swMsg, alert.freq_once_per_bar_close)
    if alBslIn and evBslAct
        alert("BSL Target Activated" + aTail, alert.freq_once_per_bar_close)
    if alSslIn and evSslAct
        alert("SSL Target Activated" + aTail, alert.freq_once_per_bar_close)
    if alFvgIn and evNewFvg
        alert("New FVG | " + syminfo.ticker + " " + chLbl, alert.freq_once_per_bar_close)
    if alIfvgIn and evNewIfvg
        alert("New iFVG | " + syminfo.ticker + " " + chLbl, alert.freq_once_per_bar_close)
    if alScoreIn and evScoreX
        alert("DOL Score ≥ " + str.tostring(alScoreThIn) + aTail, alert.freq_once_per_bar_close)
    if alPotIn and evPotX
        alert("DOL PoT ≥ " + str.tostring(alPotThIn) + "%" + aTail, alert.freq_once_per_bar_close)
    if alBullIn and sigOnIn and sigBull
        alert("Bullish Confluence" + aTail, alert.freq_once_per_bar_close)
    if alBearIn and sigOnIn and sigBear
        alert("Bearish Confluence" + aTail, alert.freq_once_per_bar_close)
    if alBiasIn and evBiasChg
        alert("HTF Bias Change | " + h1Lbl + " " + f_biasTxt(bH1) + " | " + syminfo.ticker + " " + chLbl, alert.freq_once_per_bar_close)
