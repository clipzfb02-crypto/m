colPanelIn = input.color(#0B0E14, "Panel", inline = "c3", group = G_VIS)
colDolIn   = input.color(#E040FB, "DOL Target", inline = "c4", group = G_VIS, tooltip = "Colour of the DOL target line, zone, dashed path and label (magenta, TradeAxis style). Blue and red are reserved for real BUY / SELL trades only.")
