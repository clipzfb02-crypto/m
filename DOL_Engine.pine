//
// DOL ENGINE v3 — Draw on Liquidity (self-calibrating)
// Original Pine Script v6 code (not derived from any closed-source script).
//
// One clean read: WHERE is price being drawn, HOW strong is that draw, and WHAT is the bias.
//   • Target pool: BSL / SSL pools (swings, equal highs/lows, PDH/PDL, PWH/PWL, PMH/PML, sessions,
//     structure-TF & HTF swings) + PD arrays (FVG, iFVG, Order Block, Breaker).
//   • Each target is a zone anchored to its origin candle and scored 0-100 (proximity, freshness,
//     confluence, density, structure, HTF alignment). The best target becomes the DOL.
//   • A target is hit when price touches the zone. Former DOLs leave a faint Ghost Trail.
//
// Non-repaint:
//   • all engine state changes execute on confirmed bars only;
//   • pivots are confirmed pivots anchored to their real candle;
//   • all request.security() calls return [1]-offset values with lookahead_on (closed HTF bars only);
//   • PoT on the label / table updates live, but target SELECTION only changes at bar close.
//
// PoT (Probability of Touch):
//   model  = first-passage probability of a drifting random walk (Garman-Klass volatility, EWMA drift)
//            over the PoT horizon, lightly weighted by target quality;
//   shown  = model corrected by this chart's OWN resolved history (self-calibration: every sampled
//            prediction is checked against what price actually did, then binned by predicted PoT).
//   Capped at 95 %. It is an estimate, never a guarantee.

//@version=6
indicator("DOL Engine v3 · Draw on Liquidity", shorttitle = "DOL", overlay = true, max_boxes_count = 120, max_lines_count = 120, max_labels_count = 120, max_bars_back = 500)

// =====================================================================================================
// CONSTANTS
// =====================================================================================================
K_BSL  = 0
K_SSL  = 1
K_FVG  = 2
K_IFVG = 3
K_OB   = 4
K_BRK  = 5

F_SW   = 0
F_EQ   = 1
F_SESS = 2
F_PD   = 3
F_PW   = 4
F_PM   = 5
F_HTF  = 6
F_STF  = 7

LN2     = 0.6931471805599453
NEG_BIG = -1000000
INT_BIG = 2147483647

G_GEN = "◆ GENERAL"
G_TF  = "◆ TIMEFRAMES (MANUAL MODE)"
G_DOL = "◆ DOL TARGET"
G_SCR = "◆ SCORING"
G_LIQ = "◆ LIQUIDITY SOURCES"
G_SES = "◆ SESSIONS"
G_ZON = "◆ PD ARRAYS (FVG / iFVG / OB / BREAKER)"
G_STR = "◆ STRUCTURE"
G_LVN = "◆ LVN (1H VOLUME)"
G_TBL = "◆ BIAS TABLE"
G_SIG = "◆ EXECUTION SIGNALS"
G_CAL = "◆ CALIBRATION / ACCURACY"
G_VIS = "◆ STYLE"
G_ALR = "◆ ALERTS"

// =====================================================================================================
// TYPES
// =====================================================================================================
// Unified target zone: liquidity pools and PD arrays share one queue.
type Zn
    int    id
    int    kind
    int    pol
    float  top
    float  bot
    float  lvl
    int    t0
    int    bBorn
    int    bRef
    int    bC
    string tf
    int    refs      = 1
    float  dens      = 0.0
    float  qual      = 0.0
    bool   fSw       = false
    bool   fEq       = false
    bool   fSess     = false
    string sName     = ""
    bool   fPD       = false
    bool   fPW       = false
    bool   fPM       = false
    bool   fHtf      = false
    bool   fStf      = false
    bool   hasImb    = false
    float  mitig     = 0.0
    int    touches   = 0
    int    closesIn  = 0
    bool   mitigated = false
    bool   reached   = false
    bool   elig      = false
    int    side      = 0
    float  dist      = 0.0
    float  score     = 0.0
    float  pot       = 0.0
    float  potM      = 0.0
    float  prio      = 0.0
    float  fP        = 0.0
    float  fF        = 0.0
    float  fC        = 0.0
    float  fD        = 0.0
    float  fS        = 0.0
    float  fH        = 0.0

type Ghost
    int    kind
    int    side
    float  lvl
    int    t0
    int    t1
    string why

// A sampled prediction awaiting resolution (for calibration / measured hit rate)
type Pred
    float lvl
    int   side
    int   exp
    int   bin
    float pm

type SEvt
    int   dir
    float lvl
    int   t0
    int   t1
    bool  choch

