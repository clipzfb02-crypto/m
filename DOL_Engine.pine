// DOL ENGINE — Draw on Liquidity
// Original Pine Script v6 implementation of an institutional-style liquidity-mapping engine.
// It is not derived from any proprietary / closed-source code.
//
// Pipeline:  detect candidates → classify → merge into zones → filter → score (0-100)
//            → rank → select primary BSL / SSL draw → track sweeps → ghost trail.
//
// Non-repaint contract:
//   • every structural / liquidity / zone state change is executed only on confirmed bars
//     (barstate.isconfirmed), so realtime history equals reloaded history;
//   • pivots are confirmed pivots (right-side bars required) and are anchored at their true bar;
//   • every request.security() call returns values offset by [1] with lookahead_on
//     (= last CLOSED higher-timeframe bar only, no future leak);
//   • the only live (intrabar) value is the PoT read-out, which never feeds back into
//     historical target selection.
//
// PoT is a heuristic proximity / viability score (0-95 %). It is NOT a guaranteed probability.

//@version=6
indicator("DOL Engine · Draw on Liquidity", shorttitle = "DOL Engine", overlay = true, max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200, max_bars_back = 300)

// =====================================================================================================
// 2. CONSTANTS
// =====================================================================================================
S_SWING = 0
S_EQ    = 1
S_SESS  = 2
S_PD    = 3
S_PW    = 4
S_PM    = 5
S_HTF   = 6
S_STF   = 7
LN2     = 0.6931471805599453
NEG_BIG = -1000000

G_GEN = "◆ GENERAL"
G_TF  = "◆ TIMEFRAMES (MANUAL)"
G_DOL = "◆ DOL TARGET"
G_SCR = "◆ SCORING"
G_LIQ = "◆ LIQUIDITY"
G_SES = "◆ SESSIONS"
G_FVG = "◆ FVG / iFVG"
G_STR = "◆ STRUCTURE"
G_OB  = "◆ ORDER BLOCKS"
G_BRK = "◆ BREAKERS"
G_LVN = "◆ LVN (VOLUME)"
G_BIA = "◆ BIAS DASHBOARD"
G_SIG = "◆ CONFLUENCE SIGNALS"
G_VIS = "◆ VISUALS"
G_ALR = "◆ ALERTS"

// =====================================================================================================
// TYPES
// =====================================================================================================
// Liquidity candidate (merged zone)
type Liq
    int    id
    int    dir
    float  lvl
    float  top
    float  bot
    int    t0
    int    bRef
    int    bAdd
    int    src
    string tfTxt
    string sName   = ""
    int    refs    = 1
    bool   hSwing  = false
    bool   hEq     = false
    bool   hSess   = false
    bool   hPD     = false
    bool   hPW     = false
    bool   hPM     = false
    bool   hHtf    = false
    bool   hStf    = false
    bool   hNode   = false
    int    touches = 0
    float  mitig   = 0.0
    bool   elig    = false
    float  score   = 0.0
    float  fP      = 0.0
    float  fF      = 0.0
    float  fC      = 0.0
    float  fD      = 0.0
    float  fS      = 0.0
    float  fH      = 0.0

// Fair value gap / inversion fair value gap
type Gap
    int   kind
    int   dir
    float top
    float bot
    int   t0
    int   b0
    int   tInv     = na
    float mitig    = 0.0
    int   closesIn = 0

// Order block / breaker block
type Blk
    int   kind
    int   dir
    float top
    float bot
    int   t0
    int   b0
    int   bC
    int   tBrk      = na
    bool  mitigated = false
    int   retests   = 0
    bool  hasImb    = false

// Historical trace of a former primary DOL
type Ghost
    int    dir
    float  top
    float  bot
    int    t0
    int    t1
    string src
    float  score
    string why

// Structure break event (BOS / CHoCH)
type SEvt
    int   dir
    float lvl
    int   t0
    int   t1
    bool  choch

// Swing label (HH / HL / LH / LL)
type SwLbl
    float  p
    int    t
    string txt
    bool   isHigh

