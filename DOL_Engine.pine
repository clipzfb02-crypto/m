//
// DOL ENGINE v6 — Draw on Liquidity (research-calibrated self-learning PoT · first-touch odds · reach bands ·
//                 News Guard with event calendar · honest win-rate tracker)
// Original Pine Script v6 code (not derived from any closed-source script).
//
// One clean read: WHERE is price being drawn, HOW strong is that draw, and WHAT is the bias.
//   • Target pool: BSL / SSL pools (swings, equal highs/lows, PDH/PDL, PWH/PWL, PMH/PML, sessions,
//     structure-TF & HTF swings) + PD arrays (FVG, iFVG, Order Block, Breaker).
//   • Each target is a zone anchored to its origin candle and scored 0-100 (proximity, freshness,
//     confluence, density, structure, HTF alignment). The best target becomes the DOL.
//   • A target is hit when price touches the zone. Former DOLs leave a faint Ghost Trail.
//
// Non-repaint:
//   • all engine state changes execute on confirmed bars only;
//   • pivots are confirmed pivots anchored to their real candle;
//   • all request.security() calls return [1]-offset values with lookahead_on (closed HTF bars only);
//   • the DOL label, table and banner show the bar-close PoT the engine traded on; target SELECTION only changes at bar close.
//
// PoT (Probability of Touch) — validated out-of-sample on 13 markets × 2 timeframes (≈ 519k resolved targets):
//   base   = blend of this market's EMPIRICAL excursion distribution (how far price actually travelled within
//            the horizon, per direction and HTF state, time-of-day normalised, learned bar by bar) and the
//            analytic first-passage probability of a drifting random walk (Garman-Klass volatility, EWMA drift);
//   final  = logistic layer on [logit(base), volatility regime, momentum toward target, distance]. It starts from
//            weights fitted on that research and keeps learning slowly from this chart's resolved outcomes;
//   SKILL  = Brier skill score of the shown PoT vs. the base rate (> 0 = PoT beats a constant guess).
//   Research notes: liquidity type (EQH/EQL, sessions, PDH/PDL, HTF levels), HTF bias, sweeps, premium/discount
//   and confluence showed NO out-of-sample value for predicting touches or which side is taken first. Distance
//   and volatility do. The Score ranks structural significance; PoT is the probability. Never a guarantee.

//@version=6
indicator("DOL Engine v6 · Draw on Liquidity", shorttitle = "DOL", overlay = true, max_boxes_count = 120, max_lines_count = 120, max_labels_count = 120, max_bars_back = 500)

// =====================================================================================================
// CONSTANTS
// =====================================================================================================
K_BSL  = 0
K_SSL  = 1
K_FVG  = 2
K_IFVG = 3
K_OB   = 4
K_BRK  = 5

F_SW   = 0
F_EQ   = 1
F_SESS = 2
F_PD   = 3
F_PW   = 4
F_PM   = 5
F_HTF  = 6
F_STF  = 7

LN2     = 0.6931471805599453
NEG_BIG = -1000000
INT_BIG = 2147483647
EMP_NB  = 80
C_WARN  = #E8A33D

G_GEN = "◆ GENERAL"
G_TF  = "◆ TIMEFRAMES (MANUAL MODE)"
G_DOL = "◆ DOL TARGET"
G_SCR = "◆ SCORING"
G_LIQ = "◆ LIQUIDITY SOURCES"
G_SES = "◆ SESSIONS"
G_ZON = "◆ PD ARRAYS (FVG / iFVG / OB / BREAKER)"
G_STR = "◆ STRUCTURE"
G_LVN = "◆ LVN (1H VOLUME)"
G_TBL = "◆ BIAS TABLE"
G_SIG = "◆ EXECUTION SIGNALS"
G_CAL = "◆ CALIBRATION / ACCURACY"
G_VIS = "◆ STYLE"
G_ALR = "◆ ALERTS"

// =====================================================================================================
// TYPES
// =====================================================================================================
// Unified target zone: liquidity pools and PD arrays share one queue.
type Zn
    int    id
    int    kind
    int    pol
    float  top
    float  bot
    float  lvl
    int    t0
    int    bBorn
    int    bRef
    int    bC
    string tf
    int    refs      = 1
    float  dens      = 0.0
    float  qual      = 0.0
    bool   fSw       = false
    bool   fEq       = false
    bool   fSess     = false
    string sName     = ""
    bool   fPD       = false
    bool   fPW       = false
    bool   fPM       = false
    bool   fHtf      = false
    bool   fStf      = false
    bool   hasImb    = false
    float  mitig     = 0.0
    int    touches   = 0
    int    closesIn  = 0
    bool   mitigated = false
    bool   reached   = false
    bool   elig      = false
    int    side      = 0
    float  dist      = 0.0
    float  score     = 0.0
    float  pot       = 0.0
    float  potM      = 0.0
    float  prio      = 0.0
    float  fP        = 0.0
    float  fF        = 0.0
    float  fC        = 0.0
    float  fD        = 0.0
    float  fS        = 0.0
    float  fH        = 0.0

type Ghost
    int    kind
    int    side
    float  lvl
    int    t0
    int    t1
    string why

// A sampled prediction awaiting resolution (for calibration / measured hit rate)
type Pred
    float lvl
    int   side
    int   exp
    float pb
    float pf
    float x1
    float x2
    float x3
    float x4
    float w = 1.0

type SEvt
    int   dir
    float lvl
    int   t0
    int   t1
    bool  choch

// =====================================================================================================
// INPUTS
// =====================================================================================================
// ── GENERAL
modeIn   = input.string("Auto", "Trading Mode", options = ["Auto", "Scalping", "Day Trading", "Swing"], group = G_GEN, tooltip = "Auto picks the mode from the chart timeframe: ≤ 5m Scalping · ≤ 1H Day Trading · above Swing.\nScalping → STF 15m · HTF 1H · Macro 4H\nDay Trading → STF 1H · HTF 4H · Macro D\nSwing → STF 4H · HTF D · Macro W\n(Timeframes are never below the chart.)")
autoTuneIn = input.bool(true, "Auto-Tune Distances by Mode", group = G_GEN, tooltip = "When on, Max ATR Distance, PoT Horizon, Stop Lookback and Time Stop follow the mode (Scalping 4 / 20 / 15 / 40 · Day 6 / 30 / 20 / 60 · Swing 8 / 40 / 30 / 80) and the manual values below are ignored.")
tfSelIn  = input.string("Auto", "Timeframe Selection", options = ["Auto", "Manual"], group = G_GEN)
histIn   = input.int(20000, "History Depth (bars)", minval = 500, maxval = 20000, step = 500, group = G_GEN, tooltip = "Bars processed by the engine. Keeps the script fast and inside TradingView limits.")
masterIn = input.bool(true, "Master Enable", group = G_GEN)
debugIn  = input.bool(false, "Debug Panel", group = G_GEN)
simpleIn = input.bool(true, "Simple View (liquidity + signals only)", group = G_GEN, tooltip = "On: the chart shows only where liquidity is (the DOL line with an arrow), the BUY / SELL signals toward it with entry, stop and target, and the top banner. Off: also shows the bias table, reach bands, ghost trail and the optional PD-array / structure drawings.")

// ── MANUAL TIMEFRAMES
mHtf2In  = input.timeframe("D",   "Macro TF",     group = G_TF)
mHtf1In  = input.timeframe("240", "HTF",          group = G_TF)
mStfIn   = input.timeframe("60",  "Structure TF", group = G_TF)
mExecIn  = input.timeframe("",    "Execution TF", group = G_TF, tooltip = "Blank = chart timeframe. A timeframe below the chart falls back to the chart timeframe.")
htfPivIn = input.int(3, "HTF Pivot Length", minval = 1, maxval = 20, group = G_TF)

// ── DOL
showDolIn  = input.bool(true, "Show DOL", group = G_DOL)
unlikelyIn = input.float(20.0, "Grey Out DOL Below PoT %", minval = 0.0, maxval = 90.0, step = 1.0, group = G_DOL, tooltip = "The DOL is a liquidity TARGET, not a buy / sell signal. Below this probability it turns grey and reads UNLIKELY. If its probability falls under the Minimum PoT it is removed, even when Lock DOL is on.")
minPotIn   = input.float(5.0, "Minimum PoT to Show DOL (%)", minval = 0.0, maxval = 95.0, step = 0.5, group = G_DOL)
minScoreIn = input.int(40, "Minimum Target Score", minval = 0, maxval = 100, group = G_DOL)
maxDistIn  = input.float(6.0, "Max ATR Distance", minval = 0.5, maxval = 50.0, step = 0.5, group = G_DOL, tooltip = "Targets farther than this are not eligible. The active DOL is ejected (Ghost Trail) when price moves too far away.")
hitRuleIn  = input.string("Touch Zone", "Target Hit Rule", options = ["Touch Zone", "Wick Through", "Close Through"], group = G_DOL, tooltip = "Touch Zone: any trade inside the zone hits the target.\nWick Through: price must trade beyond the liquidity level.\nClose Through: a candle must close beyond it.")
useArrIn   = input.bool(true, "PD Arrays Can Be Targets", group = G_DOL, tooltip = "Allow FVG / iFVG / OB / Breaker zones to become the DOL (not only BSL / SSL pools).")
mergeIn    = input.float(0.25, "Merge Distance (ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = G_DOL)
zoneIn     = input.float(0.10, "Pool Zone Height (ATR)", minval = 0.01, maxval = 2.0, step = 0.01, group = G_DOL)
lockIn     = input.bool(true, "Lock DOL Until Hit", group = G_DOL, tooltip = "Once placed, the DOL stays until price hits it, it is invalidated or it expires. It never jumps to another level while you are in a trade.")
confBarsIn = input.int(2, "Confirm New DOL (bar closes)", minval = 1, maxval = 10, group = G_DOL, tooltip = "A new DOL is only placed after the same level has ranked best for this many consecutive closed bars.")
hystIn     = input.float(6.0, "Switch Hysteresis (pts)", minval = 0.0, maxval = 30.0, step = 0.5, group = G_DOL, tooltip = "A challenger must beat the active DOL by this many score points. Prevents flicker.")
potHorIn   = input.int(30, "PoT Horizon (bars)", minval = 5, maxval = 200, group = G_DOL, tooltip = "Bars ahead over which PoT and the measured DOL hit rate are evaluated.")
minDistIn  = input.float(0.5, "Min New-Target Distance (ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_DOL, tooltip = "A new DOL must be at least this far away. Prevents picking levels price is already trading into. The active DOL is kept while price approaches it.")
potRankIn  = input.float(0.35, "PoT Weight in Ranking", minval = 0.0, maxval = 1.0, step = 0.05, group = G_DOL, tooltip = "Ranking priority = (1 - w) × Score + w × calibrated PoT.")
poolMaxIn  = input.int(24, "Max Liquidity Pools", minval = 6, maxval = 60, group = G_DOL)
maxAgeIn   = input.int(1500, "Max Target Age (bars)", minval = 50, maxval = 10000, group = G_DOL)
showSecIn  = input.bool(false, "Show Opposite-Side Target", group = G_DOL)
showLvlIn  = input.bool(false, "Show Next Ranked Targets", group = G_DOL)

// ── SCORING
wProxIn    = input.float(30.0, "Proximity Weight",  minval = 0.0, maxval = 100.0, group = G_SCR)
wFreshIn   = input.float(15.0, "Freshness Weight",  minval = 0.0, maxval = 100.0, group = G_SCR)
wConfIn    = input.float(20.0, "Confluence Weight", minval = 0.0, maxval = 100.0, group = G_SCR)
wDensIn    = input.float(15.0, "Density Weight",    minval = 0.0, maxval = 100.0, group = G_SCR)
wStrIn     = input.float(10.0, "Structure Weight",  minval = 0.0, maxval = 100.0, group = G_SCR)
wHtfIn     = input.float(10.0, "HTF Weight",        minval = 0.0, maxval = 100.0, group = G_SCR, tooltip = "Weights are normalised: the score is always 0-100.")
halfLifeIn = input.int(200, "Freshness Half-Life (bars)", minval = 5, maxval = 10000, group = G_SCR, tooltip = "freshness = exp(-ln2 · age / half-life). HTF references decay up to 3x slower.")
mitPenIn   = input.float(0.6, "Mitigation Penalty", minval = 0.0, maxval = 1.0, step = 0.05, group = G_SCR)

// ── LIQUIDITY SOURCES
useSwingIn = input.bool(true, "Swing Highs / Lows", group = G_LIQ)
useEqIn    = input.bool(true, "Equal Highs / Lows", inline = "eq", group = G_LIQ)
eqTolIn    = input.float(0.10, "Tol (ATR)", minval = 0.01, maxval = 1.0, step = 0.01, inline = "eq", group = G_LIQ)
usePdIn    = input.bool(true, "PDH / PDL", inline = "pd", group = G_LIQ)
usePwIn    = input.bool(true, "PWH / PWL", inline = "pd", group = G_LIQ)
usePmIn    = input.bool(true, "PMH / PML", inline = "pd", group = G_LIQ)
useStfIn   = input.bool(true, "Structure-TF Swings", inline = "tf", group = G_LIQ)
useHtfIn   = input.bool(true, "HTF Swings", inline = "tf", group = G_LIQ)
densLbIn   = input.int(20, "Density Lookback (bars)", minval = 5, maxval = 100, group = G_LIQ, tooltip = "Bars before a swing that are scanned for equal-high/low tests and range compression (coiling).")
minPenIn   = input.float(0.02, "Min Penetration (ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G_LIQ, tooltip = "Used by the Wick / Close Through hit rules and for sweep detection.")

// ── SESSIONS
useSessIn = input.bool(true, "Session Highs / Lows", group = G_SES)
tzIn      = input.string("America/New_York", "Timezone", options = ["Exchange", "UTC", "America/New_York", "America/Chicago", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "Asia/Shanghai", "Asia/Singapore", "Australia/Sydney"], group = G_SES, tooltip = "Session windows are read in this timezone. The default session windows are New York times, so the default timezone is America/New_York. Choose Exchange to read the windows in the symbol's exchange timezone instead.")
asiaOnIn  = input.bool(true, "Asia", inline = "as", group = G_SES)
asiaIn    = input.session("2000-2359", "", inline = "as", group = G_SES)
lonOnIn   = input.bool(true, "London", inline = "ld", group = G_SES)
lonIn     = input.session("0200-0500", "", inline = "ld", group = G_SES)
nyOnIn    = input.bool(true, "New York", inline = "ny", group = G_SES)
nyIn      = input.session("0930-1130", "", inline = "ny", group = G_SES)

// ── PD ARRAYS
fvgMinIn     = input.float(0.20, "Min FVG Size (ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_ZON)
fvgMitIn     = input.int(100, "FVG Fill to Retire (%)", minval = 10, maxval = 100, group = G_ZON)
fvgInvIn     = input.float(0.0, "iFVG Flip: Close Beyond (ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = G_ZON)
ifvgInvIn    = input.float(0.10, "iFVG Invalidation (ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = G_ZON)
ifvgClosesIn = input.int(3, "iFVG Max Body Closes Inside", minval = 1, maxval = 20, group = G_ZON)
obLookIn     = input.int(10, "OB Search Lookback", minval = 3, maxval = 30, group = G_ZON)
obDispIn     = input.float(1.5, "OB Min Displacement (ATR)", minval = 0.2, maxval = 10.0, step = 0.1, group = G_ZON)
obVolIn      = input.bool(false, "OB Requires Volume Expansion", group = G_ZON)
obMitIn      = input.string("50%", "OB Mitigation Rule", options = ["Wick", "50%", "Close"], group = G_ZON)
fvgMaxIn     = input.int(10, "Max FVGs", minval = 1, maxval = 40, inline = "cap1", group = G_ZON)
ifvgMaxIn    = input.int(6, "Max iFVGs", minval = 1, maxval = 30, inline = "cap1", group = G_ZON)
obMaxIn      = input.int(6, "Max OBs", minval = 1, maxval = 30, inline = "cap2", group = G_ZON)
brkMaxIn     = input.int(4, "Max Breakers", minval = 1, maxval = 20, inline = "cap2", group = G_ZON)
zoneAgeIn    = input.int(500, "Max PD Array Age (bars)", minval = 20, maxval = 5000, group = G_ZON)
showFvgIn    = input.bool(false, "Draw FVG", inline = "d1", group = G_ZON)
showIfvgIn   = input.bool(false, "Draw iFVG", inline = "d1", group = G_ZON)
showObIn     = input.bool(false, "Draw OB", inline = "d2", group = G_ZON)
showBrkIn    = input.bool(false, "Draw Breaker", inline = "d2", group = G_ZON)
arrSideIn    = input.int(1, "Drawn Per Side", minval = 1, maxval = 5, group = G_ZON)

// ── STRUCTURE
pivAutoIn  = input.bool(true, "Auto Pivot Length (by Mode)", group = G_STR)
sensIn     = input.string("Normal", "Sensitivity", options = ["High", "Normal", "Low"], group = G_STR, tooltip = "Auto lengths — Scalping 2/3/5 · Day 3/5/8 · Swing 5/8/12 (High / Normal / Low).")
pivLenIn   = input.int(5, "Pivot Length (manual)", minval = 1, maxval = 30, group = G_STR)
showStrIn  = input.bool(false, "Draw BOS / CHoCH", group = G_STR)
strMaxIn   = input.int(2, "Max Structure Drawings", minval = 1, maxval = 10, group = G_STR)

// ── LVN
showLvnIn = input.bool(false, "Show LVN Zones", group = G_LVN)
lvnTfIn   = input.timeframe("60", "Source TF", group = G_LVN)
lvnBinsIn = input.int(40, "Bins", minval = 10, maxval = 100, group = G_LVN)
lvnLookIn = input.int(200, "Lookback (source bars)", minval = 20, maxval = 500, group = G_LVN)
lvnThrIn  = input.float(0.35, "LVN Threshold (x mean)", minval = 0.05, maxval = 1.0, step = 0.05, group = G_LVN)
lvnShowIn = input.int(1, "LVNs Per Side", minval = 1, maxval = 5, group = G_LVN)

// ── BIAS TABLE
showTblIn = input.bool(true, "Show Bias Table", group = G_TBL)
tblPosIn  = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G_TBL)
tblSizeIn = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal"], group = G_TBL)

// ── SIGNALS
tradeModeIn = input.string("DOL Direction", "Trade Mode", options = ["DOL Direction", "Sweep Reversal", "Confirmed Signals"], group = G_SIG, tooltip = "DOL Direction: trade straight toward the DOL as soon as it is placed. BUY when the DOL is above, SELL when it is below, target = the DOL, stop beyond the nearest opposite liquidity. One trade per DOL; no Edge Gate wait.\nSweep Reversal: a candle runs a swing low / prior-day low (or high) and closes back inside → BUY (or SELL) at that close, stop just beyond the sweep wick, target = the nearest untaken liquidity on the other side paying at least the Sweep Min Reward : Risk.\nConfirmed Signals: only trade the stricter structure-break signals (fewer trades, Edge Gate applies).\nNo mode is proven profitable: watch the 'This chart' line in the banner.")
swRRIn     = input.float(1.0, "Sweep Reversal: Min Reward : Risk", minval = 0.3, maxval = 10.0, step = 0.1, group = G_SIG, tooltip = "Sweep Reversal mode only. The target is the nearest untaken liquidity on the other side that pays at least this many R.")
sigOnIn    = input.bool(true, "Show Execution Signals", group = G_SIG, tooltip = "Printed only on a CLOSED candle (never repaints or moves): execution-TF break in the HTF direction, with the DOL on the same side. Entry, stop and target are fixed at the signal.")
sigReqSwIn = input.bool(true, "Require Opposite Liquidity Sweep", group = G_SIG)
sigScoreIn = input.int(55, "Min DOL Score", minval = 0, maxval = 100, group = G_SIG)
sigPotIn   = input.float(30.0, "Min PoT %", minval = 0.0, maxval = 95.0, step = 0.5, group = G_SIG)
sigWinIn   = input.int(20, "Sweep Window (bars)", minval = 1, maxval = 100, group = G_SIG, tooltip = "The opposite-side liquidity must have been swept within this many bars before the break. The sweep extreme is also the virtual stop.")
sigCoolIn  = input.int(15, "Cooldown (bars)", minval = 0, maxval = 500, group = G_SIG)

// ── SIGNAL FILTERS (quality gates — applied to execution signals and to the win-rate tracker)
G_FLT      = "◆ SIGNAL FILTERS"
volFiltIn  = input.string("Skip Low", "Volatility Regime Filter", options = ["Off", "Skip Low", "Skip Low + Extreme"], group = G_FLT, tooltip = "ATR percentile over the last 200 bars. Low = dead market (targets rarely reached). Extreme = chaotic spikes (stops get run).")
dispOnIn   = input.bool(true, "Require Displacement on Break", inline = "dp", group = G_FLT)
dispBodyIn = input.float(0.5, "Min Body (ATR)", minval = 0.0, maxval = 5.0, step = 0.05, inline = "dp", group = G_FLT, tooltip = "The breaking candle must close in the signal direction with a body ≥ this × ATR and body ≥ 50 % of its range.")
rvolOnIn   = input.bool(false, "Require Relative Volume", inline = "rv", group = G_FLT)
rvolIn     = input.float(1.2, "Min RVOL", minval = 0.1, maxval = 10.0, step = 0.1, inline = "rv", group = G_FLT)
sigKzIn    = input.bool(false, "Signals Only in London / New York", group = G_FLT, tooltip = "Uses the London and New York windows from the Sessions group.")
sigHtf2In  = input.bool(false, "Also Require Macro-TF Alignment", group = G_FLT)
sigHrsIn   = input.string("Auto", "Signal Hours (New York)", options = ["Auto", "Any Time", "RTH 09:30-16:00", "Core 09:30-11:30 + 13:30-15:45"], group = G_FLT, tooltip = "Auto = Core hours on futures, indices and stocks, Any Time on crypto and forex. Tested on 3.7 years of 1-minute Nasdaq-100 and S&P 500 data: overnight and after-hours signals have tiny stops, so costs ate 6-18% of every trade and lost 3-5x more than signals in the core New York hours.")
ofOnIn     = input.bool(true, "Order Flow Filter (volume delta)", inline = "of", group = G_FLT, tooltip = "BUY only while buyers control the last N minutes, SELL only while sellers do. Approximate volume delta: each 1-minute bar's volume counts as buying when it closes up and selling when it closes down (similar to TradingView's Volume Delta; Pine has no bid / ask feed). 5-minute charts read the 1-minute bars inside each candle. Tested on MNQ / NQ and S&P, 1m and 5m (19 days of 1-minute and 49 days of 5-minute CME data, 42 days of 1-minute index data): with a 10-20 minute window, trades lost about 0.05R less per trade, with about half as many trades. The gain is small and not statistically proven, and the trades still lost money after costs on average. A 30-minute window did worse.")
ofWinIn    = input.int(15, "Window (min)", minval = 1, maxval = 240, inline = "of", group = G_FLT)
maxCostIn  = input.float(3.0, "Max Cost (% of Stop, 0 = off)", minval = 0.0, maxval = 100.0, step = 0.5, group = G_FLT, tooltip = "Skips a signal when the round-trip cost is more than this % of the stop distance. Tested on 1-minute NQ and S&P: signals with cost under 3% of the stop lost about 4x less than the rest. Tight stops on 1-minute charts are where costs do the damage.")

// ── NEWS GUARD (Pine cannot read news feeds — this uses scheduled release windows + automatic spike detection)
G_NEWS     = "◆ NEWS GUARD"
newsOnIn   = input.bool(true, "News Guard", group = G_NEWS, tooltip = "Blocks new signals / virtual trades during scheduled high-impact release windows and after abnormal volatility spikes. Windows are read in the Sessions timezone.")
n1OnIn     = input.bool(true, "Window 1", inline = "n1", group = G_NEWS)
n1In       = input.session("0825-0845", "", inline = "n1", group = G_NEWS, tooltip = "08:30 NY: CPI, NFP, PPI, jobless claims, retail sales, GDP.")
n2OnIn     = input.bool(true, "Window 2", inline = "n2", group = G_NEWS)
n2In       = input.session("0955-1015", "", inline = "n2", group = G_NEWS, tooltip = "10:00 NY: ISM, consumer sentiment, JOLTS, new home sales.")
n3OnIn     = input.bool(false, "Window 3", inline = "n3", group = G_NEWS)
n3In       = input.session("1355-1445", "", inline = "n3", group = G_NEWS, tooltip = "14:00 NY every day. FOMC days are already covered by the Event Calendar below.")
n4OnIn     = input.bool(false, "Window 4", inline = "n4", group = G_NEWS)
n4In       = input.session("0255-0315", "", inline = "n4", group = G_NEWS, tooltip = "Custom window (default 03:00 NY: EU / UK data).")
shockOnIn  = input.bool(true, "Auto-Detect News Spikes", group = G_NEWS, tooltip = "A spike needs BOTH an abnormal range and abnormal volume. (v5 paused on either one, which blocked normal breakout candles and every session open.)")
shockAtrIn = input.float(2.5, "Spike Range (× ATR)", minval = 1.0, maxval = 10.0, step = 0.1, group = G_NEWS)
shockVolIn = input.float(3.0, "Spike Volume (× avg)", minval = 1.0, maxval = 20.0, step = 0.5, group = G_NEWS)
shockBarsIn = input.int(10, "Pause After Spike (bars)", minval = 0, maxval = 200, group = G_NEWS)
calEvIn    = input.bool(true, "Event Calendar", group = G_NEWS, tooltip = "Blackout around dated events. Pre-filled with the official FOMC statement times 2025-2027 (federalreserve.gov). Add any high-impact event (CPI, NFP, ECB, BoE, earnings…): one per line or comma-separated, format YYYY-MM-DD HH:MM in New York time. A date without a time blocks that whole day.")
evTxtIn    = input.text_area("2025-01-29 14:00, 2025-03-19 14:00, 2025-05-07 14:00, 2025-06-18 14:00, 2025-07-30 14:00, 2025-09-17 14:00, 2025-10-29 14:00, 2025-12-10 14:00, 2026-01-28 14:00, 2026-03-18 14:00, 2026-04-29 14:00, 2026-06-17 14:00, 2026-07-29 14:00, 2026-09-16 14:00, 2026-10-28 14:00, 2026-12-09 14:00, 2027-01-27 14:00, 2027-03-17 14:00, 2027-04-28 14:00, 2027-06-09 14:00, 2027-07-28 14:00, 2027-09-15 14:00, 2027-10-27 14:00, 2027-12-08 14:00", "Events (New York time)", group = G_NEWS)
evPreIn    = input.int(15, "Event: Minutes Before", minval = 0, maxval = 1440, inline = "ev", group = G_NEWS)
evPostIn   = input.int(60, "After", minval = 0, maxval = 1440, inline = "ev", group = G_NEWS)
newsBgIn   = input.bool(false, "Shade News Blackouts", group = G_NEWS)

// ── WIN-RATE TRACKER (virtual trades on the execution signals — shown in the table, no strategy needed)
G_TRD      = "◆ WIN-RATE TRACKER"
showWrIn   = input.bool(true, "Show Signal Win Rate", group = G_TRD, tooltip = "Tracks every execution signal as a virtual trade (entry at signal close, stop beyond the swept liquidity, target set by the Target Mode below). One trade at a time. Works even when signal markers are hidden.")
stopLbIn   = input.int(20, "Fallback Stop Lookback (bars)", minval = 2, maxval = 200, group = G_TRD, tooltip = "Used only when no liquidity sweep is recorded inside the sweep window. Normally the stop sits beyond the swept liquidity.")
stopBufIn  = input.float(0.1, "Stop Buffer (ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_TRD, tooltip = "Distance beyond the swept high / low for the virtual stop.")
tgtModeIn  = input.string("Balanced", "Target Mode", options = ["Target Win Rate", "Best Expectancy", "High Win Rate", "Balanced"], group = G_TRD, tooltip = "Best Expectancy: every past signal on this chart is replayed with 10 target sizes (0.05R-3R) after costs; the target that has actually paid the most is used. Target Win Rate: the take-profit is placed where the calibrated odds of hitting it before the stop equal the chosen win rate and self-adjusts until this chart's real win rate matches it (tested on 12 markets: 90% setting → 89.6% real wins). High Win Rate: nearest liquidity paying ≥ 0.5R. Balanced: nearest liquidity paying ≥ Min Reward : Risk. A high win rate uses small targets — profit depends on EDGE and costs, not WIN.")
tgtWrIn    = input.int(90, "Target Win Rate %", minval = 55, maxval = 97, step = 1, group = G_TRD, tooltip = "Tested on 12 markets: target 85 → 84.9% real · 90 → 89.6% real (10 of 12 markets exactly 90%). Starting TP: 80 ≈ 0.22R · 85 ≈ 0.15R · 90 ≈ 0.09R · 95 ≈ 0.04R, then self-adjusted. Enter your real costs below: small targets are very sensitive to spread and commission.")
wrAdaptIn  = input.bool(true, "Self-Adjust Target to Hit Win Rate", group = G_TRD, tooltip = "After every closed virtual trade the target distance is nudged (shorter after a loss, slightly longer after a win) so this chart's real win rate settles at the chosen %. Uses finished trades only — never repaints. Fills follow TradingView's broker emulator: gaps fill at the open, and when stop and target are both inside one bar the side nearer the open is hit first.")
minRRIn    = input.float(0.5, "Min Reward : Risk", minval = 0.1, maxval = 20.0, step = 0.1, group = G_TRD, tooltip = "The virtual target is the nearest liquidity on the signal side that pays at least this multiple of the risk. No such target = no trade.")
maxHoldIn  = input.int(60, "Time Stop (bars, 0 = off)", minval = 0, maxval = 2000, group = G_TRD)
costIn     = input.float(0.0, "Round-Trip Cost (ticks, 0 = auto)", minval = 0.0, maxval = 100000.0, step = 0.5, group = G_TRD, tooltip = "Spread + commission + slippage per round trip, in ticks. 0 = auto: MNQ 4 · NQ 2 · MES 2 · ES 1.5 · other index / metal / energy futures 2 · S&P / Nasdaq CFDs and index charts 0.5 bp of price · crypto 0.08% of price · forex 1.2 pips · others 2 ticks. Enter your own broker's number if you know it. Used by WIN / EDGE, the Edge Gate and the Max Cost filter.")
gateIn     = input.bool(true, "Edge Gate: Only Trade With Proven Profit", group = G_TRD, tooltip = "Every signal on this chart is replayed (never repaints) with 10 target sizes, after your costs. A signal is only taken (marker, alert, virtual trade) when the chosen target size has made money on this chart's past signals, with a safety margin. Charts with no edge simply stop trading instead of losing. A filter, not a guarantee: past edge can fade.")
gateNIn    = input.int(30, "Edge Gate: Min Past Signals", minval = 10, maxval = 1000, group = G_TRD, tooltip = "Signals that must be replayed before the gate can open. Until then no trades are taken (shown as LEARNING).")
gateZIn    = input.float(0.5, "Edge Gate: Safety Margin (σ)", minval = 0.0, maxval = 3.0, step = 0.25, group = G_TRD, tooltip = "The average profit must exceed this many standard errors above zero. Higher = fewer but more reliable trades.")
beAtRIn    = input.float(0.0, "Breakeven at R (0 = off)", minval = 0.0, maxval = 10.0, step = 0.25, group = G_TRD, tooltip = "Moves the virtual stop to entry once price has moved this many R in favour.")

// ── RISK (real-money protection — limits damage, it does not create an edge)
G_RSK      = "◆ RISK (REAL MONEY)"
riskUsdIn  = input.float(100.0, "Risk per Trade ($)", minval = 1.0, maxval = 10000000.0, step = 10.0, group = G_RSK, tooltip = "SIZE row: contracts / shares for the latest taken signal so that stop + costs lose at most this amount. Uses the symbol's point value (MNQ $2, MES $5, NQ $20, ES $50 per point).")
dayGuardIn = input.bool(true, "Daily Loss Limit", inline = "dg", group = G_RSK)
dayLossIn  = input.float(2.0, "Max Loss (R)", minval = 0.5, maxval = 50.0, step = 0.5, inline = "dg", group = G_RSK, tooltip = "Once today's virtual trades have lost this many R, no more signals are taken today (they show as grey crosses). Resets on the new trading day.")
dayMaxIn   = input.int(3, "Max Signals per Day", minval = 1, maxval = 100, group = G_RSK, tooltip = "Stops taking signals for the day after this many. Overtrading on 1-minute charts multiplies costs.")
flatIn     = input.bool(true, "Close Open Trade at 15:55 New York", group = G_RSK, tooltip = "Day-trading rule: a trade still open at 15:55 New York is closed at that bar's close and no new trade is taken after it, so nothing is carried overnight. Applies when Signal Hours are not Any Time (futures, indices, stocks).")

// ── CALIBRATION / ACCURACY
calOnIn   = input.bool(true, "Self-Learning PoT", group = G_CAL, tooltip = "Final PoT = logistic model on [base PoT, volatility regime, momentum toward target, distance]. Starts from weights fitted on 13 markets and keeps learning from this chart's resolved outcomes (closed data only, no repainting). Off = research weights only.")
lrIn      = input.float(0.002, "Learning Rate", minval = 0.0, maxval = 0.05, step = 0.001, group = G_CAL, tooltip = "0.002 tested best out-of-sample. Higher rates chase noise and lowered accuracy in testing.")
empOnIn   = input.bool(true, "Empirical Excursion Model", group = G_CAL, tooltip = "Learns from this market how far price actually travels (up / down, per HTF bias) within the PoT horizon and blends it with the analytic model. Adapts PoT to the fat tails, trend and mean reversion of any market.")
empKIn    = input.int(10, "Empirical Prior (horizons)", minval = 1, maxval = 200, group = G_CAL, tooltip = "Weight of the analytic model, in independent horizons of data. Lower = trust the market's own history sooner.")
seasOnIn  = input.bool(true, "Intraday Volatility Seasonality", group = G_CAL, tooltip = "Intraday charts up to 1H: rescales PoT by the typical volatility of the time-of-day window ahead vs. the recent window (e.g. lower into the lunch / Asia lull, higher into the London and New York opens).")
reachOnIn = input.bool(true, "Show Reach Bands", inline = "rb", group = G_CAL)
reachPIn  = input.int(50, "at PoT %", minval = 10, maxval = 90, step = 5, inline = "rb", group = G_CAL, tooltip = "Dotted levels above / below price with this probability of being touched within the PoT horizon (same calibrated model as PoT).")
firstOnIn = input.bool(true, "Show First-Touch Odds", group = G_CAL, tooltip = "Odds that the nearest target above is touched before the nearest target below. Distance-driven and calibrated in testing; bias, structure and liquidity type added no out-of-sample edge.")
showAccIn = input.bool(true, "Show Measured DOL Hit Rate", group = G_CAL, tooltip = "Share of DOL targets that price actually reached within the PoT horizon after they were selected.")

