float halfLife   = input.float(150.0, "Freshness Half-Life (bars)", minval = 5.0, step = 5.0, group = G_SCORE)
float confATR    = input.float(0.35, "Confluence Tolerance (ATR)", minval = 0.0, step = 0.05, group = G_SCORE)
int   densLen    = input.int(20, "Density Window (bars)", minval = 5, maxval = 100, group = G_SCORE)
