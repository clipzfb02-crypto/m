//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  DOL Engine v2 · Draw on Liquidity
// ───────────────────────────────────────────────────────────────────────────────
//  Pools liquidity targets (chart / STF / HTF swings, PDH-PDL, PWH-PWL, session
//  highs and lows, FVGs incl. HTF FVGs, Order Blocks, Breakers), scores every one
//  out of 100 on confirmed bars and tracks the best one as the active Draw on
//  Liquidity (DOL) zone.
//
//  Score = 100 x mult x weighted blend of five pillars (each 0..1):
//    Proximity  · ATR distance blended with first-passage reachability, tapered
//                 near zero (a zone price is sitting on is being delivered, not
//                 drawn to); 0 beyond Max ATR Distance
//    Freshness  · liquidity matures as stops accumulate, then decays slowly;
//                 imbalances decay with a plain half-life
//    Confluence · overlap with PDH/PDL, PWH/PWL, session opens and equilibria
//    Density    · liquidity magnitude (equal highs/lows, stacked pools, tests,
//                 swing prominence, source tier) + coiling + inducement;
//                 displacement quality for imbalances
//    Draw       · alignment with the order-flow vector D (MTF structure,
//                 displacement, recent liquidity raids)
//  mult folds in origin lockout, inner-pool and counter-draw penalties, partial
//  mitigation, killzone affinity, volume-profile path cost and the adaptive
//  per-family calibration learned by the accuracy ledger.
//
//  Non-repainting: structure, ranking, ledger, iFVG and breaker logic run only on
//  barstate.isconfirmed. Every request.security() reads [1]-offset series with
//  lookahead_on and never requests a timeframe below the chart's. The PoT readout
//  and the intrabar sweep alert are deliberately live (unclosed data).
// ═══════════════════════════════════════════════════════════════════════════════
indicator("DOL Engine v2 · Draw on Liquidity", shorttitle = "DOL Engine v2", overlay = true, max_bars_back = 500,
  max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// Drawings convert bar_index x-coordinates to time internally. Give `time` a
// 5000-bar buffer so far-anchored zones never outrun it on realtime bars; every
// past x-coordinate is additionally clamped by f_x().
max_bars_back(time, 5000)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
const string G_MODE  = "Trading Mode"
const string G_ENG   = "Engine"
const string G_LIQ   = "Liquidity Sources"
const string G_KEY   = "Key Liquidity"
const string G_ARR   = "Imbalances & Blocks"
const string G_SCORE = "Scoring"
const string G_FLOW  = "Order Flow · Draw Direction"
const string G_DOL   = "DOL Display"
const string G_POT   = "Probability of Touch"
const string G_ACC   = "Accuracy Engine"
const string G_IFVG  = "Inversion FVG"
const string G_LVN   = "Volume Profile"
const string G_GHOST = "Ghost Trail"
const string G_TABLE = "Terminal Panel"
const string G_CONF  = "Sessions & Killzones"
const string G_COL   = "Theme"

// ── Trading mode ──────────────────────────────────────────────────────────────
string modeIn  = input.string("Day Trading", "Trading Mode", options = ["Swing", "Day Trading", "Scalping", "Custom"], group = G_MODE,
  tooltip = "HTF / STF / Execution timeframes.\nSwing: W / D / 4H\nDay Trading: D / 4H / 1H\nScalping: 1H / 15m / 5m\nCustom defaults to 4H / 1H / 15m.\nKeep the chart timeframe at or below the Execution TF.")
string cHTF    = input.timeframe("240", "Custom HTF (Structure)", group = G_MODE)
string cSTF    = input.timeframe("60", "Custom STF (Sub-structure)", group = G_MODE)
string cEXE    = input.timeframe("15", "Custom Execution TF", group = G_MODE)
int    biasLen = input.int(3, "MTF Pivot Strength", minval = 1, maxval = 10, group = G_MODE,
  tooltip = "Bars required on each side of a swing on the HTF / STF / Execution timeframes.")

string tfH = switch modeIn
    "Swing"    => "W"
    "Scalping" => "60"
    "Custom"   => cHTF
    => "D"
string tfS = switch modeIn
    "Swing"    => "D"
    "Scalping" => "15"
    "Custom"   => cSTF
    => "240"
string tfE = switch modeIn
    "Swing"    => "240"
    "Scalping" => "5"
    "Custom"   => cEXE
    => "60"

// ── Engine ────────────────────────────────────────────────────────────────────
int calcBars = input.int(5000, "Calculation Depth (bars)", minval = 500, maxval = 20000, step = 500, group = G_ENG,
  tooltip = "Scoring, target selection and the accuracy ledger run on the most recent N bars. Levels are tracked on every bar. Lower = faster load.")
int atrLen   = input.int(14, "ATR Length", minval = 1, group = G_ENG)

// ── Liquidity sources ─────────────────────────────────────────────────────────
int   pivLen    = input.int(5, "Swing Pivot Length", minval = 2, maxval = 30, group = G_LIQ)
bool  useLiq    = input.bool(true, "BSL / SSL · Chart Swings", group = G_LIQ)
bool  useMTFLiq = input.bool(true, "BSL / SSL · HTF + STF Swings", group = G_LIQ)
float zoneATR   = input.float(0.20, "Liquidity Zone Depth (ATR)", minval = 0.0, step = 0.05, group = G_LIQ,
  tooltip = "Depth of the BSL / SSL zone drawn beyond the swing, where resting stops sit.")
float eqTol     = input.float(0.10, "Equal H/L Tolerance (ATR)", minval = 0.0, step = 0.01, group = G_LIQ)
float clusATR   = input.float(0.75, "Stacked-Liquidity Window (ATR)", minval = 0.0, step = 0.05, group = G_LIQ,
  tooltip = "Same-side pools within this distance form a stack: the outermost one is the draw, the inner ones are inducement.")
float testATR   = input.float(0.30, "Test Proximity (ATR)", minval = 0.05, step = 0.05, group = G_LIQ,
  tooltip = "A bar that comes this close to a pool without taking it counts as a test (more resting stops).")
int   anchorMax = input.int(300, "Max Anchor Scan (bars)", minval = 20, maxval = 450, group = G_LIQ,
  tooltip = "How far back the engine scans to anchor a zone on the exact candle that printed it.")

// ── Key liquidity ─────────────────────────────────────────────────────────────
bool   useKeyD = input.bool(true, "PDH / PDL", group = G_KEY)
bool   useKeyW = input.bool(true, "PWH / PWL", group = G_KEY)
bool   useSess = input.bool(true, "Session Highs / Lows (intraday ≤ 1H)", group = G_KEY)
string sessAs  = input.session("2000-0000", "Asia Range", group = G_KEY)
string sessLo  = input.session("0200-0500", "London Range", group = G_KEY)
string sessNA  = input.session("0930-1200", "NY AM Range", group = G_KEY)

// ── Imbalances & blocks ───────────────────────────────────────────────────────
bool   useFVG    = input.bool(true, "Fair Value Gaps", group = G_ARR)
bool   useHTFFVG = input.bool(true, "HTF Fair Value Gaps", group = G_ARR)
float  fvgMin    = input.float(0.15, "Min FVG Size (ATR)", minval = 0.0, step = 0.05, group = G_ARR)
float  fvgQMin   = input.float(0.45, "Min FVG Quality (0-1)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_ARR,
  tooltip = "Displacement quality of the middle candle (body vs ATR, body ratio), gap size and a nearby break of structure.")
bool   useOB     = input.bool(true, "Order Blocks", group = G_ARR)
int    obLook    = input.int(20, "OB Search Window (bars)", minval = 3, maxval = 60, group = G_ARR)
float  obQMin    = input.float(0.40, "Min OB Quality (0-1)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_ARR,
