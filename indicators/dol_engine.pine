bool   useBRK    = input.bool(true, "Breaker Blocks", group = G_ARR,
  tooltip = "Only order blocks whose leg swept prior liquidity can become breakers.")
string delivIn   = input.string("CE 50%", "Imbalance Delivered At", options = ["Touch", "CE 50%", "Full Fill"], group = G_ARR,
  tooltip = "When a non-active FVG / OB counts as delivered. Partially filled zones are cropped and stay live. The active DOL always counts a touch as a sweep.")
float  dispMult  = input.float(1.2, "Displacement Body (x ATR)", minval = 0.3, step = 0.1, group = G_ARR)

// ── Scoring ───────────────────────────────────────────────────────────────────
int   poolMax    = input.int(40, "Pool Size", minval = 10, maxval = 80, group = G_SCORE)
float maxATR     = input.float(10.0, "Max ATR Distance", minval = 1.0, step = 0.5, group = G_SCORE,
