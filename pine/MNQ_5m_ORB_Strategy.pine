//@version=6
// ============================================================================
//  MNQ 5m ORB Strategy  (Strategy Tester version of "MNQ 5m ORB Signals")
//
//  Same rules as the indicator (all times New York):
//    1. Opening range (OR) = high / low of the first 15 minutes after the 09:30 open.
//    2. Long  = first 5m candle between 09:45 and 12:00 that CLOSES above the OR high
//               and closes in the top 20% of its own range.  Short = mirror image.
//               Maximum one trade per day.
//    3. Stop = distance to the opposite side of the OR.  Target = 0.5 x that distance.
//       Anything still open is closed at the 15:50 bar close (fills at 15:55 open).
//
//  Orders fill at the next bar's open (TradingView default).  Costs: $1.00 per contract
//  per side + 1 tick slippage on market/stop fills.  Fixed size: 1 contract.
//  Backtest 2023-2025 (1.5 pts cost per trade): 69.1% win rate, profit factor 1.23.
//  Past results do not guarantee future results.  Not financial advice.
// ============================================================================
strategy("MNQ 5m ORB Strategy", shorttitle = "MNQ ORB Strat", overlay = true,
     initial_capital = 5000, currency = currency.USD,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 1.0,
     slippage = 1, pyramiding = 0, margin_long = 0, margin_short = 0,
     calc_on_every_tick = false, process_orders_on_close = false)

// ───────────────────────────── Inputs ─────────────────────────────
string G_SETUP = "Setup (defaults = backtested settings)"
int   orMinutes  = input.int(15, "Opening range length (minutes)", minval = 5, maxval = 60, step = 5, group = G_SETUP)
float bodyMin    = input.float(0.8, "Breakout candle strength", minval = 0.0, maxval = 1.0, step = 0.05, group = G_SETUP, tooltip = "0.8 = the breakout candle must close in the top 20% of its range (bottom 20% for shorts).")
float tpR        = input.float(0.5, "Take profit (R multiple)", minval = 0.1, maxval = 5.0, step = 0.05, group = G_SETUP, tooltip = "Target distance = R x stop distance. 0.5 = highest win rate tested that was still profitable.")
int   lastEntryH = input.int(12, "Last entry time (NY)", minval = 9, maxval = 15, inline = "le", group = G_SETUP)
int   lastEntryM = input.int(0, "", minval = 0, maxval = 55, step = 5, inline = "le", group = G_SETUP)
int   flatH      = input.int(15, "Flatten time (NY)", minval = 10, maxval = 16, inline = "fl", group = G_SETUP)
int   flatM      = input.int(50, "", minval = 0, maxval = 55, step = 5, inline = "fl", group = G_SETUP)
bool  allowLong  = input.bool(true, "Longs", inline = "dir", group = G_SETUP)
bool  allowShort = input.bool(true, "Shorts", inline = "dir", group = G_SETUP)
float maxRiskPts = input.float(0.0, "Skip trade if risk is above (points, 0 = off)", minval = 0.0, step = 5.0, group = G_SETUP)
bool  enforceMkt = input.bool(true, "Trade only on MNQ / NQ 5-minute charts", group = G_SETUP)
bool  showOR     = input.bool(true, "Show opening range", group = "Display")
color colOR      = input.color(#2962ff, "Range color", group = "Display")

// ───────────────────────────── Session clock (New York) ─────────────────────────────
string TZ         = "America/New_York"
int    nyMin      = hour(time, TZ) * 60 + minute(time, TZ)
int    orStartMin = 9 * 60 + 30
int    orEndMin   = orStartMin + orMinutes
int    entryEnd   = lastEntryH * 60 + lastEntryM
int    flatMin    = flatH * 60 + flatM

bool isNasdaq = syminfo.root == "MNQ" or syminfo.root == "NQ"
bool is5m     = timeframe.in_seconds(timeframe.period) == 300
bool marketOk = not enforceMkt or (isNasdaq and is5m)
bool newDay   = timeframe.change("D")
bool inOR     = nyMin >= orStartMin and nyMin < orEndMin
bool outOfDay = nyMin >= flatMin or nyMin < orStartMin

// ───────────────────────────── Opening range ─────────────────────────────
var float orHi      = na
var float orLo      = na
var bool  doneToday = false

if newDay
    orHi      := na
    orLo      := na
    doneToday := false

if inOR
    orHi := na(orHi) ? high : math.max(orHi, high)
    orLo := na(orLo) ? low : math.min(orLo, low)

// ───────────────────────────── Signal ─────────────────────────────
float barRange  = math.max(high - low, syminfo.mintick)
bool  canSignal = marketOk and not doneToday and strategy.position_size == 0 and not na(orHi) and nyMin >= orEndMin and nyMin <= entryEnd
bool  bullBreak = canSignal and close > orHi and (close - low) / barRange >= bodyMin
bool  bearBreak = canSignal and close < orLo and (high - close) / barRange >= bodyMin
float riskPts   = bullBreak ? close - orLo : bearBreak ? orHi - close : na
bool  riskOk    = maxRiskPts <= 0 or riskPts <= maxRiskPts
bool  goLong    = bullBreak and allowLong and riskOk
bool  goShort   = bearBreak and allowShort and riskOk

if bullBreak or bearBreak
    doneToday := true   // only the first qualifying breakout of the day counts

// ───────────────────────────── Orders ─────────────────────────────
// Stop / target are set in ticks from the actual fill price.
if goLong or goShort
    int slTicks = math.max(1, math.round(riskPts / syminfo.mintick))
    int tpTicks = math.max(1, math.floor(riskPts * tpR / syminfo.mintick + 1e-6))   // round target DOWN to a whole tick
    if goLong
        strategy.entry("ORB Long", strategy.long)
        strategy.exit("ORB Long Exit", from_entry = "ORB Long", loss = slTicks, profit = tpTicks, comment_loss = "SL", comment_profit = "TP")
    else
        strategy.entry("ORB Short", strategy.short)
        strategy.exit("ORB Short Exit", from_entry = "ORB Short", loss = slTicks, profit = tpTicks, comment_loss = "SL", comment_profit = "TP")

if strategy.position_size != 0 and outOfDay
    strategy.close_all(comment = "EOD")

// ───────────────────────────── Plots ─────────────────────────────
bool orVisible = showOR and nyMin >= orEndMin and nyMin <= flatMin
pOrHi = plot(orVisible ? orHi : na, "OR high", color = colOR, linewidth = 1, style = plot.style_linebr)
pOrLo = plot(orVisible ? orLo : na, "OR low", color = colOR, linewidth = 1, style = plot.style_linebr)
fill(pOrHi, pOrLo, color = color.new(colOR, 92), title = "OR fill")
bgcolor(showOR and inOR ? color.new(colOR, 90) : na, title = "OR window")
plotshape(goLong, title = "Long signal", style = shape.triangleup, location = location.belowbar, color = #089981, size = size.small)
plotshape(goShort, title = "Short signal", style = shape.triangledown, location = location.abovebar, color = #f23645, size = size.small)
