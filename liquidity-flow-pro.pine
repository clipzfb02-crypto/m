// ─── Colors
color bslCol   = input.color(#26a69a, "Buy-Side Liquidity (above)", group = G_COL)
color sslCol   = input.color(#ef5350, "Sell-Side Liquidity (below)", group = G_COL)
color neuCol   = input.color(#9598a1, "Neutral", group = G_COL)
