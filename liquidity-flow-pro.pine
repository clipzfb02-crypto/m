// ─── Signals
bool  enableSig = input.bool(false, "Enable Signals", group = G_SIG,
     tooltip = "Optional confirmed setups: sweep of one side + structure shift + flow agreement. Off by default - the core product is the liquidity map.")
float sigThr    = input.float(55.0, "Signal Threshold (%)", minval = 50.0, maxval = 90.0, step = 1.0, group = G_SIG)
bool  reqSweep  = input.bool(true, "Require Sweep", group = G_SIG)
bool  reqStruct = input.bool(true, "Require Structure Shift", group = G_SIG)
