int   topN         = input.int(3, "Show Top N Targets", minval = 1, maxval = 10, group = G_VIS)
bool  showTierIn   = input.bool(false, "Show Liquidity Strength Labels", group = G_VIS)
float zoneThick    = input.float(0.25, "Zone Thickness (ATR)", minval = 0.05, maxval = 1.0, step = 0.05, group = G_VIS)
bool  showFlipIn   = input.bool(true, "Show Liquidity Flip Markers", group = G_VIS)
bool  showShiftIn  = input.bool(false, "Show Liquidity Shift Markers", group = G_VIS)
float shiftThr     = input.float(10.0, "Shift Threshold (pct points)", minval = 2.0, maxval = 50.0, step = 1.0, group = G_VIS)
int   shiftLook    = input.int(5, "Shift Lookback (bars)", minval = 1, maxval = 50, group = G_VIS)

// Effective visibility: Video style shows only the two zones unless extras are enabled
bool proVis       = not videoMode or vidExtras
bool showDash     = showDashIn and proVis
bool showZones    = showZonesIn and proVis
bool showLines    = showLinesIn and proVis
bool showEqTags   = showEqIn and proVis
bool showSessTags = showSessIn and proVis
bool showSweepMk  = showSweepIn and proVis
bool showTgtChart = showTgtIn and proVis
bool showTierLbl  = showTierIn and proVis
bool showFlipMk   = showFlipIn and proVis
bool showShiftMk  = showShiftIn and proVis

// ─── Colors
color bslCol   = input.color(#26a69a, "Buy-Side Liquidity (above)", group = G_COL)
color sslCol   = input.color(#ef5350, "Sell-Side Liquidity (below)", group = G_COL)
color neuCol   = input.color(#9598a1, "Neutral", group = G_COL)
color sweptCol = input.color(#787b86, "Swept / Historical", group = G_COL)
