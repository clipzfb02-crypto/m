//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  Liquidity Flow Pro [Non-Repaint]
// ────────────────────────────────────────────────────────────────────────────
//  WHAT THIS IS
//  An ESTIMATED liquidity-concentration model built only from data a chart can
//  observe: OHLC, volume (when available), confirmed swing highs/lows, equal
//  highs/lows, repeated tests, previous day/week/month highs/lows, higher-
//  timeframe swings, market structure and sweep state. It does NOT read any
//  exchange order book.
//
//  WHAT THE PERCENTAGE MEANS
//  BUY-SIDE %  = share of the currently scored ACTIVE liquidity resting ABOVE price
//  SELL-SIDE % = share of the currently scored ACTIVE liquidity resting BELOW price
//  "92% SELL-SIDE" means the model estimates that 92% of the active liquidity
//  it scores sits below price. It is NOT a 92% chance that price falls. A side
//  holding more liquidity is a likely draw / target, never a guaranteed move.
//
//  ARCHITECTURE (structural steps commit once per CONFIRMED bar)
//   1. Confirmed swings (ta.pivothigh / ta.pivotlow) -> candidate pools;
//      swings that also hold over a wider window are flagged EXTERNAL
//   2. Pool store (array<Pool>) -> equal-level clustering inside an ATR tolerance
//   3. HTF swings, previous D/W/M and Asia/London/NY highs/lows -> merged / added
//   4. Sweep engine -> swept pools leave the active set, accepted breaks are
//      removed, approaches that hold count as tests (persistence)
//   5. Market structure (HH/HL/LH/LL, BOS) -> protected swings become structural
//   6. Scoring (every tick): intrinsic strength x freshness x ATR-distance decay,
//      summed per side, then bounded secondary tilts (structure / pressure /
//      premium-discount), smoothed and normalised with a stability prior.
//  Only step 6 runs on the developing bar. Everything that marks the chart
//  historically (pools, sweeps, flips, signals, alerts) commits on bar close.
// ════════════════════════════════════════════════════════════════════════════
indicator("Liquidity Flow Pro [Non-Repaint]", shorttitle = "LiqFlow Pro", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ════════════════════════════════════════════════════════════════════════════
const string G_STY  = "Style"
const string G_DET  = "Liquidity Detection"
const string G_CALC = "Liquidity Calculation"
const string G_MODE = "Flow Model"
const string G_HTF  = "Higher Timeframe"
const string G_SES  = "Sessions"
const string G_SWP  = "Sweeps"
const string G_DASH = "Dashboard"
const string G_VIS  = "Visuals"
const string G_COL  = "Colors"
const string G_SIG  = "Signals"
const string G_ALR  = "Alerts"
const string G_DBG  = "Debug"

// ─── Style
string styleMode  = input.string("Video", "Display Style", options = ["Video", "Pro"], group = G_STY,
     tooltip = "Video: the chart is split at price into two zones - red above (Sellers), green below (Buyers) - each labelled with its share of the estimated liquidity.\nPro: dashboard plus every liquidity pool, sweep and target drawn on the chart.")
bool   vidExtras  = input.bool(false, "Video: also show dashboard & levels", group = G_STY)
int    zoneLen    = input.int(50, "Video: Zone Lookback (bars)", minval = 10, maxval = 500, group = G_STY,
     tooltip = "The upper zone runs from price up to the highest high of this many bars, the lower zone from price down to the lowest low.")
string zoneNames  = input.string("Sellers / Buyers", "Video: Zone Labels", options = ["Sellers / Buyers", "Buy-side / Sell-side", "Above / Below"], group = G_STY)
color  upZoneCol  = input.color(#f23645, "Video: Upper Zone", group = G_STY, inline = "vz")
color  dnZoneCol  = input.color(#4caf50, "Lower Zone", group = G_STY, inline = "vz")
int    zoneTransp = input.int(82, "Video: Zone Transparency", minval = 0, maxval = 100, group = G_STY)
bool   videoMode  = styleMode == "Video"

// ─── Liquidity Detection
int   swingLen   = input.int(5, "Swing Length", minval = 2, maxval = 20, group = G_DET,
     tooltip = "Bars on each side needed to confirm a swing high/low. A swing is registered only after confirmation and never moves afterwards.")
float eqTolATR   = input.float(0.15, "Equal High/Low Tolerance (ATR)", minval = 0.05, maxval = 0.50, step = 0.01, group = G_DET,
     tooltip = "Swings within this ATR distance of an existing pool are clustered into one equal-high / equal-low pool.")
int   maxPools   = input.int(30, "Max Liquidity Pools", minval = 10, maxval = 100, group = G_DET)
float minPoolStr = input.float(1.0, "Minimum Pool Strength", minval = 0.0, maxval = 6.0, step = 0.25, group = G_DET,
     tooltip = "Pools with a lower intrinsic strength are ignored by the score and hidden. 1.0 = a plain confirmed swing.")
float maxDistATR = input.float(50.0, "Max Pool Distance (ATR)", minval = 5.0, maxval = 200.0, step = 1.0, group = G_DET,
     tooltip = "Pools farther than this from price are not scored.")
int   memoryBars = input.int(200, "Liquidity Memory (bars)", minval = 20, maxval = 2000, group = G_DET,
     tooltip = "Freshness decay scale. Untouched pools fade toward (never below) 50% of their strength, so persistent liquidity is never erased by age alone.")
int   atrLen     = input.int(14, "ATR Length", minval = 1, maxval = 100, group = G_DET)
bool  useExt     = input.bool(true, "Detect External (Major) Swings", group = G_DET, inline = "ext",
     tooltip = "A swing that is also a pivot over Swing Length × Multiplier bars is external-range liquidity and earns a structural bonus (tag EXT).")
int   extMult    = input.int(3, "×", minval = 2, maxval = 6, group = G_DET, inline = "ext")
bool  autoScale  = input.bool(true, "Auto-Scale Lengths To Swing Length", group = G_DET,
     tooltip = "Liquidity Memory and Dealing Range Length are defined for Swing Length 5 and scale proportionally, so the model keeps the same behaviour when you change swing granularity on any timeframe.")

// ─── Liquidity Calculation
float distWeight   = input.float(1.0, "Distance Weight", minval = 0.0, maxval = 5.0, step = 0.1, group = G_CALC,
     tooltip = "Decay of relevance with ATR distance. At 1.0 a pool 4 ATR away carries half the weight of one at price. 0 = distance ignored.")
float eqWeight     = input.float(1.5, "Equal Level Weight", minval = 0.0, maxval = 3.0, step = 0.1, group = G_CALC,
     tooltip = "Cluster multiplier per extra equal swing. At 1.5 each extra touch adds 1.25x: 1 touch 1.0x, 2 = 2.25x, 3 = 3.5x, 4+ = 4.75x (capped). A cluster therefore never scores less than the same swings left separate, plus a concentration premium. 0.75 gives a flatter 1.0 / 1.6 / 2.3 / 2.9 curve.")
float volWeight    = input.float(1.0, "Volume Weight", minval = 0.0, maxval = 2.0, step = 0.1, group = G_CALC,
     tooltip = "Secondary bonus (max +1.0 at weight 1) for pools formed on above-average volume. Relative volume is clamped at 3x. Ignored automatically when the symbol has no usable volume.")
float structWeight = input.float(1.0, "Structure Weight", minval = 0.0, maxval = 2.0, step = 0.1, group = G_CALC,
     tooltip = "Bonus for protected / range-extreme swings, and size of the bounded structure tilt (25% at 1.0).")
float htfWeight    = input.float(1.0, "HTF Weight", minval = 0.0, maxval = 2.0, step = 0.1, group = G_CALC)
float sessWeight   = input.float(1.0, "Session Level Weight", minval = 0.0, maxval = 2.0, step = 0.1, group = G_CALC,
     tooltip = "Bonus for previous day (+0.25), week (+0.50) and month (+0.75) highs/lows at weight 1.")
int   smoothLen    = input.int(3, "Smoothing", minval = 1, maxval = 10, group = G_CALC,
     tooltip = "EMA length applied to the side scores. 1 = no smoothing.")
float stability    = input.float(0.5, "Percentage Stability", minval = 0.0, maxval = 3.0, step = 0.1, group = G_CALC,
     tooltip = "Neutral liquidity added to both sides before normalising, so tiny absolute differences cannot print 99/1. Overwhelmingly one-sided liquidity can still reach extreme readings.")
float balanceThr   = input.float(8.0, "Balanced Threshold (pct points)", minval = 0.0, maxval = 30.0, step = 1.0, group = G_CALC,
     tooltip = "If BUY% and SELL% differ by less than this, the flow is BALANCED and no target side is shown.")
bool  freezeLive   = input.bool(false, "Freeze Current-Bar Calculation", group = G_CALC,
     tooltip = "Hold the last confirmed bar's reading on the dashboard instead of updating tick by tick.")

// ─── Flow Model
string flowMode    = input.string("Liquidity + Structure", "Flow Model Mode",
     options = ["Liquidity Only", "Liquidity + Pressure", "Liquidity + Structure", "Balanced"], group = G_MODE,
     tooltip = "Liquidity Only: pure pool map.\nLiquidity + Pressure: bounded tilt from candle/volume pressure.\nLiquidity + Structure: bounded tilt toward the side the current structure is drawing to.\nBalanced: both tilts at half size.\nTilts multiply side relevance by at most 1.25x each, so they can never override the pool map.")
float pressWeight  = input.float(1.0, "Pressure Weight", minval = 0.0, maxval = 2.0, step = 0.1, group = G_MODE)
int   pressLen     = input.int(10, "Pressure Length", minval = 2, maxval = 50, group = G_MODE)
bool  usePD        = input.bool(false, "Premium / Discount Awareness", group = G_MODE,
     tooltip = "Secondary only. Premium slightly raises sell-side relevance, discount slightly raises buy-side relevance.")
int   rangeLen     = input.int(100, "Dealing Range Length (bars)", minval = 20, maxval = 1000, group = G_MODE,
     tooltip = "Range used for premium/discount and for flagging range-extreme swings as structural.")
float pdWeight     = input.float(0.5, "Premium / Discount Weight", minval = 0.0, maxval = 1.0, step = 0.05, group = G_MODE)

// ─── Higher Timeframe
bool   useHTF    = input.bool(true, "Enable HTF Liquidity", group = G_HTF)
string htfChoice = input.string("Auto", "Higher Timeframe", options = ["Auto", "15m", "30m", "1H", "4H", "1D"], group = G_HTF,
     tooltip = "Auto: 1m→15m, ≤5m→1H, ≤1H→4H, ≤4H→1D, 1D→1W, higher→1M. Ignored when not higher than the chart.")
int    htfLen    = input.int(3, "HTF Swing Length", minval = 2, maxval = 10, group = G_HTF)

// ─── Sessions
bool usePDL = input.bool(true, "Previous Day High/Low", group = G_SES)
bool usePWL = input.bool(true, "Previous Week High/Low", group = G_SES)
bool usePML = input.bool(false, "Previous Month High/Low", group = G_SES)
bool useCSL = input.bool(false, "Current Session High/Low", group = G_SES)
bool   useKZ   = input.bool(false, "Asia / London / New York Highs & Lows", group = G_SES,
     tooltip = "Intraday charts (1H and below). When a session closes, its high and low become liquidity pools (ASIA H/L, LDN H/L, NY H/L).")
string asiaSes = input.session("1800-0300", "Asia Session", group = G_SES)
string ldnSes  = input.session("0300-0830", "London Session", group = G_SES)
string nySes   = input.session("0830-1600", "New York Session", group = G_SES)
string sesTz   = input.string("America/New_York", "Session Timezone", group = G_SES)

// ─── Sweeps
bool   enableSweeps = input.bool(true, "Enable Sweep Detection", group = G_SWP)
string sweepMode    = input.string("Balanced", "Sweep Confirmation (close-based)", options = ["Strict", "Balanced", "Aggressive"], group = G_SWP,
     tooltip = "Every mode needs a CONFIRMED close back inside the level.\nAggressive: any trade beyond the level.\nBalanced: penetration beyond the equal-level tolerance (anything inside it is an equal-level test).\nStrict: Balanced AND the candle closes in its rejecting half.\nSmaller penetrations that close back inside count as tests that strengthen the level.")
bool   keepSwept    = input.bool(true, "Keep Swept Levels (faded)", group = G_SWP)
bool   removeSwept  = input.bool(true, "Remove Swept Levels From Active Score", group = G_SWP,
     tooltip = "On: swept pools contribute nothing. Off: swept pools keep 50% of their weight (partially consumed liquidity).")
int    maxSweeps    = input.int(20, "Max Historical Sweeps", minval = 0, maxval = 50, group = G_SWP)

// ─── Dashboard
bool   showDashIn    = input.bool(true, "Show Dashboard", group = G_DASH)
string dashPos       = input.string("Top Right", "Position",
     options = ["Top Right", "Top Center", "Top Left", "Middle Right", "Middle Left", "Bottom Right", "Bottom Center", "Bottom Left"], group = G_DASH)
string dashSize      = input.string("Small", "Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_DASH)
bool   showPct       = input.bool(true, "Show Percentages", group = G_DASH)
bool   showBar       = input.bool(true, "Show Flow Bars", group = G_DASH)
bool   showTgtRow    = input.bool(true, "Show Target", group = G_DASH)
bool   showStrRow    = input.bool(true, "Show Strength", group = G_DASH)
