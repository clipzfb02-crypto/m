bool debugMode = input.bool(false, "Debug Mode", group = G_DBG,
     tooltip = "Adds factor diagnostics to the dashboard and raw scores to the Data Window.")

// ════════════════════════════════════════════════════════════════════════════
//  TYPES & PERSISTENT STATE
// ════════════════════════════════════════════════════════════════════════════
// Pool origin classes
const int SRC_SWING = 0
const int SRC_HTF   = 1
const int SRC_PD    = 2
const int SRC_PW    = 3
const int SRC_PM    = 4

// One estimated liquidity pool. Buy-side pools are highs (resting liquidity
// ABOVE price); sell-side pools are lows (resting liquidity BELOW price).
// Keeping every attribute on one object keeps price / strength / state / drawings
// synchronised: removing the object removes all of its data at once.
type Pool
    int   id
    float price                 // active level = cluster extreme (max of highs / min of lows)
    float hi                    // highest member of the cluster
    float lo                    // lowest member of the cluster
    int   t                     // origin time (drawing anchor)
    int   b                     // origin bar index
    bool  isBuy                 // true = buy-side (above), false = sell-side (below)
    int   src                   // SRC_* origin class
    int   members    = 1        // confirmed swing points clustered here (equal levels)
    int   tests      = 0        // rejected re-tests of the level (persistence)
    int   lastTest              // bar index of the last counted test
    int   fresh                 // bar index of the last reinforcement (age reference)
    float relVol     = 1.0      // max relative volume around its members
    float th                    // zone thickness in price units (fixed at creation)
    bool  htf        = false    // confirmed by a higher-timeframe swing
    bool  structural = false    // protected swing / dealing-range extreme
    bool  announced  = false    // major-pool alert already raised
    bool  alive      = true     // false once swept, taken or pruned
    int   sweptB                // bar index of the confirmed sweep
    float w          = 0.0      // last weighted score (0 = not scored)
    float dAtr       = 0.0      // last ATR distance from reference price
    box   bx
    line  ln
    label lb

// Running high/low of a calendar period (day / week / month).
type Period
    float hi
    float lo
    int   hiT
    int   loT
    int   hiB
    int   loB
    int   count = 0

var array<Pool> pools      = array.new<Pool>()   // ACTIVE liquidity pools
var array<Pool> sweptPools = array.new<Pool>()   // swept pools kept as history
var array<int>  idSeq      = array.from(0)       // unique pool id counter
var Period      dayP       = Period.new()
var Period      weekP      = Period.new()
var Period      monthP     = Period.new()

// ════════════════════════════════════════════════════════════════════════════
//  CORE SERIES (computed on every bar)
// ════════════════════════════════════════════════════════════════════════════
float atrRaw   = ta.atr(atrLen)
float atrSafe  = math.max(nz(atrRaw, high - low), syminfo.mintick)   // never 0 / na
float vol      = nz(volume)
float volAvg   = nz(ta.sma(vol, 20))
float volShare = nz(math.sum(vol > 0 ? 1.0 : 0.0, 50)) / 50.0
bool  volOK    = volShare >= 0.8 and volAvg > 0                     // usable volume feed?
float rv       = volAvg > 0 ? vol / volAvg : 1.0
float rvPivot  = volOK ? (nz(rv[swingLen - 1], 1.0) + nz(rv[swingLen], 1.0) + nz(rv[swingLen + 1], 1.0)) / 3.0 : 1.0

// ════════════════════════════════════════════════════════════════════════════
//  HELPER FUNCTIONS
// ════════════════════════════════════════════════════════════════════════════
f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

// Freshness: 1.0 when just formed / reinforced, decays toward a 0.5 floor so
// persistent liquidity keeps relevance.
f_timeFactor(int ageBars) =>
    0.5 + 0.5 * math.exp(-math.max(ageBars, 0) / float(memoryBars))

// Smooth ATR-distance decay: 1 / (1 + 0.25 * weight * distanceATR).
f_distW(float dAtr) =>
    1.0 / (1.0 + 0.25 * distWeight * dAtr)

// Intrinsic strength components (before distance / age / directional weighting).
// strength = base * cluster + tests + volume + structure + HTF
f_components(Pool p) =>
    float sessB = switch p.src
        SRC_PD => 0.25
        SRC_PW => 0.50
        SRC_PM => 0.75
        => 0.0
    float base    = 1.0 + sessWeight * sessB
    float cluster = 1.0 + eqWeight / 3.0 * math.min(p.members - 1, 3)
    float testB   = math.min(p.tests * 0.3, 1.5)
    float volB    = volOK ? volWeight * f_clamp((math.min(p.relVol, 3.0) - 1.0) / 2.0, 0.0, 1.0) : 0.0
    float structB = p.structural ? structWeight : 0.0
    float htfB    = p.htf ? htfWeight : 0.0
    [base, cluster, testB, volB, structB, htfB]

f_intrinsic(Pool p) =>
    [base, cluster, testB, volB, structB, htfB] = f_components(p)
    base * cluster + testB + volB + structB + htfB

// 0 = Minor, 1 = Moderate, 2 = Major, 3 = Extreme
f_tier(float s) =>
    s >= 4.0 ? 3 : s >= 2.75 ? 2 : s >= 1.75 ? 1 : 0

f_tierName(int t) =>
    t == 3 ? "EXTREME" : t == 2 ? "MAJOR" : t == 1 ? "MODERATE" : "MINOR"

f_strengthName(float v) =>
    v >= 80 ? "VERY STRONG" : v >= 60 ? "STRONG" : v >= 40 ? "MODERATE" : v >= 20 ? "WEAK" : "VERY WEAK"

f_tag(Pool p) =>
    string s = switch p.src
        SRC_PD => p.isBuy ? "PDH" : "PDL"
        SRC_PW => p.isBuy ? "PWH" : "PWL"
        SRC_PM => p.isBuy ? "PMH" : "PML"
        => p.members >= 2 ? (p.isBuy ? "EQH" : "EQL") : (p.isBuy ? "BSL" : "SSL")
    if p.members >= 2
        s += " ×" + str.tostring(p.members)
    if p.htf
        s += " · HTF"
    if p.structural
        s += " · STRUCT"
    s

f_pos(string s) =>
    switch s
        "Top Right"     => position.top_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Bottom Right"  => position.bottom_right
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        => position.top_right

f_size(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

f_share(float part, float tot) =>
    tot > 0 ? str.tostring(part / tot * 100.0, "#0") + "%" : "—"

// ─── Drawing management (every object belongs to exactly one Pool)
f_zoneBounds(Pool p) =>
    float top = p.isBuy ? p.price : math.max(p.hi, p.price + p.th)
    float bot = p.isBuy ? math.min(p.lo, p.price - p.th) : p.price
    [top, bot]

f_newDrawings(Pool p) =>
    color c = p.isBuy ? bslCol : sslCol
    [top, bot] = f_zoneBounds(p)
    if showZones
        p.bx := box.new(p.t, top, time, bot, xloc = xloc.bar_time, extend = extend.right,
             border_color = color.new(c, 82), border_width = 1, bgcolor = color.new(c, 90))
    if showLines
        p.ln := line.new(p.t, p.price, time, p.price, xloc = xloc.bar_time, extend = extend.right,
             color = color.new(c, 45), style = line.style_dotted, width = 1)

f_syncDrawings(Pool p) =>
    [top, bot] = f_zoneBounds(p)
    if not na(p.bx)
        box.set_top(p.bx, top)
        box.set_bottom(p.bx, bot)
    if not na(p.ln)
        line.set_y1(p.ln, p.price)
        line.set_y2(p.ln, p.price)

f_deleteDrawings(Pool p) =>
    if not na(p.bx)
        box.delete(p.bx)
        p.bx := na
    if not na(p.ln)
        line.delete(p.ln)
        p.ln := na
    if not na(p.lb)
        label.delete(p.lb)
        p.lb := na

// Swept pool: stop its zone/line at the sweep bar and fade it (or delete it).
f_fadeSwept(Pool p) =>
    if not na(p.lb)
        label.delete(p.lb)
        p.lb := na
    if keepSwept
        if not na(p.bx)
            box.set_extend(p.bx, extend.none)
            box.set_right(p.bx, time)
            box.set_bgcolor(p.bx, color.new(sweptCol, 93))
            box.set_border_color(p.bx, color.new(sweptCol, 85))
        if not na(p.ln)
            line.set_extend(p.ln, extend.none)
            line.set_x2(p.ln, time)
            line.set_color(p.ln, color.new(sweptCol, 55))
            line.set_style(p.ln, line.style_dotted)
            line.set_width(p.ln, 1)
    else
        f_deleteDrawings(p)

// ─── Pool store
// Adds a confirmed liquidity level. If it lies within the equal-level tolerance
// of an active same-side pool, it is clustered into that pool (equal highs/lows);
// otherwise a new pool is created. Returns the pool that holds the level.
f_addLevel(float price, int originB, int originT, bool isBuy, int src, float relVol, float tol, float thick) =>
    int   best  = -1
    float bestD = 1e100
    int   n     = array.size(pools)
    if n > 0
        for i = 0 to n - 1
            Pool q = array.get(pools, i)
            if q.isBuy == isBuy
                float d    = price > q.hi ? price - q.hi : price < q.lo ? q.lo - price : 0.0
                float span = math.max(q.hi, price) - math.min(q.lo, price)
                if d <= tol and span <= 2.0 * tol and d < bestD
                    bestD := d
                    best  := i
    Pool p = na
    if best >= 0
        p := array.get(pools, best)
        // HTF / session levels that sit exactly on an existing member describe the
        // same swing: they upgrade the pool but are not an extra equal touch.
        bool samePoint = math.abs(price - p.hi) <= syminfo.mintick * 0.5 or math.abs(price - p.lo) <= syminfo.mintick * 0.5
        if src == SRC_SWING or not samePoint
            p.members := p.members + 1
            // the pivot candle itself was already counted as a test -> do not double count
            if p.tests > 0 and not na(p.lastTest) and p.lastTest == originB
                p.tests := p.tests - 1
        p.hi     := math.max(p.hi, price)
        p.lo     := math.min(p.lo, price)
        p.price  := isBuy ? p.hi : p.lo
        p.relVol := math.max(p.relVol, relVol)
        p.fresh  := bar_index
        if src == SRC_HTF
            p.htf := true
        if src >= SRC_PD
            p.src := math.max(p.src, src)
        f_syncDrawings(p)
    else
        int nid = array.get(idSeq, 0) + 1
        array.set(idSeq, 0, nid)
        p := Pool.new(id = nid, price = price, hi = price, lo = price, t = originT, b = originB, isBuy = isBuy,
             src = src, relVol = relVol, fresh = bar_index, th = thick, htf = src == SRC_HTF)
        f_newDrawings(p)
        array.push(pools, p)
    p

// Returns true the first time a pool reaches MAJOR tier or higher.
f_announce(Pool p) =>
    bool fire = false
    if not na(p)
        if p.alive and not p.announced and f_tier(f_intrinsic(p)) >= 2
            p.announced := true
            fire := true
    fire

// Keeps the active store bounded by pruning the least relevant pool.
f_enforceCap(int cap) =>
    while array.size(pools) > cap
        int   worst  = 0
        float worstS = 1e100
        for i = 0 to array.size(pools) - 1
            Pool q = array.get(pools, i)
            float s = f_intrinsic(q) * f_timeFactor(bar_index - q.fresh) * f_distW(math.abs(q.price - close) / atrSafe)
            if s < worstS
                worstS := s
                worst  := i
        Pool gone = array.remove(pools, worst)
        gone.alive := false
        f_deleteDrawings(gone)
    array.size(pools)

// Run-period high/low tracker. Returns the COMPLETED period's values on the
// first bar of a new period (na otherwise). The first, partial period on the
// chart is discarded so a level is never reported from incomplete data.
f_period(Period s, bool isNew) =>
    float oHi  = na
    float oLo  = na
    int   oHiT = na
    int   oLoT = na
    int   oHiB = na
    int   oLoB = na
    if isNew
        if s.count > 0
            oHi  := s.hi
            oLo  := s.lo
            oHiT := s.hiT
            oLoT := s.loT
            oHiB := s.hiB
            oLoB := s.loB
        s.count := s.count + 1
        s.hi    := high
        s.lo    := low
        s.hiT   := time
        s.loT   := time
        s.hiB   := bar_index
        s.loB   := bar_index
    else
        if na(s.hi) or high > s.hi
            s.hi  := high
            s.hiT := time
            s.hiB := bar_index
        if na(s.lo) or low < s.lo
            s.lo  := low
            s.loT := time
            s.loB := bar_index
    [oHi, oLo, oHiT, oLoT, oHiB, oLoB]

// HTF swings evaluated INSIDE the HTF context. The [1] offset combined with
// lookahead_on returns only the last COMPLETED HTF bar: no future leakage.
f_htfSwings(int n) =>
    float hph = ta.pivothigh(high, n, n)
    float hpl = ta.pivotlow(low, n, n)
    int   hpt = time[n]
    [hph[1], hpl[1], hpt[1]]

// ════════════════════════════════════════════════════════════════════════════
//  DATA COLLECTION (confirmed swings, HTF swings, session levels)
// ════════════════════════════════════════════════════════════════════════════
bool  commit   = barstate.isconfirmed            // historical bars and the closing tick of a live bar
float ph       = ta.pivothigh(high, swingLen, swingLen)
float pl       = ta.pivotlow(low, swingLen, swingLen)
int   pivT     = time[swingLen]
float rangeHi  = nz(ta.highest(high, rangeLen), high)
float rangeLo  = nz(ta.lowest(low, rangeLen), low)
float tolNow   = eqTolATR * atrSafe
float thickNow = zoneThick * atrSafe

// ─── Higher timeframe (non-repainting)
int    chartSec = timeframe.in_seconds(timeframe.period)
string htfAuto  = chartSec <= 60 ? "15" : chartSec <= 300 ? "60" : chartSec <= 3600 ? "240" : chartSec <= 14400 ? "D" : chartSec <= 86400 ? "W" : "M"
string htfTF    = switch htfChoice
    "15m" => "15"
    "30m" => "30"
    "1H"  => "60"
    "4H"  => "240"
    "1D"  => "D"
    => htfAuto
bool   htfValid = useHTF and timeframe.in_seconds(htfTF) > chartSec
string htfReq   = htfValid ? htfTF : timeframe.period
[htfPH, htfPL, htfPT] = request.security(syminfo.tickerid, htfReq, f_htfSwings(htfLen), lookahead = barmerge.lookahead_on)

// ─── Session levels (tracked from chart bars - only completed periods are used)
bool  newDay    = timeframe.change("D") and bar_index > 0
bool  newWeek   = timeframe.change("W") and bar_index > 0
bool  newMonth  = timeframe.change("M") and bar_index > 0
// current-session extremes as of the PREVIOUS bar (resting liquidity, not the developing candle)
float csHiPrev  = newDay ? na : dayP.hi
float csLoPrev  = newDay ? na : dayP.lo
int   csHiTPrev = newDay ? na : dayP.hiT
int   csLoTPrev = newDay ? na : dayP.loT
[pdHi, pdLo, pdHiT, pdLoT, pdHiB, pdLoB] = f_period(dayP, newDay)
[pwHi, pwLo, pwHiT, pwLoT, pwHiB, pwLoB] = f_period(weekP, newWeek)
[pmHi, pmLo, pmHiT, pmLoT, pmHiB, pmLoB] = f_period(monthP, newMonth)
bool  pdAllowed = chartSec < timeframe.in_seconds("D")
bool  pwAllowed = chartSec < timeframe.in_seconds("W")
bool  pmAllowed = chartSec < timeframe.in_seconds("M")

// ════════════════════════════════════════════════════════════════════════════
//  LIQUIDITY ENGINE (commits on confirmed bars only -> never repaints)
// ════════════════════════════════════════════════════════════════════════════
var float lastSH         = na
var float lastSL         = na
var bool  shBroken       = true
var bool  slBroken       = true
var int   hiType         = 0          // 1 = HH, -1 = LH
var int   loType         = 0          // 1 = HL, -1 = LL
var int   structDir      = 0          // 1 = bullish, -1 = bearish (last BOS)
var int   lastBullShiftB = na
var int   lastBearShiftB = na
var Pool  lastSHPool     = na
var Pool  lastSLPool     = na
var int   lastHtfHiT     = na
var int   lastHtfLoT     = na

bool bslSweepNow = false
bool sslSweepNow = false
bool majorNew    = false

if commit
    // 1) chart-timeframe confirmed swings -> pools (cluster into equal levels)
    if not na(ph)
        Pool npH = f_addLevel(ph, bar_index - swingLen, pivT, true, SRC_SWING, rvPivot, tolNow, thickNow)
        if ph >= rangeHi
            npH.structural := true            // dealing-range extreme
        hiType     := na(lastSH) ? 0 : ph > lastSH ? 1 : -1
        lastSH     := ph
        shBroken   := false
        lastSHPool := npH
        majorNew   := f_announce(npH) or majorNew
    if not na(pl)
        Pool npL = f_addLevel(pl, bar_index - swingLen, pivT, false, SRC_SWING, rvPivot, tolNow, thickNow)
        if pl <= rangeLo
            npL.structural := true
        loType     := na(lastSL) ? 0 : pl > lastSL ? 1 : -1
        lastSL     := pl
        slBroken   := false
        lastSLPool := npL
        majorNew   := f_announce(npL) or majorNew

    // 2) higher-timeframe swings (from the last completed HTF bar only)
    if htfValid and not na(htfPT)
        if not na(htfPH) and (na(lastHtfHiT) or htfPT != lastHtfHiT)
            lastHtfHiT := htfPT
            majorNew   := f_announce(f_addLevel(htfPH, bar_index, htfPT, true, SRC_HTF, 1.0, tolNow, thickNow)) or majorNew
        if not na(htfPL) and (na(lastHtfLoT) or htfPT != lastHtfLoT)
            lastHtfLoT := htfPT
            majorNew   := f_announce(f_addLevel(htfPL, bar_index, htfPT, false, SRC_HTF, 1.0, tolNow, thickNow)) or majorNew

    // 3) previous day / week / month highs & lows (completed periods only)
    if usePDL and pdAllowed and not na(pdHi) and not na(pdLo)
        majorNew := f_announce(f_addLevel(pdHi, pdHiB, pdHiT, true, SRC_PD, 1.0, tolNow, thickNow)) or majorNew
        majorNew := f_announce(f_addLevel(pdLo, pdLoB, pdLoT, false, SRC_PD, 1.0, tolNow, thickNow)) or majorNew
    if usePWL and pwAllowed and not na(pwHi) and not na(pwLo)
        majorNew := f_announce(f_addLevel(pwHi, pwHiB, pwHiT, true, SRC_PW, 1.0, tolNow, thickNow)) or majorNew
        majorNew := f_announce(f_addLevel(pwLo, pwLoB, pwLoT, false, SRC_PW, 1.0, tolNow, thickNow)) or majorNew
    if usePML and pmAllowed and not na(pmHi) and not na(pmLo)
        majorNew := f_announce(f_addLevel(pmHi, pmHiB, pmHiT, true, SRC_PM, 1.0, tolNow, thickNow)) or majorNew
        majorNew := f_announce(f_addLevel(pmLo, pmLoB, pmLoT, false, SRC_PM, 1.0, tolNow, thickNow)) or majorNew

    // 4) sweep / break / test engine on the confirmed candle
    //    sweep  = trade beyond the level (by the mode's penetration) AND close back inside
    //    taken  = close beyond the level -> liquidity consumed by acceptance, pool removed
    //    test   = approach inside the tolerance band that holds -> pool reinforced
    float penReq = sweepMode == "Aggressive" ? 0.0 : tolNow
    bool  rejDn  = (high - close) >= 0.5 * (high - low)
    bool  rejUp  = (close - low) >= 0.5 * (high - low)
    int   nAct   = array.size(pools)
    if nAct > 0
        for i = nAct - 1 to 0
            Pool p = array.get(pools, i)
            int outcome = 0                   // 0 = none, 1 = swept, 2 = taken
            if p.isBuy
                if close > p.price
                    outcome := 2
                else if enableSweeps and high > p.price + penReq and (sweepMode != "Strict" or rejDn)
                    outcome := 1
                else if high >= p.price - tolNow and bar_index - p.b > swingLen and (na(p.lastTest) or bar_index - p.lastTest >= swingLen)
                    p.tests    := p.tests + 1
                    p.lastTest := bar_index
                    p.fresh    := bar_index
            else
                if close < p.price
                    outcome := 2
                else if enableSweeps and low < p.price - penReq and (sweepMode != "Strict" or rejUp)
                    outcome := 1
                else if low <= p.price + tolNow and bar_index - p.b > swingLen and (na(p.lastTest) or bar_index - p.lastTest >= swingLen)
                    p.tests    := p.tests + 1
                    p.lastTest := bar_index
                    p.fresh    := bar_index
            if outcome == 1
                p.alive  := false
                p.sweptB := bar_index
                if p.isBuy
                    bslSweepNow := true
                else
                    sslSweepNow := true
                array.remove(pools, i)
                f_fadeSwept(p)
                if keepSwept or not removeSwept
                    array.push(sweptPools, p)
            else if outcome == 2
                p.alive := false
                array.remove(pools, i)
                f_deleteDrawings(p)
    while array.size(sweptPools) > maxSweeps
        f_deleteDrawings(array.shift(sweptPools))

    // 5) market structure: close through the last confirmed swing = BOS / CHoCH.
    //    The opposite swing that launched the break becomes a protected (structural) pool.
    if not shBroken and not na(lastSH) and close > lastSH
        shBroken       := true
        structDir      := 1
        lastBullShiftB := bar_index
        if not na(lastSLPool)
            if lastSLPool.alive
                lastSLPool.structural := true
                majorNew := f_announce(lastSLPool) or majorNew
    if not slBroken and not na(lastSL) and close < lastSL
        slBroken       := true
        structDir      := -1
        lastBearShiftB := bar_index
        if not na(lastSHPool)
            if lastSHPool.alive
                lastSHPool.structural := true
                majorNew := f_announce(lastSHPool) or majorNew

    // 6) bound the active store
    f_enforceCap(maxPools)

// ════════════════════════════════════════════════════════════════════════════
//  SCORING (every tick) - PRIMARY: active pool map / SECONDARY: bounded tilts
// ════════════════════════════════════════════════════════════════════════════
bool  frozen   = freezeLive and barstate.isrealtime and not barstate.isconfirmed
float refPrice = frozen ? nz(close[1], close) : close
float refATR   = frozen ? nz(atrSafe[1], atrSafe) : atrSafe

// ─── Market Pressure (separate model, SECONDARY only): -1 bearish .. +1 bullish
float barRng   = high - low
float clv      = barRng > 0 ? (2.0 * close - high - low) / barRng : 0.0
float bodyN    = f_clamp((close - open) / atrSafe, -1.0, 1.0)
float rocN     = f_clamp((close - nz(close[pressLen], close)) / (atrSafe * math.sqrt(pressLen)), -1.0, 1.0)
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)
float diSum    = nz(diPlus) + nz(diMinus)
float dmiN     = diSum > 0 ? (nz(diPlus) - nz(diMinus)) / diSum : 0.0
float vSum     = nz(math.sum(vol, pressLen))
float svSum    = nz(math.sum(vol * clv, pressLen))
float volImb   = volOK and vSum > 0 ? f_clamp(svSum / vSum, -1.0, 1.0) : 0.0
float pressRaw = volOK ? (clv + bodyN + rocN + dmiN + volImb) / 5.0 : (clv + bodyN + rocN + dmiN) / 4.0
float pressure = f_clamp(nz(ta.ema(pressRaw, pressLen), pressRaw), -1.0, 1.0)
float pressRef = frozen ? nz(pressure[1], pressure) : pressure

// ─── Bounded directional relevance (never more than 1.25x per factor)
bool  useStructTilt = flowMode == "Liquidity + Structure" or flowMode == "Balanced"
bool  usePressTilt  = flowMode == "Liquidity + Pressure" or flowMode == "Balanced"
float kMode         = flowMode == "Balanced" ? 0.5 : 1.0
float pdPos         = rangeHi > rangeLo ? f_clamp((refPrice - rangeLo) / (rangeHi - rangeLo), 0.0, 1.0) : 0.5
float bslMult       = 1.0
float sslMult       = 1.0
if useStructTilt and structDir != 0
    float st = 0.25 * f_clamp(structWeight, 0.0, 1.0) * kMode
    if structDir == 1
        bslMult *= 1.0 + st              // bullish structure: overhead buy-side is the more relevant draw
    else
        sslMult *= 1.0 + st              // bearish structure: downside sell-side is the more relevant draw
if usePressTilt
    float pt = 0.25 * f_clamp(pressWeight, 0.0, 1.0) * kMode * math.abs(pressRef)
    if pressRef > 0
        bslMult *= 1.0 + pt
    else
        sslMult *= 1.0 + pt
if usePD and flowMode != "Liquidity Only"
    float pdt = 0.25 * pdWeight * math.abs(pdPos - 0.5) * 2.0
    if pdPos > 0.5
        sslMult *= 1.0 + pdt             // premium: sell-side below slightly more relevant
    else
        bslMult *= 1.0 + pdt             // discount: buy-side above slightly more relevant

// ─── Aggregate every active pool (weighted aggregate, not a count of levels)
float buyRaw       = 0.0                 // pure liquidity weight above price
float sellRaw      = 0.0                 // pure liquidity weight below price
float buyAdj       = 0.0                 // after bounded directional relevance
float sellAdj      = 0.0
int   buyCnt       = 0
int   sellCnt      = 0
float buyHtfW      = 0.0
float sellHtfW     = 0.0
float fEq          = 0.0                 // factor attribution (debug / confidence)
float fVol         = 0.0
float fStruct      = 0.0
float fHtf         = 0.0
float fTest        = 0.0
float fSess        = 0.0
float fDistSum     = 0.0
Pool  bestBuy      = na
Pool  bestSell     = na
float bestBuyW     = 0.0
float bestSellW    = 0.0
Pool  nearMajBuy   = na
Pool  nearMajSell  = na
float nearMajBuyD  = 1e100
float nearMajSellD = 1e100

for p in pools
    p.w    := 0.0
    p.dAtr := math.abs(p.price - refPrice) / refATR
    bool above = p.isBuy and p.price > refPrice
    bool below = not p.isBuy and p.price < refPrice
    if (above or below) and p.dAtr <= maxDistATR
        [base, cluster, testB, volB, structB, htfB] = f_components(p)
        float s = base * cluster + testB + volB + structB + htfB
        if s >= minPoolStr
            float dw = f_distW(p.dAtr)
            float w0 = s * f_timeFactor(bar_index - p.fresh) * dw
            float w  = w0 * (p.isBuy ? bslMult : sslMult)
            p.w      := w
            // s = 1 + (cluster-1) + (base-1)*cluster + tests + vol + struct + htf
            fEq      += w0 * (cluster - 1.0) / s
            fSess    += w0 * (base - 1.0) * cluster / s
            fTest    += w0 * testB / s
            fVol     += w0 * volB / s
            fStruct  += w0 * structB / s
            fHtf     += w0 * htfB / s
            fDistSum += dw
            if p.isBuy
                buyRaw += w0
                buyAdj += w
                buyCnt += 1
                if p.htf
                    buyHtfW += w0
                if w > bestBuyW
                    bestBuyW := w
                    bestBuy  := p
                if f_tier(s) >= 2 and p.dAtr < nearMajBuyD
                    nearMajBuyD := p.dAtr
                    nearMajBuy  := p
            else
                sellRaw += w0
                sellAdj += w
                sellCnt += 1
                if p.htf
                    sellHtfW += w0
                if w > bestSellW
                    bestSellW := w
                    bestSell  := p
                if f_tier(s) >= 2 and p.dAtr < nearMajSellD
                    nearMajSellD := p.dAtr
                    nearMajSell  := p

// Swept pools only count when the user keeps them in the score (at 50%).
if not removeSwept
    for p in sweptPools
        float d = math.abs(p.price - refPrice) / refATR
        bool  above = p.isBuy and p.price > refPrice
        bool  below = not p.isBuy and p.price < refPrice
        if (above or below) and d <= maxDistATR
            float s = f_intrinsic(p)
            if s >= minPoolStr
                float w0 = 0.5 * s * f_timeFactor(bar_index - p.fresh) * f_distW(d)
                if p.isBuy
                    buyRaw += w0
                    buyAdj += w0 * bslMult
                else
                    sellRaw += w0
                    sellAdj += w0 * sslMult

// Current-session extremes (optional, transient levels)
bool  csOK = useCSL and pdAllowed
float csW  = 1.0 + 0.25 * sessWeight
if csOK and not na(csHiPrev) and csHiPrev > refPrice
    float d = (csHiPrev - refPrice) / refATR
    if d <= maxDistATR
        float w0 = csW * f_distW(d)
        buyRaw += w0
        buyAdj += w0 * bslMult
if csOK and not na(csLoPrev) and csLoPrev < refPrice
    float d = (refPrice - csLoPrev) / refATR
    if d <= maxDistATR
        float w0 = csW * f_distW(d)
        sellRaw += w0
        sellAdj += w0 * sslMult

// ─── Normalise: smoothing + stability prior -> BUY% + SELL% = 100 exactly
float buySm      = nz(ta.ema(buyAdj, smoothLen), buyAdj)
float sellSm     = nz(ta.ema(sellAdj, smoothLen), sellAdj)
float totalSm    = buySm + sellSm
float denom      = totalSm + 2.0 * stability
float buyPctRaw  = denom > 0 ? (buySm + stability) / denom * 100.0 : 50.0
float sellPctRaw = 100.0 - buyPctRaw
bool  warm       = bar_index >= swingLen * 4 + atrLen
bool  lowData    = not warm or buyCnt + sellCnt == 0 or totalSm < 0.6

float effBuy     = frozen ? nz(buyPctRaw[1], buyPctRaw) : buyPctRaw     // value shown / used for state
float dispBuy    = showDecimals ? math.round(effBuy, 1) : float(math.round(effBuy))
float dispSell   = 100.0 - dispBuy
float diffPct    = 2.0 * effBuy - 100.0                                  // BUY% - SELL%
float flowStrength = math.abs(diffPct)                                   // imbalance, NOT certainty
int   domNow     = lowData ? 0 : diffPct > 0 and diffPct >= balanceThr ? 1 : diffPct < 0 and -diffPct >= balanceThr ? -1 : 0
bool  extremeNow = not lowData and math.max(dispBuy, dispSell) >= extremeLvl

// Dominant liquidity side vs. key pool: the side % is an aggregate of many pools;
// the key pool is only the single strongest contributor on that side.
Pool keyPool = na
Pool nearMaj = na
if domNow == 1
    keyPool := bestBuy
    nearMaj := nearMajBuy
else if domNow == -1
    keyPool := bestSell
    nearMaj := nearMajSell
else
    if bestBuyW >= bestSellW
        keyPool := bestBuy
    else
        keyPool := bestSell
    if nearMajBuyD <= nearMajSellD
        nearMaj := nearMajBuy
    else
        nearMaj := nearMajSell

// ─── Model confidence (quality of the reading - NOT a probability of direction)
int   nScored    = buyCnt + sellCnt
float rawTot     = buyRaw + sellRaw
float htfTot     = buyHtfW + sellHtfW
float sepN       = math.min(flowStrength / 60.0, 1.0)
float countN     = math.min(nScored / 6.0, 1.0)
float clustN     = rawTot > 0 ? math.min(fEq / rawTot * 3.0, 1.0) : 0.0
float structN    = structDir == 0 or domNow == 0 ? 0.5 : structDir == domNow ? 1.0 : 0.0
float tfN        = not htfValid ? 0.5 : htfTot <= 0 ? 0.4 : domNow == 1 ? buyHtfW / htfTot : domNow == -1 ? sellHtfW / htfTot : 0.5
float dataN      = (volOK ? 1.0 : 0.8) * (lowData ? 0.5 : 1.0)
float confidence = 100.0 * dataN * (0.35 * sepN + 0.15 * countN + 0.15 * clustN + 0.20 * structN + 0.15 * tfN)

// ════════════════════════════════════════════════════════════════════════════
//  FLOW EVENTS & OPTIONAL SIGNALS (confirmed bars only)
// ════════════════════════════════════════════════════════════════════════════
var int domState          = 0
var int lastDirSide       = 0
var int lastShiftB        = na
var int lastTargetId      = na
var int lastSSLSweepB     = na
var int lastBSLSweepB     = na
var int lastBuyCrossB     = na
var int lastSellCrossB    = na
var int lastBuySigAnchor  = na
var int lastSellSigAnchor = na

bool becameBuyDom  = false
bool becameSellDom = false
bool flipToBuy     = false
bool flipToSell    = false
bool shiftUp       = false
bool shiftDn       = false
bool tgtChangeBuy  = false
bool tgtChangeSell = false
bool sigBuy        = false
bool sigSell       = false

float pctChange = buyPctRaw - nz(buyPctRaw[shiftLook], buyPctRaw)
bool  buyCross  = ta.crossover(buyPctRaw, sigThr)
bool  sellCross = ta.crossover(sellPctRaw, sigThr)

if commit
    // dominance & flips (BALANCED never counts as a side, so a flip is SELL -> BUY or BUY -> SELL)
    if domNow != domState
        becameBuyDom  := domNow == 1
        becameSellDom := domNow == -1
        domState      := domNow
    if domNow != 0 and domNow != lastDirSide
        flipToBuy   := lastDirSide == -1
        flipToSell  := lastDirSide == 1
        lastDirSide := domNow

    // meaningful shift: >= threshold change within the lookback, with a cooldown
    if not lowData and math.abs(pctChange) >= shiftThr and (na(lastShiftB) or bar_index - lastShiftB > shiftLook)
        shiftUp    := pctChange > 0
        shiftDn    := pctChange < 0
        lastShiftB := bar_index

    // strong target change: a new key pool on a dominant side
    int tgtId = na
    if domNow != 0 and not na(keyPool)
        tgtId := keyPool.id
    if not na(tgtId) and (na(lastTargetId) or tgtId != lastTargetId)
        if flowStrength >= 40.0 or f_tier(f_intrinsic(keyPool)) >= 2
            tgtChangeBuy  := domNow == 1
            tgtChangeSell := domNow == -1
        lastTargetId := tgtId

    if sslSweepNow
        lastSSLSweepB := bar_index
    if bslSweepNow
        lastBSLSweepB := bar_index
    if buyCross
        lastBuyCrossB := bar_index
    if sellCross
        lastSellCrossB := bar_index

    if enableSig and not lowData
        // BUY: sell-side swept -> bullish structure shift after it -> flow toward buy-side -> buy-side target exists
        int  bAnchor   = reqSweep ? lastSSLSweepB : reqStruct ? lastBullShiftB : lastBuyCrossB
        bool bSweepOk  = not reqSweep or (not na(lastSSLSweepB) and bar_index - lastSSLSweepB <= sigWindow)
        bool bStructOk = not reqStruct or (not na(lastBullShiftB) and bar_index - lastBullShiftB <= sigWindow and (not reqSweep or lastBullShiftB >= lastSSLSweepB))
        bool bCrossOk  = reqSweep or reqStruct or (not na(lastBuyCrossB) and bar_index - lastBuyCrossB <= sigWindow)
        if bSweepOk and bStructOk and bCrossOk and buyPctRaw >= sigThr and buyCnt > 0 and not na(bAnchor) and (na(lastBuySigAnchor) or bAnchor != lastBuySigAnchor)
            sigBuy           := true
            lastBuySigAnchor := bAnchor
        // SELL: buy-side swept -> bearish structure shift after it -> flow toward sell-side -> sell-side target exists
        int  sAnchor   = reqSweep ? lastBSLSweepB : reqStruct ? lastBearShiftB : lastSellCrossB
        bool sSweepOk  = not reqSweep or (not na(lastBSLSweepB) and bar_index - lastBSLSweepB <= sigWindow)
        bool sStructOk = not reqStruct or (not na(lastBearShiftB) and bar_index - lastBearShiftB <= sigWindow and (not reqSweep or lastBearShiftB >= lastBSLSweepB))
        bool sCrossOk  = reqSweep or reqStruct or (not na(lastSellCrossB) and bar_index - lastSellCrossB <= sigWindow)
        if sSweepOk and sStructOk and sCrossOk and sellPctRaw >= sigThr and sellCnt > 0 and not na(sAnchor) and (na(lastSellSigAnchor) or sAnchor != lastSellSigAnchor)
            sigSell           := true
            lastSellSigAnchor := sAnchor

// ════════════════════════════════════════════════════════════════════════════
//  CHART VISUALS (styled on the last bar only - objects are created per pool)
// ════════════════════════════════════════════════════════════════════════════
// rk: 0 = not ranked, 1 = key target, 2..N = next strongest pools
f_style(Pool p, int rk, int dom, float sideTot) =>
    float s       = f_intrinsic(p)
    int   tier    = f_tier(s)
    bool  vis     = s >= minPoolStr
    bool  inScope = p.w > 0
    bool  isT1    = rk == 1 and showTgtChart
    bool  ranked  = rk > 0 and showTgtChart
    color c       = p.isBuy ? bslCol : sslCol
    int   bgT     = not vis ? 100 : isT1 ? 76 : not inScope ? 96 : tier == 3 ? 80 : tier == 2 ? 84 : tier == 1 ? 88 : 92
    int   lnT     = not vis ? 100 : isT1 ? 0 : not inScope ? 85 : tier >= 2 ? 25 : tier == 1 ? 45 : 65
    if not na(p.bx)
        box.set_bgcolor(p.bx, color.new(c, bgT))
        box.set_border_color(p.bx, color.new(c, not vis ? 100 : isT1 ? 50 : 82))
    if not na(p.ln)
        line.set_color(p.ln, color.new(c, lnT))
        line.set_width(p.ln, isT1 ? 2 : 1)
        line.set_style(p.ln, isT1 ? line.style_solid : tier >= 2 ? line.style_dashed : line.style_dotted)
    bool isSess  = p.src >= SRC_PD
    bool wantLbl = vis and (ranked or (isSess and showSessTags) or (p.members >= 2 and showEqTags) or showTierLbl)
    if wantLbl
        string tag = f_tag(p)
        string arw = p.isBuy ? "▲" : "▼"
        string txt = ""
        if isT1
            txt := (dom != 0 ? "TARGET " : "KEY POOL ") + arw + "  " + str.tostring(p.price, format.mintick) + "  ·  " +
                 str.tostring(p.dAtr, "#0.00") + " ATR\n" + tag + " · " + f_tierName(tier)
        else
            txt := (ranked ? "T" + str.tostring(rk) + "  " : "") + tag + (showTierLbl ? " · " + f_tierName(tier) : "")
        string shareTxt = sideTot > 0 ? str.tostring(p.w / sideTot * 100.0, "#0") : "0"
        string tip = "Intrinsic strength " + str.tostring(s, "#0.00") + " (" + f_tierName(tier) + ")\nClustered swings: " +
             str.tostring(p.members) + "  ·  Tests: " + str.tostring(p.tests) + "\nShare of its side's liquidity score: " + shareTxt + "%"
        color  bg = isT1 ? color.new(c, 20) : color.new(c, 100)
        color  tc = isT1 ? color.white : color.new(c, ranked ? 0 : 25)
        string ls = isT1 ? size.small : size.tiny
        if na(p.lb)
            p.lb := label.new(time, p.price, txt, xloc = xloc.bar_time, style = label.style_label_left, color = bg,
                 textcolor = tc, size = ls, textalign = text.align_left, tooltip = tip)
        else
            label.set_xy(p.lb, time, p.price)
            label.set_text(p.lb, txt)
            label.set_color(p.lb, bg)
            label.set_textcolor(p.lb, tc)
            label.set_size(p.lb, ls)
            label.set_tooltip(p.lb, tip)
    else if not na(p.lb)
        label.delete(p.lb)
        p.lb := na

var line  csHiLn = na
var line  csLoLn = na
var label csHiLb = na
var label csLoLb = na

if barstate.islast
    // rank the scored pools: T1 = key pool on the dominant side, then strongest remaining
    int nP = array.size(pools)
    if nP > 0
        array<float> ws = array.new<float>()
        for p in pools
            array.push(ws, p.w)
        array<int> rankIdx  = array.sort_indices(ws, order.descending)
        array<int> ranks    = array.new<int>(nP, 0)
        int        nextRank = na(keyPool) ? 1 : 2
        for k = 0 to nP - 1
            int  idx = array.get(rankIdx, k)
            Pool q   = array.get(pools, idx)
            if q.w > 0
                if not na(keyPool) and q.id == keyPool.id
                    array.set(ranks, idx, 1)
                else if nextRank <= topN
                    array.set(ranks, idx, nextRank)
                    nextRank += 1
        for i = 0 to nP - 1
            Pool q = array.get(pools, i)
            f_style(q, array.get(ranks, i), domNow, q.isBuy ? buyAdj : sellAdj)

    // current-session high / low (optional)
    bool drawCsHi = csOK and not na(csHiPrev) and not na(csHiTPrev)
    bool drawCsLo = csOK and not na(csLoPrev) and not na(csLoTPrev)
    if drawCsHi
        if na(csHiLn)
            csHiLn := line.new(csHiTPrev, csHiPrev, time, csHiPrev, xloc = xloc.bar_time, extend = extend.right, color = color.new(neuCol, 40), style = line.style_dotted)
            csHiLb := label.new(time, csHiPrev, "CSH", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(neuCol, 100), textcolor = color.new(neuCol, 20), size = size.tiny)
        else
            line.set_xy1(csHiLn, csHiTPrev, csHiPrev)
            line.set_xy2(csHiLn, time, csHiPrev)
            label.set_xy(csHiLb, time, csHiPrev)
    else if not na(csHiLn)
        line.delete(csHiLn)
        label.delete(csHiLb)
        csHiLn := na
        csHiLb := na
    if drawCsLo
        if na(csLoLn)
            csLoLn := line.new(csLoTPrev, csLoPrev, time, csLoPrev, xloc = xloc.bar_time, extend = extend.right, color = color.new(neuCol, 40), style = line.style_dotted)
            csLoLb := label.new(time, csLoPrev, "CSL", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(neuCol, 100), textcolor = color.new(neuCol, 20), size = size.tiny)
        else
            line.set_xy1(csLoLn, csLoTPrev, csLoPrev)
            line.set_xy2(csLoLn, time, csLoPrev)
            label.set_xy(csLoLb, time, csLoPrev)
    else if not na(csLoLn)
        line.delete(csLoLn)
        label.delete(csLoLb)
        csLoLn := na
        csLoLb := na

// ════════════════════════════════════════════════════════════════════════════
//  DASHBOARD
// ════════════════════════════════════════════════════════════════════════════
// Row layout depends only on inputs, so it is fixed for the whole run.
int DBG_ROWS  = 12
int rowHead   = 0
int rowTop    = showPct ? 1 : -1
int rowBar    = showBar ? (showPct ? 2 : 1) : -1
int rowBot    = showPct ? (showBar ? 3 : 2) : -1
int c0        = 1 + (showPct ? 2 : 0) + (showBar ? 1 : 0)
int rowTgt    = showTgtRow ? c0 : -1
int c1        = c0 + (showTgtRow ? 1 : 0)
int rowStr    = showStrRow ? c1 : -1
int c2        = c1 + (showStrRow ? 1 : 0)
int rowConf   = showConfRow ? c2 : -1
int c3        = c2 + (showConfRow ? 1 : 0)
int rowKey    = showKeyRow ? c3 : -1
int c4        = c3 + (showKeyRow ? 1 : 0)
int rowNear   = showNearRow ? c4 : -1
int c5        = c4 + (showNearRow ? 1 : 0)
int rowStruct = showStructRow ? c5 : -1
int c6        = c5 + (showStructRow ? 1 : 0)
int rowStatus = showStatusRow ? c6 : -1
int c7        = c6 + (showStatusRow ? 1 : 0)
int rowDbg    = debugMode ? c7 : -1
int totalRows = c7 + (debugMode ? DBG_ROWS : 0)

var table dash = showDash ? table.new(f_pos(dashPos), 2, totalRows, bgcolor = dashBg, frame_color = color.new(neuCol, 70),
     frame_width = 1, border_color = color.new(neuCol, 92), border_width = 0) : na

if barstate.isfirst and not na(dash)
    table.merge_cells(dash, 0, rowHead, 1, rowHead)
    if rowBar >= 0
        table.merge_cells(dash, 0, rowBar, 1, rowBar)
    if rowStatus >= 0
        table.merge_cells(dash, 0, rowStatus, 1, rowStatus)

f_cell(table t, int c, int r, string s, color tc, string ha, string sz, string tip) =>
    table.cell(t, c, r, s, text_color = tc, text_halign = ha, text_size = sz, tooltip = tip)

float confDisp = frozen ? nz(confidence[1], confidence) : confidence

if barstate.islast and not na(dash)
    string sz     = f_size(dashSize)
    bool   buyTop = dispBuy >= dispSell
    color  topCol = buyTop ? bslCol : sslCol
    color  botCol = buyTop ? sslCol : bslCol
    string fmt    = showDecimals ? "#0.0" : "#0"
    string sideB  = wording == "Side" ? "BUY-SIDE" : "ABOVE"
    string sideS  = wording == "Side" ? "SELL-SIDE" : "BELOW"
    color  dimTxt = color.new(dashTxt, 35)

    f_cell(dash, 0, rowHead, "EST. LIQUIDITY FLOW", dashTxt, text.align_center, sz,
         "Share of the currently scored ACTIVE liquidity resting above price (buy-side) vs below price (sell-side). An estimate of liquidity concentration - not a probability of price direction.")
    if rowTop >= 0
        f_cell(dash, 0, rowTop, buyTop ? "BUY-SIDE" : "SELL-SIDE", topCol, text.align_left, sz, "")
        f_cell(dash, 1, rowTop, str.tostring(buyTop ? dispBuy : dispSell, fmt) + "%", topCol, text.align_right, sz, "")
        f_cell(dash, 0, rowBot, buyTop ? "SELL-SIDE" : "BUY-SIDE", botCol, text.align_left, sz, "")
        f_cell(dash, 1, rowBot, str.tostring(buyTop ? dispSell : dispBuy, fmt) + "%", botCol, text.align_right, sz, "")
    if rowBar >= 0
        int    cells  = dashSize == "Tiny" ? 14 : dashSize == "Small" ? 18 : dashSize == "Normal" ? 20 : 22
        int    filled = math.max(0, math.min(cells, math.round(math.max(dispBuy, dispSell) / 100.0 * cells)))
        string barTxt = str.repeat("█", filled) + str.repeat("░", cells - filled)
        table.cell(dash, 0, rowBar, barTxt, text_color = topCol, text_halign = text.align_center, text_size = sz,
             text_font_family = font.family_monospace)
    if rowTgt >= 0
        string tTxt = lowData ? "LOW DATA" : domNow == 1 ? sideB + " ▲" : domNow == -1 ? sideS + " ▼" : "BALANCED"
        color  tCol = domNow == 1 ? bslCol : domNow == -1 ? sslCol : neuCol
        f_cell(dash, 0, rowTgt, "TARGET", dimTxt, text.align_left, sz, "")
        f_cell(dash, 1, rowTgt, tTxt, tCol, text.align_right, sz,
             "Dominant estimated liquidity side. BALANCED when the sides differ by less than the Balanced Threshold.")
    if rowStr >= 0
        string sTxt = lowData ? "—" : extremeNow ? "EXTREME" : f_strengthName(flowStrength)
        color  sCol = lowData or domNow == 0 ? neuCol : domNow == 1 ? bslCol : sslCol
        f_cell(dash, 0, rowStr, "STRENGTH", dimTxt, text.align_left, sz, "")
        f_cell(dash, 1, rowStr, sTxt, sCol, text.align_right, sz,
             "Liquidity Flow Strength = size of the imbalance between the two sides (0-100). Not certainty.")
    if rowConf >= 0
        f_cell(dash, 0, rowConf, "MODEL CONF.", dimTxt, text.align_left, sz, "")
        f_cell(dash, 1, rowConf, str.tostring(confDisp, "#0") + "%", dashTxt, text.align_right, sz,
             "Model confidence: score separation, pool count, clustering, structure and HTF agreement, data quality. Not a probability of price direction.")
    if rowKey >= 0
        string kTxt = "—"
        color  kCol = neuCol
        string kTip = "No active pool scored."
        if not na(keyPool)
            float sideTot = keyPool.isBuy ? buyAdj : sellAdj
            kTxt := str.tostring(keyPool.price, format.mintick) + " · " + str.tostring(keyPool.dAtr, "#0.00") + " ATR"
            kCol := keyPool.isBuy ? bslCol : sslCol
            kTip := f_tag(keyPool) + " · " + f_tierName(f_tier(f_intrinsic(keyPool))) + "\nStrongest single pool on " +
                 (domNow == 0 ? "either side" : "the dominant side") + ": " + (sideTot > 0 ? str.tostring(keyPool.w / sideTot * 100.0, "#0") : "0") +
                 "% of that side's score. The side % aggregates every active pool."
        f_cell(dash, 0, rowKey, "KEY POOL", dimTxt, text.align_left, sz, "")
        f_cell(dash, 1, rowKey, kTxt, kCol, text.align_right, sz, kTip)
    if rowNear >= 0
        string nTxt = "—"
        color  nCol = neuCol
        string nTip = "No MAJOR or EXTREME pool is currently scored."
        if not na(nearMaj)
            nTxt := str.tostring(nearMaj.price, format.mintick) + " · " + str.tostring(nearMaj.dAtr, "#0.00") + " ATR"
            nCol := nearMaj.isBuy ? bslCol : sslCol
            nTip := f_tag(nearMaj) + " · " + f_tierName(f_tier(f_intrinsic(nearMaj)))
        f_cell(dash, 0, rowNear, "NEAREST MAJOR", dimTxt, text.align_left, sz, "")
        f_cell(dash, 1, rowNear, nTxt, nCol, text.align_right, sz, nTip)
    if rowStruct >= 0
        string hT    = hiType == 1 ? "HH" : hiType == -1 ? "LH" : "-"
        string lT    = loType == 1 ? "HL" : loType == -1 ? "LL" : "-"
        string mTxt  = (structDir == 1 ? "BULLISH" : structDir == -1 ? "BEARISH" : "UNDEFINED") + " · " + hT + "/" + lT
        color  mCol  = structDir == 1 ? bslCol : structDir == -1 ? sslCol : neuCol
        f_cell(dash, 0, rowStruct, "STRUCTURE", dimTxt, text.align_left, sz, "")
        f_cell(dash, 1, rowStruct, mTxt, mCol, text.align_right, sz, "Direction of the last break of structure, plus the last swing high / swing low types.")
    if rowStatus >= 0
        string stTxt = lowData ? "BALANCED / LOW DATA" : extremeNow ? (dispBuy > dispSell ? "EXTREME BUY-SIDE LIQUIDITY" : "EXTREME SELL-SIDE LIQUIDITY") :
             domNow == 0 ? "BALANCED" : "% = est. share of active liquidity"
        color  stCol = lowData or domNow == 0 ? neuCol : extremeNow ? (dispBuy > dispSell ? bslCol : sslCol) : color.new(dashTxt, 55)
        string stSz  = lowData or extremeNow or domNow == 0 ? sz : size.tiny
        f_cell(dash, 0, rowStatus, stTxt, stCol, text.align_center, stSz, "")
    if debugMode
        int    r0 = rowDbg
        color  dc = color.new(dashTxt, 25)
        string ds = size.tiny
        f_cell(dash, 0, r0, "RAW BUY / SELL", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0, str.tostring(buyRaw, "#0.00") + " / " + str.tostring(sellRaw, "#0.00"), dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 1, "ADJ. BUY / SELL", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 1, str.tostring(buyAdj, "#0.00") + " / " + str.tostring(sellAdj, "#0.00"), dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 2, "ACTIVE POOLS", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 2, "B " + str.tostring(buyCnt) + " · S " + str.tostring(sellCnt) + " · stored " + str.tostring(array.size(pools)) +
             " · swept " + str.tostring(array.size(sweptPools)), dc, text.align_right, ds, "")
        string dpTxt = "—"
        if not na(keyPool)
            dpTxt := f_tag(keyPool) + " · s " + str.tostring(f_intrinsic(keyPool), "#0.00") + " · w " + str.tostring(keyPool.w, "#0.00")
        f_cell(dash, 0, r0 + 3, "DOMINANT POOL", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 3, dpTxt, dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 4, "VOLUME FACTOR", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 4, volOK ? f_share(fVol, rawTot) + " of score" : "n/a (no usable volume)", dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 5, "DISTANCE FACTOR", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 5, "avg " + str.tostring(nScored > 0 ? fDistSum / nScored : 0.0, "#0.00"), dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 6, "EQUAL-LEVEL FACTOR", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 6, f_share(fEq, rawTot) + " of score", dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 7, "STRUCTURE FACTOR", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 7, f_share(fStruct, rawTot) + " · dir " + str.tostring(structDir), dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 8, "HTF FACTOR", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 8, htfValid ? f_share(fHtf, rawTot) + " · TF " + htfTF : "off", dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 9, "TESTS / SESSION", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 9, f_share(fTest, rawTot) + " / " + f_share(fSess, rawTot), dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 10, "PRESSURE", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 10, str.tostring(pressRef, "#0.00") + (usePressTilt ? "" : " (not used)"), dc, text.align_right, ds, "")
        f_cell(dash, 0, r0 + 11, "TILT BSL / SSL", dc, text.align_left, ds, "")
        f_cell(dash, 1, r0 + 11, "x" + str.tostring(bslMult, "#0.00") + " / x" + str.tostring(sslMult, "#0.00"), dc, text.align_right, ds, "")

// ════════════════════════════════════════════════════════════════════════════
//  MARKERS (all conditions are confirmed-bar only -> fixed once printed)
// ════════════════════════════════════════════════════════════════════════════
plotshape(showSweepMk and bslSweepNow, "Buy-Side Liquidity Sweep", shape.xcross, location.abovebar, color.new(bslCol, 10), size = size.tiny)
plotshape(showSweepMk and sslSweepNow, "Sell-Side Liquidity Sweep", shape.xcross, location.belowbar, color.new(sslCol, 10), size = size.tiny)
plotshape(showFlipMk and flipToBuy, "Liquidity Flip → Buy-Side", shape.diamond, location.belowbar, color.new(bslCol, 30), text = "FLIP", textcolor = color.new(bslCol, 20), size = size.tiny)
plotshape(showFlipMk and flipToSell, "Liquidity Flip → Sell-Side", shape.diamond, location.abovebar, color.new(sslCol, 30), text = "FLIP", textcolor = color.new(sslCol, 20), size = size.tiny)
plotshape(showShiftMk and shiftUp, "Liquidity Shift ↑", shape.circle, location.belowbar, color.new(bslCol, 50), text = "SHIFT", textcolor = color.new(bslCol, 40), size = size.tiny)
plotshape(showShiftMk and shiftDn, "Liquidity Shift ↓", shape.circle, location.abovebar, color.new(sslCol, 50), text = "SHIFT", textcolor = color.new(sslCol, 40), size = size.tiny)
plotshape(sigBuy, "Confirmed BUY Setup", shape.triangleup, location.belowbar, bslCol, text = "BUY", textcolor = bslCol, size = size.small)
plotshape(sigSell, "Confirmed SELL Setup", shape.triangledown, location.abovebar, sslCol, text = "SELL", textcolor = sslCol, size = size.small)

// Debug values in the Data Window only (no chart clutter)
plot(debugMode ? buyRaw : na, "Raw Buy-Side Score", color = bslCol, display = display.data_window)
plot(debugMode ? sellRaw : na, "Raw Sell-Side Score", color = sslCol, display = display.data_window)
plot(debugMode ? buyPctRaw : na, "Buy-Side % (smoothed)", color = neuCol, display = display.data_window)
plot(debugMode ? pressure : na, "Market Pressure", color = neuCol, display = display.data_window)
plot(debugMode ? confidence : na, "Model Confidence", color = neuCol, display = display.data_window)

// ════════════════════════════════════════════════════════════════════════════
//  ALERTS (event-based, confirmed bars only - never every candle)
// ════════════════════════════════════════════════════════════════════════════
alertcondition(alFlow and becameBuyDom, "Buy-side liquidity dominant", "Estimated buy-side liquidity became dominant on {{ticker}} {{interval}}")
alertcondition(alFlow and becameSellDom, "Sell-side liquidity dominant", "Estimated sell-side liquidity became dominant on {{ticker}} {{interval}}")
alertcondition(alFlow and (flipToBuy or flipToSell), "Liquidity flow flip", "Liquidity Flow flipped sides on {{ticker}} {{interval}}")
alertcondition(alFlow and shiftUp, "Liquidity flow shifted bullish", "Liquidity Flow shifted bullish (toward buy-side) on {{ticker}} {{interval}}")
alertcondition(alFlow and shiftDn, "Liquidity flow shifted bearish", "Liquidity Flow shifted bearish (toward sell-side) on {{ticker}} {{interval}}")
alertcondition(alSweep and bslSweepNow, "Buy-side sweep", "Buy-side liquidity swept on {{ticker}} {{interval}}")
alertcondition(alSweep and sslSweepNow, "Sell-side sweep", "Sell-side liquidity swept on {{ticker}} {{interval}}")
alertcondition(alPool and majorNew, "Major liquidity pool detected", "Major liquidity pool detected on {{ticker}} {{interval}}")
alertcondition(alPool and tgtChangeBuy, "New buy-side target", "New dominant buy-side liquidity target detected on {{ticker}} {{interval}}")
alertcondition(alPool and tgtChangeSell, "New sell-side target", "New dominant sell-side liquidity target detected on {{ticker}} {{interval}}")
alertcondition(alSig and sigBuy, "Confirmed BUY setup", "Confirmed BUY setup (sell-side sweep + bullish shift) on {{ticker}} {{interval}}")
alertcondition(alSig and sigSell, "Confirmed SELL setup", "Confirmed SELL setup (buy-side sweep + bearish shift) on {{ticker}} {{interval}}")
